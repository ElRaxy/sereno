# `_fase()` devuelve una frase traducida, que es lo correcto para una persona y lo peor
# posible para un script: cambia con el idioma y con cualquier retoque de estilo. El
# JSON lleva este enum, que es lo unico que se promete estable.
def estado_estable(r):
    pu = r.get("pulso") or {}
    if pu.get("escribe") is None:
        return "unknown"
    if pu.get("herramienta"):
        return "in_command"
    if pu.get("escribe"):
        return "writing"
    return "waiting" if (r.get("idle") or 0) < 6 * INACTIVA else "stopped"


def filas_json(rows):
    """Los mismos hechos que pinta la lista, sin una linea de conversacion dentro.

    Deliberadamente NO salen el ultimo prompt ni la ultima respuesta, que si estan en el
    panel. Un `--json` se canaliza a barras de estado, a scripts de otros y a lo que a
    nadie se le ocurre: la promesa de que aqui no sale nada de la maquina solo se
    sostiene si lo que este comando imprime no lleva conversacion. Lo vigila
    `tests/test_json_sin_conversacion.py`, que ademas fija los tipos.
    """
    fuera = []
    for r in rows:
        pu = r.get("pulso") or {}
        ctx = pu.get("ctx")
        fuera.append({
            "id": r.get("name") or "",
            "title": r.get("title_full") or r.get("title") or "",
            "project": r.get("proyecto") or "",
            "branch": r.get("rama") or "",
            "source": r.get("fuente", "claude"),
            "state": estado_estable(r),
            # Los dos hechos crudos de los que sale `state`, para quien prefiera
            # componer el suyo en vez de fiarse del nuestro.
            "writing": pu.get("escribe"),
            "tool_pending": pu.get("herramienta"),
            "idle_seconds": None if r.get("idle") is None else round(r["idle"]),
            "attached": bool(r.get("attached")),
            "memory_mb": None if r.get("mem_mb") is None else round(r["mem_mb"]),
            "context_tokens": ctx,
            "context_max": tope_contexto(pu.get("modelo"), ctx) if ctx else None,
            "model": pu.get("modelo"),
            "pid": r.get("pid") or None,
        })
    return fuera


def print_json(rows):
    print(json.dumps({"sereno": VERSION, "sessions": filas_json(rows)},
                     indent=2, ensure_ascii=False))


# ───────────────────────────── --find: buscar en el historial ─────────────────────────
# La criba binaria por fichero NO basta, y medirlo fue la sorpresa: buscando "complianz"
# sobre 506 transcripts, 287 contenian la palabra en crudo y solo 25 la tenian en algo
# dicho. El resto son `tool_result` —volcados de ficheros, salidas de comandos— y el
# CLAUDE.md del proyecto, que el CLI inyecta en CADA sesion. Buscar en el fichero entero
# devuelve media maquina; buscar en lo que se dijo devuelve lo que buscabas.
_TROZO = 70          # caracteres a cada lado del acierto


def _fragmento(texto, aguja):
    i = texto.lower().find(aguja.lower())
    if i < 0:
        return ""
    a, b = max(0, i - _TROZO), min(len(texto), i + len(aguja) + _TROZO)
    return (("\u2026" if a else "") + " ".join(texto[a:b].split())
            + ("\u2026" if b < len(texto) else ""))


def _dichos(j):
    """Lo que se dijo en una linea del transcript: prompts y respuestas, nada mas.

    Fuera quedan los `tool_result` (no los dijo nadie, son salida de comandos) y los
    `<system-reminder>`, que son contexto que el CLI pega solo y aparece en todas las
    sesiones: dejarlos dentro hacia que cualquier palabra del CLAUDE.md casara siempre.
    """
    if j.get("isSidechain"):
        return []
    m = j.get("message") or {}
    c = m.get("content")
    quien = j.get("type")
    if quien not in ("user", "assistant"):
        return []
    if isinstance(c, str):
        textos = [c]
    elif isinstance(c, list):
        textos = [b.get("text") or "" for b in c
                  if isinstance(b, dict) and b.get("type") == "text"]
    else:
        return []
    return [(quien, t) for t in textos if t and "<system-reminder>" not in t]


def buscar(aguja, limite=200, todo=False):
    """[(fila, [(quien, fragmento)])] por sesion, de la mas reciente a la mas vieja."""
    if DEMO or not PROJECTS.is_dir():
        return []
    a = aguja.lower().encode("utf-8", "replace")
    cands = []
    for p in PROJECTS.glob("*/*.jsonl"):
        if not _UUID.match(p.stem):
            continue
        try:
            cands.append((p.stat().st_mtime, p))
        except OSError:
            pass
    cands.sort(reverse=True)
    if not todo:
        cands = cands[:limite]

    # Cuatro segundos de silencio con `--all` sobre 3,4 GB parecen un cuelgue. El aviso
    # va por stderr para no ensuciar la salida de quien la canalice, y solo cuando hay
    # bastante que leer: decirlo para tres ficheros es ruido.
    peso = sum(p.stat().st_size for _mt, p in cands if p.exists())
    if peso > 200 * 1024 * 1024:
        print(_("searching {n} transcripts ({g} GB)\u2026",
                n=len(cands), g=f"{peso / 1e9:.1f}"), file=sys.stderr)

    salida = []
    for mt, p in cands:
        try:
            crudo = p.read_bytes()
        except OSError:
            continue
        if a not in crudo.lower():
            continue          # criba barata: descarta el 80% sin parsear un solo JSON
        aciertos = []
        for linea in crudo.split(b"\n"):
            if a not in linea.lower():
                continue
            try:
                j = json.loads(linea)
            except Exception:
                continue
            for quien, texto in _dichos(j):
                frag = _fragmento(texto, aguja)
                if frag:
                    aciertos.append((quien, frag))
        if aciertos:
            salida.append((fila_de_transcript(p, mt), aciertos))
    return salida


def print_hallazgos(res, aguja, por_sesion=3):
