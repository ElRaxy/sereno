def _cwd_de_cabecera(path, tope=40):
    """El `cwd` de una sesion leyendo solo la CABECERA del transcript.

    `pulso()` tambien lo saca, pero leyendo la cola y calculando de paso titulo, estado y
    rastro: para 880 ficheros eso es un barrido caro para tirar todo menos un campo. Aqui
    hace falta el dato mas barato que conteste "¿este historial pertenece a algo que
    todavia existe?", y el `cwd` de una sesion no cambia, asi que la primera linea que lo
    traiga vale igual que la ultima. Medido: 880 ficheros en 114 ms.
    """
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for i, linea in enumerate(f):
                if i > tope:
                    break
                try:
                    j = json.loads(linea)
                except Exception:
                    continue
                cwd = j.get("cwd") or (j.get("meta") or {}).get("cwd")
                if cwd:
                    return cwd
    except OSError:
        pass
    return ""


def peso_historial(tope=20):
    """Cuanto ocupa en disco el historial, y donde esta ese peso. HECHOS, sin veredicto.

    Existe porque el dato no estaba en ningun sitio y resulto ser grande: en la maquina
    donde se escribio esto, **3.469 MB en 595 sesiones**, con 3.464 de ellos en un solo
    proyecto y **403 MB en cinco sesiones**. Nada de eso se veia: el panel dice el peso de
    la fila bajo el cursor y ya.

    Lo que NO hace, y es la mitad del asunto: no borra, no propone borrar y no llama
    "basura" a nada. `sereno` no escribe en nada que sea de una sesion, y un historial
    gordo no es un problema — es un hecho que quien mira decide que hacer con el. Por eso
    esto devuelve numeros y la funcion de al lado los imprime.

    Los transcripts de subagentes (`agent-*.jsonl`) se cuentan aparte: son 285 ficheros en
    esta maquina y pesan 0,4 MB, o sea que meterlos en el reparto por proyecto habria
    inflado el numero de ficheros sin mover un MB.
    """
    por_proyecto, mayores = {}, []
    cortes = {d: [0, 0] for d in _CORTES_EDAD}
    n = n_sub = n_tirar = 0
    bytes_tot = bytes_sub = bytes_sin_sitio = bytes_tirar = 0
    n_sin_sitio = 0
    for d in sorted(PROJECTS.iterdir()) if PROJECTS.is_dir() else ():
        if not d.is_dir():
            continue
        for jl in d.glob("*.jsonl"):
            try:
                tam = jl.stat().st_size
            except OSError:
                continue
            if not _UUID.match(jl.stem):
                n_sub += 1
                bytes_sub += tam
                continue
            # Las de usar y tirar se cuentan aparte, igual que los subagentes y por lo
            # mismo: su peso es real y hay que decirlo, pero meterlas en el reparto por
            # proyecto llena la tabla de nombres que no son proyectos de nadie
            # ("skillopt_sleep_claude_ylulwmwr").
            if de_usar_y_tirar(_proyecto_de_dir(d.name)):
                n_tirar += 1
                bytes_tirar += tam
                continue
            n += 1
            bytes_tot += tam
            cwd = _cwd_de_cabecera(jl)
            sin_sitio = bool(cwd) and not hay_sitio(cwd)
            if sin_sitio:
                n_sin_sitio += 1
                bytes_sin_sitio += tam
            clave = pathlib.Path(cwd).name if cwd else _proyecto_de_dir(d.name).name
            e = por_proyecto.setdefault(clave, {"proyecto": clave, "ficheros": 0,
                                                "bytes": 0, "bytes_sin_sitio": 0})
            e["ficheros"] += 1
            e["bytes"] += tam
            e["bytes_sin_sitio"] += tam if sin_sitio else 0
            try:
                edad = time.time() - jl.stat().st_mtime
            except OSError:
                edad = None
            for dias in _CORTES_EDAD:
                if edad is not None and edad >= dias * 86400:
                    cortes[dias][0] += 1
                    cortes[dias][1] += tam
            mayores.append({"bytes": tam, "proyecto": clave, "id": jl.stem,
                            "sin_sitio": sin_sitio, "idle": edad, "_path": jl})
    mayores.sort(key=lambda x: -x["bytes"])
    # El titulo se lee SOLO de las que se van a ensenar. Un "85 MB · 445cdc22" no dice
    # cual es, y leerlo de las 595 seria pagar un barrido entero para tirar 587 titulos.
    for e in mayores[:tope]:
        # El mismo titulo que ensena la lista, y por el mismo orden: el que puso el CLI
        # y, si no hay, la primera cosa que se dijo. `pulso()` lee la COLA, asi que sale
        # igual de barato en un transcript de 85 MB que en uno de 8 KB.
        pu = pulso({"_transcript": e["_path"], "id": e["id"]})
        e["titulo"] = ((pu.get("aiTitle") or first_user_text(e["_path"]) or "")[:44]) or None
    for e in mayores:
        e.pop("_path", None)
    return {
        "raiz": str(PROJECTS),
        "sesiones": n, "bytes": bytes_tot,
        "subagentes": n_sub, "bytes_subagentes": bytes_sub,
        "de_usar_y_tirar": n_tirar, "bytes_de_usar_y_tirar": bytes_tirar,
        "sin_sitio": n_sin_sitio, "bytes_sin_sitio": bytes_sin_sitio,
        "proyectos": len(por_proyecto),
        "por_proyecto": sorted(por_proyecto.values(), key=lambda x: -x["bytes"]),
        "mayores": mayores[:tope],
        # Cuanto pesa lo que lleva tiempo sin tocarse. Son tramos ANIDADOS —lo de mas
        # de 90 dias esta dentro de lo de mas de 30—, que es lo que hace que se lean
        # como "y si apuro un poco mas, cuanto mas": la pregunta que se hace quien mira
        # este comando. Sumarlos seria contar dos veces.
        "por_edad": [{"dias": d, "sesiones": cortes[d][0], "bytes": cortes[d][1]}
                     for d in _CORTES_EDAD],
    }


# Los cortes de "cuanto llevas sin tocar esto", y son cuatro por una razon medida: en
# esta maquina hay 3,2 GB de historial y NADA pasa de 30 dias —lo mas viejo son 28—, asi
# que unos cortes que empezaran en el mes dejaban el bloque vacio justo donde mas pesa.
# La semana entra por eso. Se pintan solo los tramos con algo dentro, de manera que una
# maquina con anos de historial ve los cuatro y esta ve uno.
_CORTES_EDAD = (7, 30, 90, 365)
_FILA_EDAD = "  %-14s %5d  %10s"
_FILA_PROY = "  %-30s %5d  %10s%s"
_FILA_NOW = "    %s %s  %s"
_FILA_SES = "  %10s  %8s  %-46s %s%s"


def que_hacen(tope_eventos=3):
    """Hechos: que esta ejecutando cada sesion viva, todas de una vez.

    El panel ya pinta este recorrido, pero SOLO el de la fila bajo el cursor, y por eso
    saber en que anda cada una cuesta bajar el cursor nueve veces. Aqui salen las nueve
    en una pantalla.

    Devuelve hechos tipados; el texto lo compone `cmd_now()`. La lectura es la misma que
    hace el panel —la cola del transcript— con la diferencia de que se hace para todas
    las filas en vez de para una: son 9-16 transcripts, no los 595 del historial.
    """
    filas = []
    for r in ordena(live_sessions(con_ram=False), "activity"):
        if r.get("fuente", "claude") != "claude":
            continue          # las del historial no estan haciendo nada por definicion
        d = detalles(r)
        ruta = d.get("ruta") or []
        # Los sintomas se sacan del recorrido ENTERO, no de los tres que se enseñan:
        # un bucle son tres fallos seguidos y con tres eventos a la vista no se ve.
        sint = sintomas(ruta)
        filas.append({
            "id": r.get("name") or "",
            "titulo": r.get("title_full") or r.get("title") or "",
            "proyecto": r.get("proyecto") or "",
            "estado": estado_estable(r),
            "idle": None if r.get("idle") is None else round(r["idle"]),
            "atasco": alertas(sint),
            "sintomas": sint,
            "eventos": ruta[-tope_eventos:],
        })
    return filas


def caja_now(h, w, n_lineas):
    """(alto, ancho, y, x, caben) del recuadro de la vista de todas.

    Aparte del pintado a proposito, como `linea_ruta`: asi la geometria se prueba sin
    curses. Y hace falta, porque ncurses **no avisa**: `newwin` mas ancho que la
    pantalla no da error y `addnstr` fuera del borde tampoco (medido el 2026-08-28 en un
    pty de 40 columnas). Un recuadro que se sale no revienta — se come el borde derecho
    y ya. Un test de pantalla no puede cazarlo; este si.
    """
    # El `min(h, ...)` y el `min(w, ...)` de fuera son la garantia, y no sobran: sin
    # ellos, en una ventana de 4 filas el suelo de 5 ganaba al hueco disponible y el
    # recuadro se salia por abajo. Que ncurses lo recorte sin rechistar es justo lo que
    # hace que un fallo asi viva meses.
    ancho = min(w, max(20, min(110, w - 4)))
    alto = min(h, max(5, min(h - 2, n_lineas + 4)))
    return (alto, ancho, max(0, (h - alto) // 2), max(0, (w - ancho) // 2),
            max(0, alto - 4))


def lineas_now(filas, ancho_t):
    """[(texto, par_de_color)] con la vista de todas. UN solo compositor.

    Lo pinta la terminal (`--now`) y tambien la pantalla del selector (`n`). Si cada una
    compusiera su texto acabarian diciendo cosas distintas de los mismos hechos, que es
    justo lo que este programa existe para no hacer.
    """
    trabajando = sum(1 for f in filas if f["estado"] in TRABAJANDO)
    out = [(_("{n} live \u00b7 {t} working, {e} waiting on you",
              n=len(filas), t=trabajando, e=len(filas) - trabajando), 6)]
    for f in filas:
        out.append(("", 0))
        # El estado va en TEXTO y no solo en color: esto se lee tambien por tuberia, y
        # un color que se pierde deja las nueve lineas iguales.
        cola = ESTADO_LARGO(f["estado"])
        if f["estado"] not in TRABAJANDO and f["idle"]:
            cola += " \u00b7 " + _hace(f["idle"])
        # Titulo, proyecto y estado en UNA linea: el proyecto en la suya gastaba un
        # renglon por sesion para repetir nueve veces la misma palabra.
        cabeza = f["titulo"] or f["id"]
        if f["proyecto"]:
            cabeza += "  \u00b7  " + f["proyecto"]
        out.append(("%s  %s" % (rellena(recorta(cabeza, ancho_t), ancho_t), cola), 0))
        for clave in f["atasco"]:
            out.append(("  ! %s" % _TEXTO_ALERTA[clave](f["sintomas"]), 5))
        for e in f["eventos"]:
            glifo, par, dur, res = linea_ruta(e, ancho_t + 20)
            out.append((_FILA_NOW % (glifo, dur, res),
                        par if (e["pend"] or e["err"]) else 4))
        if not f["eventos"]:
            out.append(("    " + _("no tool calls in the tail of its transcript"), 4))
    return out


def cmd_now(cols=None, tope_eventos=3):
    """Imprime lo que `que_hacen()` observo. Solo formatea: no vuelve a mirar nada."""
    filas = que_hacen(tope_eventos)
    if not filas:
        print(nada_que_ensenar())
        return 1
    ancho_t = min(80, max(40, (cols or shutil.get_terminal_size((92, 24)).columns) - 34))
    for texto, _par in lineas_now(filas, ancho_t):
        print(texto)
    return 0


