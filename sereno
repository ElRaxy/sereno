#!/usr/bin/env python3
"""sereno - see what every coding-agent session on your machine is actually doing.

A single-file, stdlib-only terminal UI over the sessions of Claude Code (and the
history of Codex, Gemini and Antigravity). It does not just list them: for each one
it reads the transcript and says whether the agent is writing, blocked on a command
of its own, or waiting on you - plus how much memory it eats, what you last asked
and what it last answered.

Nothing is required beyond Python 3.8 and the CLI you already use. tmux and Warp are
optional and only add live process control; without them everything is read from
~/.claude/projects, which the CLI itself writes.

  sereno                 the visual picker (arrows/mouse, SPACE marks, ENTER opens)
  sereno --demo          fake sessions, safe for screenshots and for a first look
  sereno --list          plain list, touches nothing
  sereno --json [--all]  the same facts as JSON, without any conversation in it
  sereno --watch         sit there and tell you when a session stops and waits on you
  sereno --find "text"   search every transcript for something that was actually said
  sereno --hook          one line if there is anything (for your shell rc)
  sereno --yes           reopen as tabs without asking
  sereno --dismiss       drop the orphan entries without reopening them
  sereno --close-sel "1,4-6"   close without opening the picker (for scripts)
  sereno --stop-sel  "idle"    stop them but leave them resumable

Environment: SERENO_LANG=en|es, SERENO_DEMO=1 (fake sessions, safe for screenshots),
SERENO_TMUX_SOCK, SERENO_REGISTRY.

Los comentarios de este fichero estan en castellano a proposito: explican POR QUE
esta cada cosa, y traducirlos perderia el matiz. La interfaz si es bilingue.

MIT licence. https://github.com/ElRaxy/sereno
"""
import os, sys, json, re, shlex, shutil, subprocess, time, datetime, pathlib, unicodedata

HOME = pathlib.Path.home()
# El nombre con el que te han invocado: el repo lo instala como `sereno`, pero por un
# symlink puede llamarse de otra forma y los mensajes deben decir lo que tecleaste.
PROG = pathlib.Path(sys.argv[0]).name or "sereno"


def _env(nombre, defecto=""):
    """SERENO_X, y si no CLAUDE_X. Lo segundo es compatibilidad con la version que
    vivia dentro de mi monorepo; sin ella, mi propia maquina dejaria de funcionar."""
    return os.environ.get("SERENO_" + nombre) or os.environ.get("CLAUDE_" + nombre) or defecto


ROOT = pathlib.Path(_env("REGISTRY") or _env("WARP_REG")
                    or HOME / ".claude/warp-sessions")
LIVE = ROOT / "live"
LAUNCH = HOME / ".warp/launch_configurations"
CONFIG_NAME = "claude-restore"
# Un transcript tocado hace menos de esto es una sesion viva. Es el mismo umbral que
# usa `pulso()` para decidir si esta escribiendo: dos numeros distintos harian que la
# lista y el panel se contradijeran delante del usuario.
VIVA = 90
# Alfabetico ponia "antigravity" delante de "historial" y "codex": el orden util es
# por cercania a lo que estas mirando, no por la inicial.
ORDEN_FUENTES = ["claude", "historial", "codex", "gemini", "antigravity"]
# El valor interno se queda en castellano (es la clave de `fuente` en cada fila); lo
# que se traduce es la etiqueta que se pinta.
_ETIQUETAS = {"todas": "all", "historial": "history"}


def etiqueta_fuente(nombre):
    return _(_ETIQUETAS.get(nombre, nombre))


# ─────────────────────────── idioma de la interfaz ───────────────────────────
# Se traduce lo que sale por pantalla; los comentarios y los nombres de variables se
# quedan en castellano a proposito: reescribirlos no ayuda a nadie y se pierde matiz.
# La CLAVE es la cadena inglesa, asi que una cadena sin traducir sale en ingles — no
# revienta ni deja un identificador crudo delante del usuario.
_IDIOMAS = ("en", "es")


def _detecta_idioma():
    """`CLAUDE_SESSIONS_LANG` manda; si no, el locale; si no, ingles.

    En macOS hay que preguntarle a `defaults`: la terminal suele traer `LANG=C.UTF-8`
    —medido en esta maquina— y por ahi no se distingue un espanol de un japones.
    """
    v = _env("LANG")[:2].lower()
    if v in _IDIOMAS:
        return v
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        v = os.environ.get(var, "")[:2].lower()
        if v in _IDIOMAS:
            return v
    if sys.platform == "darwin":
        try:
            v = subprocess.run(["defaults", "read", "-g", "AppleLocale"],
                               capture_output=True, text=True, timeout=3).stdout[:2].lower()
            if v in _IDIOMAS:
                return v
        except Exception:
            pass
    return "en"


LANG_UI = _detecta_idioma()
TEXTOS = {"es": {}}          # lo rellena _T() al final del fichero


def _(clave, **kw):
    t = TEXTOS.get(LANG_UI, {}).get(clave, clave)
    return t.format(**kw) if kw else t


def read_entry(path):
    data = {}
    try:
        for line in path.read_text().splitlines():
            if "=" not in line:
                continue
            k, v = line.split("=", 1)
            try:
                parts = shlex.split(v)
            except ValueError:
                parts = [v]
            key = k.strip()
            data[key] = parts[0] if parts else ""
            data[key + "__list"] = parts
    except OSError:
        return None
    data["_file"] = path
    return data


def alive(pid):
    """Vivo = el PID existe Y su linea de comando menciona claude (evita reuso de PID)."""
    if not pid or not str(pid).isdigit() or int(pid) <= 1:
        return False
    try:
        os.kill(int(pid), 0)
    except (OSError, ProcessLookupError, PermissionError):
        return False
    try:
        out = subprocess.run(["ps", "-p", str(pid), "-o", "command="],
                             capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return True  # si no se puede comprobar, no la tratamos como muerta
    return "claude" in out


def transcript_of(e):
    pd, sid = e.get("project_dir"), e.get("id")
    if not pd or not sid:
        return None
    p = pathlib.Path(pd) / f"{sid}.jsonl"
    return p if p.is_file() else None


_SALUDO = re.compile(
    r"^(hola|buenas|buenos d[ií]as|buenas tardes|buenas noches|oye|vale|okey|ok|"
    r"perfecto|gracias)[\s,.:;!¡-]*", re.I)


def _strip_saludo(t):
    prev = None
    while t and t != prev:          # "Buenas, hola oye ..." se pela en varias vueltas
        prev = t
        t = _SALUDO.sub("", t, count=1).lstrip()
    return t or prev or ""


# ───────────────────────────── capa tmux ─────────────────────────────
# Con tmux debajo, "que sesiones siguen vivas" ya no se deduce de PIDs muertos:
# lo dice `tmux list-sessions`. El registro solo aporta metadatos (titulo, flags).
TMUX_BIN = shutil.which("tmux") or "/opt/homebrew/bin/tmux"
# Socket parametrizable: el valor real es "claude-code"; la variable solo existe
# para poder probar este script contra un servidor tmux de juguete.
SOCK = _env("TMUX_SOCK", "claude-code")


# Titulos que el binario emite cuando no tiene nada mejor: no identifican nada.
_TITULO_GENERICO = {"", "claude code", "claude", "zsh", "bash", "-zsh", "tmux"}


def tmux_list():
    """[(nombre, creada, enganchada, titulo, pid)] de las sesiones vivas.

    `pane_title` es la via buena para el titulo: Claude Code emite ahi el nombre
    de `/rename` (y si no, su aiTitle), asi que sale en vivo y sin abrir ningun
    fichero. Se pide con list-panes porque list-sessions no expone pane_title;
    de una sesion con varios paneles vale el primero.
    """
    if not pathlib.Path(TMUX_BIN).exists():
        return []
    try:
        r = subprocess.run(
            [TMUX_BIN, "-L", SOCK, "list-panes", "-a", "-F",
             "#{session_name}\t#{session_created}\t#{session_attached}"
             "\t#{pane_title}\t#{pane_pid}"],
            capture_output=True, text=True, timeout=10)
    except Exception:
        return []
    if r.returncode != 0:
        return []                      # sin servidor = sin sesiones, no es error
    out, vistas = [], set()
    for line in r.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 5 or parts[0] in vistas:
            continue
        vistas.add(parts[0])
        titulo = parts[3].lstrip("\u2733\u2734\u2735* ").strip()
        # Un panel que aun no ha emitido titulo propio se queda con el hostname:
        # El hostname por defecto de un portatil no identifica ninguna sesion, asi
        # que cuenta como titulo generico.
        if titulo.lower() in _TITULO_GENERICO or titulo.endswith(".local"):
            titulo = ""
        out.append((parts[0], int(parts[1] or 0), parts[2] != "0", titulo,
                    parts[4] if parts[4].isdigit() else ""))
    return out


def tmux_kill(name=None):
    if name:
        subprocess.run([TMUX_BIN, "-L", SOCK, "kill-session", "-t", name], check=False)
    else:
        subprocess.run([TMUX_BIN, "-L", SOCK, "kill-server"], check=False)


def meta_by_tmux():
    """Metadatos del registro indexados por nombre de sesion tmux."""
    if not LIVE.is_dir():
        return {}
    out = {}
    for f in sorted(LIVE.glob("*.env")):
        e = read_entry(f)
        if e and e.get("tmux_session"):
            e["_transcript"] = transcript_of(e)
            out[e["tmux_session"]] = e
    return out


def pulso(e, secs=90, fino=True):
    """Hechos sobre lo que hace la sesion. El veredicto lo compone quien llame.

    {"escribe": bool|None, "herramienta": bool|None}

    Con `escribe` solo no basta y era el fallo de la version anterior: mientras
    Claude espera a que termine un comando NO escribe nada en el transcript, asi que
    una sesion en mitad de un `Bash` de tres minutos figuraba como parada. Lo que la
    delata es que su ultimo evento sea un `tool_use` cuyo `tool_result` no ha llegado.

    Los procesos hijos NO sirven para esto: medido el 2026-08-25, las 8 sesiones
    tenian 6-7 descendientes cada una solo por los servidores MCP (context7, uv,
    npm exec), estuvieran haciendo algo o no.
    """
    t = e.get("_transcript") if e else None
    if not t:
        return {"escribe": None, "herramienta": None}
    try:
        escribe = (time.time() - t.stat().st_mtime) < secs
    except OSError:
        return {"escribe": None, "herramienta": None}
    if not fino:
        # El aviso de abrir terminal solo cuenta sesiones: leer la cola de todos los
        # transcripts para afinar le costaria 100 ms en vez de 30, y no cambia lo que
        # imprime. Lo fino lo pide el selector, que si lo pinta.
        return {"escribe": escribe, "herramienta": None}

    pendientes, ultimo_tool, extra = set(), False, {}
    for raw in ultimas_lineas(t, 80):
        try:
            j = json.loads(raw)
        except Exception:
            continue
        for k in ("cwd", "gitBranch", "lastPrompt", "aiTitle"):
            if j.get(k):
                extra[k] = j[k]            # de una pasada: no hay que releer despues
        if j.get("isSidechain"):
            continue
        msg = j.get("message") or {}
        # El contexto que lleva gastado la sesion viaja en el `usage` de cada respuesta:
        # lo que leyo de cache + lo que acaba de cachear + lo que va suelto. No hay API
        # que preguntar y esta cola ya se estaba leyendo, asi que no cuesta ni una
        # lectura mas. Vale el ULTIMO, que es el vigente — y por eso se mira aqui abajo
        # y no antes: los sidechain son subagentes, y su contexto no es el de la sesion.
        u = msg.get("usage")
        if isinstance(u, dict) and j.get("type") == "assistant":
            n = sum(u.get(k) or 0 for k in ("cache_read_input_tokens",
                                            "cache_creation_input_tokens",
                                            "input_tokens"))
            if n:
                extra["ctx"] = n
                m = msg.get("model") or ""
                if m.startswith("claude"):      # `<synthetic>` no es un modelo
                    extra["modelo"] = m
        cont = msg.get("content")
        bloques = cont if isinstance(cont, list) else []
        if j.get("type") == "assistant":
            ids = {b.get("id") for b in bloques
                   if isinstance(b, dict) and b.get("type") == "tool_use"}
            if ids:
                pendientes |= ids
                ultimo_tool = True
            elif any(isinstance(b, dict) and b.get("type") == "text" for b in bloques):
                ultimo_tool = False
        elif j.get("type") == "user":
            pendientes -= {b.get("tool_use_id") for b in bloques
                           if isinstance(b, dict) and b.get("type") == "tool_result"}
            if not pendientes:
                ultimo_tool = False
    return {"escribe": escribe, "herramienta": bool(pendientes) and ultimo_tool,
            **extra}


def _dur(secs):
    secs = int(secs)
    h, m = secs // 3600, (secs % 3600) // 60
    return f"{h}h {m:02d}m" if h else f"{m}m"


def idle_secs(e):
    """Segundos desde la ultima actividad real de la sesion (su transcript).

    NO vale `session_created` de tmux para esto: tras un apagon todas las sesiones
    renacen hoy y parecen igual de nuevas aunque la conversacion sea de ayer. El
    transcript es lo unico que distingue una sesion viva de una abandonada.
    """
    t = (e or {}).get("_transcript")
    if not t:
        return None
    try:
        return max(0, time.time() - t.stat().st_mtime)
    except OSError:
        return None


def ai_title(e):
    """El titulo que Claude Code se pone a si mismo, de la cola del transcript.

    Solo se consulta cuando tmux no da uno (pane_title generico): abrir el fichero
    es mas caro que leer una variable, y para la mayoria de sesiones no hace falta.
    """
    t = (e or {}).get("_transcript")
    if not t:
        return ""
    for raw in reversed(ultimas_lineas(t, 40)):
        try:
            j = json.loads(raw)
        except Exception:
            continue
        if j.get("aiTitle"):
            return j["aiTitle"]
    return ""


def rss_por_arbol(pids):
    """MB de RSS de cada pid contando a sus descendientes. Un solo `ps` para todos.

    16 sesiones de Claude en un portatil no son gratis, y ese es justo el dato que
    falta para decidir cual sobra: "hace 5h que no la tocas y ocupa 900 MB".
    """
    if not pids:
        return {}
    try:
        out = subprocess.run(["ps", "-eo", "pid=,ppid=,rss="],
                             capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return {}
    hijos, rss = {}, {}
    for linea in out.splitlines():
        campos = linea.split()
        if len(campos) != 3 or not all(c.isdigit() for c in campos):
            continue
        pid, ppid, kb = (int(c) for c in campos)
        hijos.setdefault(ppid, []).append(pid)
        rss[pid] = kb
    def suma(pid, visto):
        if pid in visto:
            return 0
        visto.add(pid)
        return rss.get(pid, 0) + sum(suma(h, visto) for h in hijos.get(pid, ()))
    return {p: suma(int(p), set()) / 1024 for p in pids if str(p).isdigit()}


def live_sessions(con_ram=False, con_disco=True, fino=None, solo_activas=True):
    if DEMO:
        return [r for r in sesiones_demo() if r.get("fuente") == "claude"]
    """`con_ram` cuesta un `ps -eo` de toda la maquina: 220 ms medidos con 9 sesiones.

    El hook que corre al abrir terminal solo dice cuantas hay, asi que ahi no se
    pide; solo la pide el selector, que si la pinta.

    `con_disco` anade las sesiones vivas que tmux no ve. Son dos casos y los dos
    importan: en una maquina sin nuestro wrapper es la UNICA fuente, y en la de casa
    saca las que se lanzaron desde VS Code o con la ruta completa al binario, que
    hasta ahora no aparecian en ningun sitio.
    """
    # El pulso fino y la RAM iban atados porque hasta ahora solo los pedia el selector,
    # que pinta las dos cosas. `--watch` quiere lo fino —es lo que detecta el cambio de
    # estado— y NO quiere el `ps -eo` de toda la maquina cada veinte segundos.
    if fino is None:
        fino = con_ram
    metas = meta_by_tmux()
    paneles = tmux_list()
    mem = rss_por_arbol([p for *_resto, p in paneles if p]) if con_ram else {}
    rows = []
    for name, created, attached, titulo, pid in paneles:
        e = metas.get(name, {})
        pu = pulso(e, fino=fino) if e else {"escribe": None, "herramienta": None}
        # Orden de preferencia del titulo: lo que el usuario puso con /rename o el
        # aiTitle (los dos llegan por pane_title, en vivo) > el aiTitle del
        # transcript > el primer mensaje. Lo ultimo era la unica fuente y es la peor.
        propio = titulo or pu.get("aiTitle", "")
        rows.append({
            "name": name, "created": created, "attached": attached,
            "meta": e, "pid": pid,
            "mem_mb": mem.get(pid),
            "title": (propio[:33] + "\u2026") if len(propio) > 34 else (propio or (label(e) if e else name)),
            "title_full": propio or (label(e, 200) if e else name),
            "idle": idle_secs(e),
            "pulso": pu,
            "proyecto": pathlib.Path(pu.get("cwd") or e.get("cwd") or "").name,
            "rama": pu.get("gitBranch", ""),
            "working": None if pu["escribe"] is None
                       else bool(pu["escribe"] or pu["herramienta"]),
        })
    if con_disco:
        ids = {(r.get("meta") or {}).get("id") for r in rows}
        # `solo_activas=False` lo pide `--watch`: el filtro por mtime tira una sesion
        # a los 90 segundos de callarse, que es EXACTAMENTE cuando acaba de terminar y
        # hay que avisar. Sin tmux delante, el vigilante se quedaba sin ver el flanco
        # que existe para ver. Lo caza `tests/test_watch_flanco.py`.
        rows += sesiones_de_disco(vistos=ids, solo_activas=solo_activas, fino=fino)
    rows.sort(key=lambda r: (r["idle"] is None, -(r["idle"] or 0)))
    return rows


# ─────────────── sesiones leidas del historial, sin tmux ni registro ───────────────
# El registro de `tools/claude` y tmux dan RAM y "tiene pestana abierta", que esto no
# puede saber. A cambio, `~/.claude/projects` lo escribe el propio CLI en CUALQUIER
# maquina: es la unica via que funciona sin haber instalado antes nuestro wrapper, y
# ademas ve las sesiones que el wrapper no lanzo (VS Code, `claude` por ruta completa).
PROJECTS = HOME / ".claude/projects"
_CACHE_DISCO = {}
# Una sesion reanudable se llama como su UUID. Los `agent-*.jsonl` que el CLI deja al
# lado son transcripts de SUBAGENTES: no se reanudan, no tienen titulo propio y son
# muchos —213 en esta maquina, contra 1.035 sesiones— asi que colarlos enterraba la
# lista bajo veinte copias del mismo prompt de subagente.
_UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")


def _proyecto_de_dir(nombre):
    """`-home-you-code-my-project` -> `/home/you/code/my-project`.

    Es una conjetura: el CLI aplana el path sustituyendo `/` por `-`, asi que un
    directorio con guion propio no se puede deshacer. Por eso solo se usa como
    ULTIMO recurso — el `cwd` bueno viene dentro del transcript.
    """
    return "/" + nombre.lstrip("-").replace("-", "/") if nombre.startswith("-") else ""


def _ids(rows):
    return {(r.get("meta") or {}).get("id") for r in rows}


def sesiones_de_disco(vistos=(), solo_activas=False, limite=40, fino=True):
    if DEMO:
        return []
    """Filas a partir de los transcript de `~/.claude/projects`.

    `solo_activas` filtra por mtime ANTES de abrir nada: preguntar "¿hay alguna
    sesion viva que tmux no vea?" cuesta entonces un `stat` por fichero y no una
    lectura. Sin ese filtro, 1.248 transcript son 3,8 GB de cola por barrer.
    """
    if not PROJECTS.is_dir():
        return []
    ahora, cands = time.time(), []
    for p in PROJECTS.glob("*/*.jsonl"):     # sin `**`: los `subagents/` no se reanudan
        if p.stem in vistos or not _UUID.match(p.stem):
            continue
        try:
            mt = p.stat().st_mtime
        except OSError:
            continue
        if solo_activas and ahora - mt > VIVA:
            continue
        cands.append((mt, p))
    cands.sort(reverse=True)
    return [fila_de_transcript(p, mt, fino=fino) for mt, p in cands[:limite]]


def fila_de_transcript(p, mt=None, fino=True):
    """Una fila a partir de un `.jsonl` suelto. Vive aparte porque la quieren dos:
    el barrido de `sesiones_de_disco` y la busqueda de `--find`."""
    if mt is None:
        try:
            mt = p.stat().st_mtime
        except OSError:
            mt = 0
    clave = (str(p), mt)
    fila = _CACHE_DISCO.get(clave)
    if fila is None:
        e = {"id": p.stem, "project_dir": str(p.parent), "_transcript": p}
        pu = pulso(e, fino=fino)
        e["cwd"] = pu.get("cwd") or _proyecto_de_dir(p.parent.name)
        titulo = (pu.get("aiTitle") or first_user_text(p) or p.stem[:8])
        fila = {
            "name": p.stem, "created": 0, "attached": False, "meta": e, "pid": "",
            "mem_mb": None, "_sin_proceso": True,
            "title": (titulo[:33] + "\u2026") if len(titulo) > 34 else titulo,
            "title_full": titulo, "pulso": pu,
            "proyecto": pathlib.Path(e["cwd"] or "").name,
            "rama": pu.get("gitBranch", ""),
        }
        if len(_CACHE_DISCO) > 400:
            _CACHE_DISCO.clear()          # la clave lleva el mtime: crece sin tope
        _CACHE_DISCO[clave] = fila
    fila = dict(fila)
    fila["idle"] = max(0.0, time.time() - mt)
    viva = fila["idle"] <= VIVA
    # `working` sale del pulso, que mira el transcript; sin proceso que inspeccionar es
    # lo unico observable, y es honesto: si nadie escribe ahi, no esta trabajando.
    fila["working"] = bool(fila["pulso"].get("escribe")
                           or fila["pulso"].get("herramienta")) if viva else False
    fila["fuente"] = "claude" if viva else "historial"
    return fila


# ───────────────────────────── modo demostracion ─────────────────────────────
# `CLAUDE_SESSIONS_DEMO=1` sustituye la lista por sesiones inventadas. No es un
# juguete: el panel ensena el ultimo prompt y la ultima respuesta, asi que grabar una
# captura contra sesiones de verdad publica trabajo de clientes. Con esto la captura
# del README sale de datos que no existen, y ademas se puede probar el layout sin
# tener cinco sesiones abiertas.
DEMO = _env("DEMO", "0") not in ("", "0")

_DEMO = [
    # titulo, proyecto, rama, idle, MB, escribe, herramienta, prompt, respuesta, tool,
    # fuente. La fuente va explicita y no derivada del idle: una sesion abierta en tmux
    # sigue viva aunque lleve dos horas quieta, y la demo tiene que ensenar ese caso.
    ("Refactor payment webhooks", "checkout-api", "feat/webhooks", 3, 512, True, True,
     "The Stripe webhook handler retries forever when the DB write fails. Make it "
     "idempotent and add a dead-letter path.",
     "Found it: the handler acks only after the write, so a failed write means Stripe "
