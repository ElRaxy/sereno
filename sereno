def _clean(t):
    t = re.sub(r"```.*?```", " ", t, flags=re.S)
    t = re.sub(r"[`*#>\[\]]", "", t)
    t = re.sub(r"\s+", " ", t).strip()
    return t


def _user_texts(blob):
    """Mensajes escritos por el usuario dentro de un trozo de transcript."""
    out = []
    for raw in blob.splitlines():
        try:
            d = json.loads(raw)
        except Exception:
            continue
        if d.get("type") != "user" or d.get("isSidechain"):
            continue
        c = d.get("message", {}).get("content")
        if isinstance(c, str):
            t = c
        elif isinstance(c, list):
            t = " ".join(b.get("text", "") for b in c
                         if isinstance(b, dict) and b.get("type") == "text")
        else:
            continue
        t = _clean(t)
        if not t or t.startswith("<"):
            continue
        if "system-reminder" in t[:200] or "tool_use_id" in t[:200]:
            continue
        if t.startswith("Request interrupted") or t.startswith("API Error"):
            continue          # ruido del propio CLI, no lo escribio el usuario
        if t.startswith("Pre-Compact Rutina") or t.startswith("Vuelve a preguntarme"):
            continue          # texto inyectado por comandos, no lo escribio el usuario
        out.append(t)
    return out


def _head(path, n=256 * 1024):
    try:
        with path.open("rb") as f:
            return f.read(n)
    except OSError:
        return b""


def _tail(path, n=512 * 1024):
    try:
        size = path.stat().st_size
        with path.open("rb") as f:
            if size > n:
                f.seek(size - n)
                f.readline()          # descarta la linea partida por el seek
            return f.read()
    except OSError:
        return b""


def ultimas_lineas(path, cuantas=60, tope=8 * 1024 * 1024):
    """Las ultimas `cuantas` lineas COMPLETAS, retrocediendo en bloques.

    Leer "los ultimos N bytes" no vale en estos transcripts: una sola linea de
    `tool_result` puede pasar de 96 KB, y entonces la ventana cae entera dentro de
    esa linea, se descarta como parcial y el lector se queda sin nada que mirar. Es
    lo que hacia que una sesion en mitad de un comando figurase como parada.
    """
    try:
        size = path.stat().st_size
    except OSError:
        return []
    # Cada vuelta lee SOLO el trozo nuevo y lo apila; unir al final. Releer desde el
    # nuevo tope hasta el final —que es lo que se hacia— multiplica el disco por el
    # numero de vueltas: un transcript de 8 MB en una sola linea se leia dieciseis
    # veces, 135 MB, dentro del bucle que repinta la lista. Por lo mismo los saltos se
    # cuentan por trozo y no sobre lo acumulado.
    trozo, trozos, leido, saltos, pos = 256 * 1024, [], 0, 0, size
    try:
        with path.open("rb") as f:
            while pos > 0 and leido < tope:
                cuanto = min(trozo, pos)
                pos -= cuanto
                f.seek(pos)
                b = f.read(cuanto)
                trozos.append(b)
                leido += len(b)
                saltos += b.count(b"\n")
                if saltos > cuantas or pos == 0:
                    break
    except OSError:
        return []
    lineas = b"".join(reversed(trozos)).split(b"\n")
    if pos > 0 and lineas:
        lineas = lineas[1:]                 # la primera puede venir partida
    # El filtro va ANTES del corte. Al reves, el hueco que deja el salto final del
    # fichero —y cualquier linea en blanco— se come una plaza de las `cuantas`
    # pedidas: `pulso()` pedia 80 y recibia 79.
    utiles = [l for l in lineas if l.strip()][-cuantas:]
    return [l.decode("utf-8", "replace") for l in utiles]


# ─────────────────── lo que lleva gastado, no lo que ocupa ─────────────────
# La barra de contexto dice cuanto OCUPA la ventana ahora mismo. No dice cuanto se ha
# quemado: una sesion que ha compactado tres veces marca 20% con doce horas dentro.
# Lo acumulado sale del `usage` de cada respuesta, y eso obliga a leer el transcript
# ENTERO: las cifras estan repartidas por todo el fichero y la cola no sirve. Por eso
# esto NO se calcula para la lista, sino para la fila bajo el cursor —igual que
# `detalles()`— y se cachea por (fichero, tamano, mtime).
#
# Tres trampas medidas sobre los 739 transcripts de esta maquina, y las tres cambian el
# numero que sale:
#
#   1. Una respuesta ocupa VARIAS lineas —un `thinking` y dos `tool_use` van en tres— y
#      las tres repiten el MISMO `usage`. Sumarlas todas infla la salida entre un +49% y
#      un +123% segun la sesion. Se deduplica por `message.id`, y basta compararlo con el
#      anterior: en 14.507 lineas con `usage` de 60 transcripts, un id repetido nunca
#      aparecio separado de sus hermanos. Eso ahorra guardar el conjunto entero de ids.
#   2. `cache_read_input_tokens` NO es material nuevo: es lo ya enviado que se vuelve a
#      leer, y es cien veces mayor que el resto (300M frente a 3M en una sesion de ocho
#      horas). Sumarlo con la entrada da una cifra enorme que no significa nada, asi que
#      va aparte y no se junta nunca con `in`/`cw`.
#   3. La ultima linea de una sesion viva se esta escribiendo mientras la lees. Si se
#      consume a medias, el `_pos` avanza sobre ella y esos tokens se pierden para siempre.
#
# Y una cuarta que no se puede arreglar desde aqui, pero hay que saberla: los turnos de
# subagente y las llamadas a Haiku que el CLI hace por su cuenta (titulos, resumenes) NO
# dejan linea en el transcript. Cruzado contra el `cost-state` que escribe el propio CLI,
# esto cuadra al 0,1% en cinco transcripts de ocho y se queda hasta un 21% corto en dos.
# Se llama `input_tokens`/`output_tokens` —lo que el transcript registro— y no "lo que te
# han cobrado", que es otra cosa y viaja aparte en `usd`.
TOPE_USO = 256 * 1024 * 1024      # por encima, `None`: mejor sin dato que a medias
_CACHE_USO = {}
_USO_CAMPOS = (("in", "input_tokens"), ("out", "output_tokens"),
               ("cw", "cache_creation_input_tokens"),
               ("cr", "cache_read_input_tokens"))


def _epoch(ts):
    """Segundos de un `2026-08-26T06:24:23.762Z`, troceando la cadena a mano.

    No se usa `datetime.fromisoformat`: en 3.8 exige exactamente 3 o 6 decimales, y un
    transcript escrito por otra version del CLI reventaria en silencio devolviendo 0 —
    que aqui se confundiria con "esta sesion no ha trabajado nada". Solo se necesitan
    segundos: lo que se mide son huecos entre respuestas, no instantes.
    """
    try:
        return datetime.datetime(int(ts[0:4]), int(ts[5:7]), int(ts[8:10]),
                                 int(ts[11:13]), int(ts[14:16]), int(ts[17:19]),
                                 tzinfo=datetime.timezone.utc).timestamp()
    except (TypeError, ValueError, IndexError):
        return 0.0


def _uso(path, tope=None):
    """Hechos acumulados del transcript, o None si no se pudo leer.

    Devuelve tipos cerrados y NUNCA un total agregado: quien pinte decide que suma con
    que, porque juntar la cache leida con la entrada nueva da un numero que no significa
    nada. Los campos con guion bajo son estado para la lectura incremental y no salen
    de aqui: `filas_json` los nombra uno a uno.

    `tope` es un maximo de BYTES a leer en esta llamada. Con el, la lectura se puede
    partir en trozos entre refrescos en vez de bloquear: el mayor transcript de esta
    maquina son 89 MB y 120 ms de tiron, y ese tiron se paga entero cada vez que el
    cursor llega a una fila nueva. Lo que vuelve entonces es un PARCIAL, y se distingue:
    `completo` dice si se llego al final de lo que hay escrito. Un parcial no se pinta
    como si fuera un total —seria mentir— salvo `pico`, que solo puede crecer.

    Coste medido en esta maquina: 0,11 ms la mediana de los transcripts, 223 ms el mayor
    (89,3 MB, sin cache de pagina), 0,08 ms las 40 filas con la cache caliente y 2,6 ms
    el refresco de una sesion viva (17 KB nuevos en 20 s).
    """
    try:
        st = path.stat()
    except OSError:
        return None
    guardado = _CACHE_USO.get(str(path))
    if (guardado and guardado[0] == st.st_size and guardado[1] == st.st_mtime
            and guardado[2]["completo"]):
        return guardado[2]
    if guardado and st.st_size >= guardado[0]:
        d = dict(guardado[2])          # sigue creciendo: se lee solo lo nuevo
    else:
        # Encogio (o no habia nada): lo han reescrito y el offset ya no vale. Releer
        # 89 MB una vez es mas barato que publicar una cifra que se quedo a medias.
        if st.st_size > TOPE_USO:
            return None
        d = {"in": 0, "out": 0, "cw": 0, "cr": 0, "turnos": 0, "compacta": 0,
             "pico": 0, "activo": 0.0, "usd": None, "completo": False,
             "_pos": 0, "_ult": None, "_ts": 0.0}
    d["completo"] = True               # salvo que el tope corte la lectura
    fin = None if tope is None else d["_pos"] + max(0, tope)
    try:
        with path.open("rb") as f:
            f.seek(d["_pos"])
            for raw in f:
                if not raw.endswith(b"\n"):
                    break              # la esta escribiendo ahora: se lee la proxima vez
                if fin is not None and d["_pos"] >= fin:
                    # Se corta ANTES de consumir la linea: el offset no avanza, asi que
                    # la proxima llamada la vuelve a leer. Cortar despues de mover el
                    # offset y antes de contarla perderia una linea en silencio.
                    d["completo"] = False
                    break
                d["_pos"] += len(raw)
                # Criba por bytes antes de parsear. Sobre el transcript de 89 MB baja de
                # 136 ms a 79 ms y no pierde nada: los falsos positivos (un `tool_result`
                # que menciona la palabra) los descarta el parseo de abajo.
                if (b'"usage"' not in raw and b'cost-state' not in raw
                        and b'compact_boundary' not in raw):
                    continue
                try:
                    j = json.loads(raw)
                except Exception:
                    continue
                tipo = j.get("type")
                if tipo == "system" and j.get("subtype") == "compact_boundary":
                    # Lo que explica una barra de contexto baja en una sesion larga.
                    d["compacta"] += 1
                    # Y lo que la sesion tenia dentro justo antes. Es la unica huella
                    # del pico que sobrevive a compactar: las respuestas de despues ya
                    # cuentan la ventana nueva. Comprobado que es contexto y no un
                    # acumulado — contra el `usage` de la respuesta anterior, mediana
                    # +0,4% y 165 de 169 dentro del +-5%.
                    v = (j.get("compactMetadata") or {}).get("preTokens")
                    if isinstance(v, int):
                        d["pico"] = max(d["pico"], v)
                    continue
                if tipo == "cost-state":
                    # Lo escribe el CLI al cerrar, con SUS precios. `sereno` no calcula
                    # dinero: lo relata. Vale el ultimo, que es el vigente.
                    #
                    # Y un 0 con `modelUsage` vacio NO es "esta sesion costo cero": es que
                    # esa cuenta no lleva la contabilidad, asi que el dato no consta.
                    # Guardarlo como 0.0 le decia a una statusline que el trabajo salio
                    # gratis. Medido sobre los 878 transcripts de esta maquina: 40 lineas
                    # con coste mayor que cero, 8 con ese cero sin desglose, y **ninguna**
                    # con un cero legitimo (0 y `modelUsage` lleno). O sea que distinguirlos
                    # no pierde ni un caso real.
                    v = j.get("totalCostUSD")
                    if isinstance(v, (int, float)) and (v or (j.get("modelUsage") or {})):
                        d["usd"] = float(v)
                    continue
                if tipo != "assistant":
                    continue
                m = j.get("message") or {}
                u = m.get("usage")
                if not isinstance(u, dict):
                    continue
                mid = m.get("id")
                if mid is not None and mid == d["_ult"]:
                    continue           # otra linea de la MISMA respuesta: ya contada
                d["_ult"] = mid
                d["turnos"] += 1
                for clave, campo in _USO_CAMPOS:
                    d[clave] += u.get(campo) or 0
                # El contexto de ESA respuesta, que es lo que suma la barra: entrada
                # nueva mas cache. La salida no cuenta, no viaja de vuelta al modelo.
                d["pico"] = max(d["pico"], (u.get("input_tokens") or 0)
                                + (u.get("cache_read_input_tokens") or 0)
                                + (u.get("cache_creation_input_tokens") or 0))
                t = _epoch(j.get("timestamp") or "")
                if t:
                    # Trabajo = huecos entre respuestas que no pasan de `VIVA`. Se reusa
                    # esa constante y no un numero nuevo porque el programa YA llama "no
                    # esta escribiendo" a un transcript quieto 90 s: dos umbrales harian
                    # que el panel y la lista se contradijeran. El `max(0, …)` es por los
                    # transcripts reanudados, que traen lineas copiadas fuera de orden.
                    if d["_ts"]:
                        d["activo"] += max(0.0, min(t - d["_ts"], VIVA))
                    d["_ts"] = t
    except OSError:
        return None
    if len(_CACHE_USO) > 200:
        _CACHE_USO.clear()             # la clave no lleva mtime: crece sin tope
    _CACHE_USO[str(path)] = (st.st_size, st.st_mtime, d)
    return d


def uso_de(r, tope=None):
    """El acumulado de la fila, o None. Mismo trato que `detalles()`: se lee SOLO para
    quien lo mira. La lista no lo pinta y `--json` solo con `--usage`, porque cuesta el
    transcript entero y un `--json` que alimenta una statusline se llama cada pocos
    segundos. Una fila de otro CLI no tiene transcript y devuelve None, que no es cero.

    Sin `tope` lee hasta el final, que es lo que quieren `--list` y `--json`: son una
    pasada y no tienen a nadie esperando delante. Con `tope`, deja el trabajo a medias y
    lo dice en `completo` — es lo que usa el selector para no bloquearse.
    """
    if "_uso" in r and (r["_uso"] is None or r["_uso"].get("completo") or tope is None):
        if r["_uso"] is None or r["_uso"].get("completo"):
            return r["_uso"]
    t = (r.get("meta") or {}).get("_transcript")
    r["_uso"] = _uso(t, tope) if t else None
    return r["_uso"]


# Cuanto se lee de cada transcript por vuelta, y cuanto se deja gastar en total. El
# trozo es mayor que el 99% de los transcripts de esta maquina, asi que en la practica
# casi todos se leen de una: lo que parte en trozos son los gigantes, que son los que
# se notan. Y el presupuesto acota el peor caso de una vuelta a menos de lo que tarda
# una pulsacion en verse.
TROZO_USO = 8 * 1024 * 1024
PRESUPUESTO_USO_MS = 25


def avanza_uso(rows, ms=PRESUPUESTO_USO_MS, trozo=TROZO_USO):
    """Adelanta la lectura de los transcripts que falten, sin pasar de `ms`.

    El bucle del selector la llama en cada vuelta —cada tecla y cada 2,5 s—, asi que un
    transcript grande se termina en unas pocas y ninguna se lleva mas del presupuesto.
    Sin esto, llegar con el cursor a una fila de 89 MB cuesta 120 ms de tiron, y el modo
    `spend` cuesta 389 ms de golpe al entrar.

    El orden de `rows` es la prioridad: quien llama pone delante lo que se esta mirando.
    """
    limite = time.monotonic() + ms / 1000.0
    for r in rows:
        u = r.get("_uso", 0)
        if u is None or (isinstance(u, dict) and u.get("completo")):
            continue                   # ya esta, o no hay transcript que leer
        # Se insiste con la MISMA fila mientras quede presupuesto, en vez de repartir un
        # trozo a cada una: la primera es la que se esta mirando, y terminarla es lo que
        # hace aparecer sus cifras en el panel. Repartiendo, un transcript de 89 MB
        # tardaba once vueltas en dar un numero.
        while True:
            u = uso_de(r, trozo)
            if u is None or u.get("completo") or time.monotonic() >= limite:
                break
        if time.monotonic() >= limite:
            break
    return rows


def pico_de(r):
    """El mayor contexto que la fila llego a tener, o 0 si nadie ha leido su transcript.

    No lee: solo mira lo que `uso_de()` haya dejado. `0` es "no consta" y la cascada no
    decide nada con el, igual que `None` en `ventana_1m`. Asi la lista puede pintar la
    barra sin pagar el fichero entero, y el panel —que ya lo paga— la pinta mejor.
    """
    return (r.get("_uso") or {}).get("pico") or 0


def _uso_texto(u):
    """`1.4M in · 403k out · 300M cache`. Tres cifras y ninguna sumada con otra.

    La entrada nueva si junta `in` y `cw`: las dos son material que entra al modelo por
    primera vez y la diferencia entre ellas es de facturacion, no de contenido. La cache
    LEIDA no se junta con nada: es lo mismo releido, y en una sesion de ocho horas es cien
    veces mayor que todo lo demas junto. Las cuatro partes siguen enteras en `--json`.
    """
    return _("{i} in · {o} out · {c} cache",
             i=_tok(u["in"] + u["cw"]) or "0", o=_tok(u["out"]) or "0",
             c=_tok(u["cr"]) or "0")


def _uso_ritmo(u):
    """`1.6k/min · 4h working`, o "" si no hay ni un minuto de trabajo medido.

    Lo que separa una sesion que lleva tres horas quemando de una abierta hace tres horas
    y parada hace dos NO es el ritmo —medido sobre diez transcripts, va siempre entre
    1.383 y 2.084 tokens por minuto— sino los minutos activos. Por eso van los dos y los
    minutos mandan.
    """
    if u["activo"] < 60:
        return ""
    # `_tok()` no vale aqui, y es el unico sitio del fichero donde no vale: redondea a
    # miles enteros, y el ritmo medido cae SIEMPRE entre 1.383 y 2.084 tokens por minuto
    # sobre diez transcripts. Con `_tok()` las diez filas dirian "1k/min" — un dato que
    # no distingue nada ocupa sitio y no informa. Un decimal ya las separa.
    r = int(u["out"] / (u["activo"] / 60))
    return _("{r}/min · {t} working",
             r=(f"{r / 1000:.1f}k" if r >= 1000 else str(r)),
             t=_lapso(u["activo"]))


# Lo que corta una frase. El `:` NO esta: "Objetivo: arreglar el login" se quedaria en
# "Objetivo", que es la parte que no dice nada. El punto suelto tampoco vale sin mirar
# lo que sigue, porque `progress/x.md` y `1.9.0` lo llevan dentro.
_FIN_FRASE = re.compile(r"[.?!\u2026](?=\s|$)|[\n\r]")
FRASE_MAX = 60
# Por debajo de esto una "frase" no titula nada ("Hecho.", "Vale.", "Ok.") y se sigue
# con la siguiente. Doce y no veinte: "Arregla el login" son dieciseis caracteres y es
# un titulo perfectamente bueno.
FRASE_MIN = 12


def _primera_frase(t, tope=FRASE_MAX):
    """La primera frase de un prompt, para titular con ella.

    Un prompt entero no es un titulo: los de esta maquina llegan a 1.727 caracteres, y
    cuatro sesiones que empiezan con el mismo encargo salian con el mismo nombre en el
    panel. Se corta por la primera frase, y si esa se queda en nada —"Hecho.", "Vale."—
    se sigue con la siguiente en vez de titular con una palabra.
    """
    t = (t or "").strip()
    if not t:
        return ""
    corte = 0
    while corte < len(t):
        m = _FIN_FRASE.search(t, corte)
        if not m:
            corte = len(t)
            break
        corte = m.start() if m.group().strip() else m.start()
        if corte >= FRASE_MIN:
            break
        corte = m.end()
    frase = t[:corte].strip() or t.strip()
    return (frase[:tope - 1].rstrip() + "\u2026") if len(frase) > tope else frase


def first_user_text(path, minlen=25, tope=FRASE_MAX):
    """Primer mensaje sustancial del usuario, recortado a su primera frase.

    Medido sobre las 8 sesiones del 2026-08-24: el PRIMER mensaje da 8/8 titulos
    reconocibles y el ultimo da basura ('Continua', 'Si procede'), porque una
    conversacion larga acaba en monosilabos. Por eso la fuente es la cabecera.
    """
    for t in _user_texts(_head(path)):
        t = _strip_saludo(t)
        if len(t) >= minlen:
            t = _primera_frase(t, tope)
            return t[:1].upper() + t[1:]
    return None


def last_user_text(path, minlen=40):
    """Ultima instruccion sustancial: no sirve de titulo, si de 'donde se quedo'."""
    found = [t for t in _user_texts(_tail(path)) if len(t) >= minlen]
    if not found:
        try:
            if path.stat().st_size > 512 * 1024:
                found = [t for t in _user_texts(path.read_bytes()) if len(t) >= minlen]
        except OSError:
            pass
    return found[-1] if found else None


def label(e, width=34):
    """Titulo de la pestana. Un -n explicito manda; si no, se deriva del transcript,
    porque el basename del cwd deja 8 pestanas llamadas igual."""
    if e.get("title_explicit"):
        return e["title"]
    t = e.get("_transcript")
    if t:
        txt = first_user_text(t)
        if txt:
            return (txt[: width - 1] + "\u2026") if len(txt) > width else txt
    return e.get("title") or "claude"


def _fecha_corta(epoch):
    if not epoch:
        return "?"
    d = datetime.date.fromtimestamp(epoch)
    hoy = datetime.date.today()
    dias = (hoy - d).days
    if dias <= 0:
        return "hoy"
    if dias == 1:
        return "ayer"
    return d.strftime("%d/%m")


def hook_line(rows, items):
    """Al abrir una terminal, una linea. El menu solo si se pide.

    Antes se volcaba la lista entera y se exigia una decision en cada pestana
    nueva: eso convierte una herramienta util en una interrupcion.
    """
    if rows:
        trab = sum(1 for r in rows if r["working"])
        print("\n  " + _("{n} Claude session(s) open", n=len(rows))
              + (", " + _("{n} working", n=trab) if trab else "")
              + "  \u00b7  " + _("`{p}` to manage them", p=PROG) + "\n")
    elif items:
        print("\n  " + _("{n} Claude session(s) can be resumed", n=len(items))
              + f"  \u00b7  `{PROG}`\n")


# ─────────────────────────── selector visual ───────────────────────────
# Marcas con el espacio lo que quieres cerrar y Enter lo aplica. Sin sintaxis
# que recordar: escribir "C 1-9" obligaba a traducir la intencion a un rango.
INACTIVA = 3600          # a partir de aqui, "lleva parada un rato" y `d` la marca


# U+FE0F, el selector de variacion que pide "pintame como emoji". Va DETRAS del
# caracter al que modifica y vale cero columnas el solo, pero convierte en emoji —dos
# columnas— a un simbolo que por su `east_asian_width` mediria una: `\u26a0` es 'N' y
# `\u26a0\uFE0F` se pinta a dos. Sin mirarlo, cada emoji de esa familia (⚠️ ❤️ ▶️ ☑️,
# los mas frecuentes en ingles tecnico) desplaza la fila una columna a la derecha.
#
# Aviso de alcance: esto NO se observo aqui. Se busco en los 605 titulos de esta
# maquina y en las primeras 60 lineas de 250 transcripts, y no aparece ni uno — pero
# los titulos los escribe el CLI a partir de lo que diga cada cual, y "en mi maquina no
# pasa" no es un argumento en un repo que instala gente que no conozco.
_VS16 = "\ufe0f"


def _columnas(ch, siguiente=""):
    """Columnas de UN caracter, mirando si el de despues lo convierte en emoji."""
    if unicodedata.combining(ch) or unicodedata.category(ch) in ("Mn", "Cf"):
        return 0
    if siguiente == _VS16:
        return 2
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def ancho(s):
    """Columnas que ocupa un texto en pantalla, que no es su len().

    Un emoji vale 2 columnas ('W' en east_asian_width) y descuadra la tabla entera
    si se mide con len(); los titulos de Claude Code los llevan. Se resuelve con
    stdlib, sin depender de `wcwidth`.
    """
    return sum(_columnas(ch, s[i + 1] if i + 1 < len(s) else "")
               for i, ch in enumerate(s))


def recorta(s, cols):
    """Corta a `cols` COLUMNAS (no caracteres) y pone puntos suspensivos si sobra."""
    if ancho(s) <= cols:
        return s
    out, usado = "", 0
    for i, ch in enumerate(s):
        w = _columnas(ch, s[i + 1] if i + 1 < len(s) else "")
        if usado + w > cols - 1:
            break
        out += ch
        usado += w
    return out + "\u2026"


def rellena(s, cols):
    """Padding a la derecha contando columnas reales."""
    return s + " " * max(0, cols - ancho(s))


def _troceado(texto, cols, lineas):
    """Parte un texto en `lineas` renglones de `cols` columnas, sin cortar palabras.

    Si sobra texto, la ultima linea acaba en `\u2026`. La version anterior solo lo
    marcaba cuando la linea cortada llegaba justa al ancho: un resumen de cinco
    renglones que se comia media respuesta se leia como la respuesta entera.
    """
    out, actual, palabras, resto = [], "", texto.split(), 0
    for i, palabra in enumerate(palabras):
        prueba = (actual + " " + palabra).strip()
        if ancho(prueba) > cols:
            out.append(actual)
            actual = palabra
            if len(out) == lineas:
                resto = len(palabras) - i
                break
        else:
            actual = prueba
    if actual and len(out) < lineas:
        out.append(actual)
        actual = ""
    if out and (resto or actual):
        out[-1] = recorta(out[-1] + " \u2026", cols)
    return out


def _lapso(secs):
    """'5m' / '3h' / '2d', sin prefijo. Existe aparte porque el prefijo cambia con el
    idioma y habia sitios recortandolo con `_hace(x)[5:]`: en ingles eso se comia la
    cifra. Un formato que hay que recortar para reutilizarlo esta mal partido."""
    secs = int(secs or 0)
    if secs < 3600:
        return f"{secs // 60}m"
    if secs < 86400:
        return f"{secs // 3600}h"
    return f"{secs // 86400}d"


def _hace(secs):
    """'ahora' / 'hace 5m' / 'hace 3h' / 'hace 2d'. Nunca una fecha: lo que decide
    si una sesion sobra es cuanto lleva quieta, no que dia empezo."""
    if secs is None:
        return "?"
    return _("now") if int(secs) < 90 else _("{t} ago", t=_lapso(secs))


def _fase(r):
    """Que hace la sesion, en una frase, a partir de los hechos del pulso.

    Sale del MISMO `pulso` que pinta la lista: si el panel y el glifo se calcularan
    por separado acabarian contradiciendose delante del usuario.
    """
    pu = r.get("pulso") or {}
    idle = r.get("idle") or 0
    if pu.get("escribe") is None:
        return None
    if pu.get("herramienta"):
        if idle > 10 * 60:
            return _("{t} on the same tool: it may be stuck", t=_lapso(idle))
        return _("waiting on a command of its own")
    if pu.get("escribe") and not pu.get("cerrado"):
        return _("writing its reply")
    return (_("waiting on you") if idle < 6 * INACTIVA
            else _("stopped, waiting on you"))


def _texto_colision(cl):
    """Que comparten las dos sesiones, en una linea. Se compone al pintar y no se
    guarda hecha: el idioma se decide aqui, no cuando se observo el hecho."""
    if not cl:
        return ""
    # Del fichero se ensenan las DOS ultimas partes de la ruta, no la ruta entera: el
    # panel mide unas 48 columnas y un path absoluto se come la linea y sale cortado
    # justo por donde informa, que es el final. `src/webhooks.py` distingue tanto como
    # `/Users/tu/code/checkout-api/src/webhooks.py` y cabe.
    donde = (" · ".join("/".join(f.rsplit("/", 2)[-2:]) for f in cl["ficheros"][:3])
             if cl["ficheros"]
             else _("same folder") if cl["mismo_directorio"] else _("same repo"))
    trozos = [cl.get("titulo") or cl.get("con") or "", donde]
    if cl.get("orden_ancha"):
        trozos.append(_("you are about to run {v} here", v=cl["orden_ancha"])
                      if cl.get("orden_es_mia")
                      else _("{v} in a repo another session is editing",
                             v=cl["orden_ancha"]))
    if cl.get("segundos_desde_la_ultima") is not None:
        trozos.append(_("{n} writes, the last one {t} ago",
                        n=cl["escrituras_recientes"],
                        t=_lapso(cl["segundos_desde_la_ultima"])))
    return " · ".join(x for x in trozos if x)


# El argumento que identifica una llamada cambia por herramienta: de un Bash lo que
# importa es el comando, de un Edit el fichero. Nombre a secas ("Bash") no distingue
# compilar de borrar media carpeta.
_TOOL_ARG = ("command", "file_path", "pattern", "path", "url", "query",
             "description", "prompt", "notebook_path")


def _arg_tool(b):
    """La clave y el valor que identifican una llamada, de un bloque `tool_use`.

    Vive aparte porque la quieren dos: `_resume_tool()` la pinta y el detector de
    choques la interpreta. Sin esto la tabla acabaria copiada arriba, y dos copias
    de la misma tabla se separan sin que nada falle.
    """
    ent = b.get("input") if isinstance(b.get("input"), dict) else {}
    for k in _TOOL_ARG:
        v = ent.get(k)
        if isinstance(v, str) and v.strip():
            return k, v
    return "", ""


def _sin_tabla(t):
    t = re.sub(r"\|?\s*:?-{2,}:?\s*(?=\||$)", "", t)   # la fila de guiones sobra
    t = re.sub(r"\s*\|\s*", " \u00b7 ", t)
    return re.sub(r"(?:\s*\u00b7)+\s*", " \u00b7 ", t).strip(" \u00b7")


def _resume_tool(b):
    """'Bash \u00b7 git push origin main' a partir de un bloque tool_use."""
    nom = b.get("name") or "?"
    _, v = _arg_tool(b)
    return f"{nom} \u00b7 {_clean(v)}" if v else nom


# ────────────────────── el recorrido de una sesion ──────────────────────
# El panel dice lo ULTIMO que hizo la sesion. Lo que no dice es el camino, que es
# donde se ve si avanza o da vueltas: el mismo comando fallando tres veces, un barrido
# de greps que no encuentra nada, una llamada que lleva veinte minutos. Todo eso sale
# de la MISMA cola que `detalles()` ya abre, sin leer un byte de mas.
#
# La frontera: aqui abajo solo se CONSTATA —cuanto duro, si vino marcado como error,
# cuantos caracteres devolvio—. El veredicto lo compone `alertas()` con esos numeros.
# Un hecho que hay que explicar es un hecho mal elegido.

MAX_EVENTOS = 12          # los que se guardan por sesion
RUTA_VISIBLE = 6          # los que se pintan; el resto se cuenta, no se dibuja
RUTA_FIJO = 10            # columnas del glifo + la duracion + sus blancos

# Tres intentos identicos fallidos es donde para una persona, y es el mismo numero que
# el presupuesto de rechazos del revisor: reintentar UNA vez es trabajo normal.
UMBRAL_BUCLE = 3
# El barrido va con dos y no con tres a proposito: un reintento fallido puede ser un
# flake, pero una segunda busqueda que no encuentra nada ya dice que la hipotesis esta
# mal planteada. Y ademas no cuesta nada: buscar es barato, seguir barriendo no.
UMBRAL_BARRIDO = 2

# Herramientas cuyo trabajo es buscar: que no encuentren nada es informacion. Que un
# Read devuelva poco, no lo es.
_BUSCAN = ("Grep", "Glob", "WebSearch", "ToolSearch")
# Y los que llegan dentro de un Bash, que en la practica son la via habitual: medido
# sobre los 12 transcripts mas recientes de esta maquina, 2.788 llamadas a Bash y cero
# a Grep. Mirar solo el nombre de la herramienta dejaria el barrido invisible.
_BUSCAN_SH = ("grep", "egrep", "fgrep", "rg", "ag", "ack", "find", "fd", "locate")
_CODIGO = re.compile(r"^Exit code (\d+)\s*\n?")
# Lo que deja un comando que no devolvio nada. El primero esta medido en los
# transcripts de esta maquina; los otros dos son los de Grep/Glob y NO se han podido
# verificar aqui (cero llamadas a esas dos herramientas en los 120 ultimos
# transcripts), asi que van de refuerzo: quien sostiene la deteccion es el cuerpo de
# cero caracteres, que es lo que deja un grep sin aciertos.
_SIN_NADA = ("(bash completed with no output)", "no files found", "no matches found")


def _cabeza_sh(cmd):
    """El programa que de verdad se ejecuta en un Bash.

    Sin esto `sudo rg foo` figura como `sudo`, `LC_ALL=C grep x` como una asignacion y
    `git grep -l x` como `git`: los tres son busquedas y los tres se perderian.
    """
    for palabra in cmd.split()[:5]:          # 5 tokens sobran: el comando esta ahi
        nombre = palabra.rsplit("/", 1)[-1]
        if "=" in palabra or nombre in ("sudo", "command", "time", "nice", "env", "git"):
            continue
        return nombre
    return ""


def _texto_resultado(b):
    """(cuerpo, codigo_de_salida) de un bloque tool_result.

    El `content` llega como cadena o como lista de trozos, y cuando viene de un Bash
    empieza por `Exit code N`. Ese prefijo se separa en vez de contarlo como cuerpo: si
    no, un `grep` que no encuentra nada devolveria once caracteres en vez de cero y
    pareceria que si encontro algo.
    """
    c = b.get("content")
    if isinstance(c, list):
        c = "".join(x.get("text") or "" for x in c if isinstance(x, dict))
    texto = c if isinstance(c, str) else ""
    m = _CODIGO.match(texto)
    if not m:
        return texto.strip(), None
    return texto[m.end():].strip(), int(m.group(1))


def _evento(bloque, t0):
    """Un evento recien nacido: lo que se sabe con solo ver el `tool_use`."""
    nom = bloque.get("name") or "?"
    ent = bloque.get("input") if isinstance(bloque.get("input"), dict) else {}
    cmd = ent.get("command") if isinstance(ent.get("command"), str) else ""
    return {"nom": nom, "res": _resume_tool(bloque), "t0": t0, "dur": None,
            "pend": True, "err": False, "cod": None, "bytes": 0,
            "busca": nom in _BUSCAN or _cabeza_sh(cmd) in _BUSCAN_SH, "vacio": None}


def recorrido(lineas, tope=MAX_EVENTOS):
    """Las ultimas llamadas a herramienta, en orden, con lo medible de cada una.

    `lineas` son los objetos YA parseados de la cola del transcript: se pasa lo parseado
    y no el fichero para que esto no vuelva a abrirlo ni a decodificarlo.

    El emparejamiento es el MISMO que usa `pulso()` para saber si hay una llamada
    colgando: el `id` de un `tool_use` en un mensaje `assistant` y el `tool_use_id` de
    un `tool_result` en el `user` siguiente, con los `isSidechain` fuera porque son
    subagentes. Alli basta un conjunto y por eso alli sigue siendo un conjunto; aqui
    hace falta la duracion, asi que se guarda el par.
    """
    abiertos, orden = {}, []
    for j in lineas:
        if not isinstance(j, dict) or j.get("isSidechain"):
            continue
        cont = (j.get("message") or {}).get("content")
        if not isinstance(cont, list):
            continue
        t = _iso(j.get("timestamp") or "")
        for b in cont:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "tool_use" and j.get("type") == "assistant":
                bid = b.get("id") or ""
                if bid and bid not in abiertos:
                    abiertos[bid] = _evento(b, t)
                    orden.append(bid)
            elif b.get("type") == "tool_result":
                e = abiertos.get(b.get("tool_use_id") or "")
                if e is None:
                    continue          # su tool_use se quedo fuera de la cola leida
                cuerpo, cod = _texto_resultado(b)
                e["pend"] = False
                e["dur"] = (t - e["t0"]) if (t and e["t0"]) else None
                e["err"] = bool(b.get("is_error"))
                e["cod"] = cod
                e["bytes"] = len(cuerpo)
                if e["busca"]:
                    e["vacio"] = e["bytes"] == 0 or cuerpo.lower() in _SIN_NADA
    return [abiertos[k] for k in orden[-tope:]]


def sintomas(eventos):
    """Cuentas sobre una tanda de eventos. Enteros, ni una frase.

    El veredicto lo compone `alertas()` a partir de esto, asi que no hay forma de que
    un numero de aqui tape al de al lado: se ven los cuatro o no se ve ninguno.
    """
    if not eventos:
        return {"eventos": 0, "repeticiones_consecutivas": 0, "fallos_seguidos": 0,
                "busquedas_sin_resultado": 0, "segundos_en_curso": 0}
    ult = eventos[-1]
    repes = 0
    for e in reversed(eventos):
        if e["res"] != ult["res"]:
            break
        repes += 1
    # Una llamada aun en curso no ha fallado, pero tampoco rompe la racha: al cuarto
    # intento del mismo comando la racha es justo lo que hay que ver, y contar el que
    # esta en vuelo la borraria en el momento en que estas mirandola.
    cerrados = eventos[:-1] if ult["pend"] else eventos
    fallos = 0
    for e in reversed(cerrados):
        if not e["err"]:
            break
        fallos += 1
    vacias = 0
    for e in reversed(cerrados):
        # Cualquier otra cosa por medio corta la racha: dos greps vacios con un Edit
        # en medio no son un barrido, son trabajo.
        if not e["busca"] or not e["vacio"]:
            break
        vacias += 1
    return {"eventos": len(eventos),
            "repeticiones_consecutivas": repes,
            "fallos_seguidos": fallos,
            "busquedas_sin_resultado": vacias,
            "segundos_en_curso": (round(max(0.0, time.time() - ult["t0"]))
                                  if ult["pend"] and ult["t0"] else 0)}


def alertas(s):
    """Los veredictos, compuestos con los numeros de `sintomas()` y con nada mas.

    Devuelve claves de un enum cerrado, no frases: la frase depende del idioma y del
    ancho de la ventana, y quien decide no tiene por que enterarse de ninguna de las
    dos. Lo que lleva veinte minutos corriendo NO sale por aqui: ya lo dice el campo
    `status`, y un dato repetido no es una segunda opinion.
    """
    fuera = []
    if (s["fallos_seguidos"] >= UMBRAL_BUCLE
            and s["repeticiones_consecutivas"] >= UMBRAL_BUCLE):
        fuera.append("bucle")
    if s["busquedas_sin_resultado"] >= UMBRAL_BARRIDO:
        fuera.append("barrido")
    return fuera


# Las claves internas estan en castellano, como el resto del fuente. Lo que sale por
# `--json` no: es una interfaz para scripts de otros y va en ingles, como el resto del
# JSON. Dos nombres para lo mismo suena a deuda, pero la alternativa es que un enum
# publico cambie el dia que alguien renombre una variable interna.
_STUCK_JSON = {"bucle": "loop", "barrido": "sweep"}

# La frase de cada alerta, con su cifra dentro. El enum viaja; la frase se traduce y se
# puede reescribir sin tocar a quien decide.
# La version corta, sin cifras: en una fila de lista no cabe el detalle y el detalle
# ya esta en el panel. `_TEXTO_ALERTA` sigue siendo la larga.
_TEXTO_ATASCO = {
    "bucle": lambda: _("stuck in a loop"),
    "barrido": lambda: _("searching and finding nothing"),
}

_TEXTO_ALERTA = {
    "bucle": lambda s: _("the same command has failed {n} times",
                         n=s["fallos_seguidos"]),
    "barrido": lambda s: _("{n} searches in a row with no result",
                           n=s["busquedas_sin_resultado"]),
}


def _seg(secs):
    """'3s' / '12m' / '2h'. `_lapso()` no vale aqui: empieza en minutos y la mitad de
    las llamadas a una herramienta duran menos de uno — la columna saldria de ceros."""
    secs = int(secs or 0)
    if secs < 60:
        return f"{secs}s"
    if secs < 3600:
        return f"{secs // 60}m"
    return f"{secs // 3600}h"


# El glifo dice el desenlace y no repite el nombre de la herramienta, que va al lado:
# corriendo, error, busqueda sin nada, y hecho sin mas. Los cuatro son de UNA columna
# segun `ancho()` y tambien en pantalla — por eso no hay un simbolo de aviso aqui:
# U+26A0 es de ancho ambiguo, `ancho()` cuenta 1 y muchos terminales pintan 2, y una
# columna de mas en curses no da error: envuelve el sobrante al principio de la fila
# siguiente.
_GLIFO_RUTA = {"pend": ("\u25d0", 7), "err": ("\u2717", 5),
               "vacio": ("\u2205", 2), "ok": ("\u00b7", 4)}


def linea_ruta(e, cols):
    """(glifo, par_de_color, duracion, resumen) de un evento, acotado a `cols` columnas.

    Vive aparte del pintado a proposito: asi el ancho se puede probar sin curses, que es
    donde el caracter huerfano aparece dos filas por debajo del fallo que lo causo. La
    duracion de la llamada en vuelo se calcula AQUI y no en `recorrido()`: `_det` se
    cachea por fila, y una duracion guardada se quedaria congelada.
    """
    clave = ("pend" if e["pend"] else "err" if e["err"]
             else "vacio" if e["vacio"] else "ok")
    glifo, par = _GLIFO_RUTA[clave]
    secs = e["dur"]
    if secs is None and e["pend"] and e["t0"]:
        secs = max(0.0, time.time() - e["t0"])
    return (glifo, par, f"{_seg(secs) if secs is not None else '':>4}",
            recorta(e["res"], max(1, cols - RUTA_FIJO)))


def detalles(r):
    """aiTitle / lastPrompt / rama / peso del transcript, de su cola.

    Se lee SOLO para la fila bajo el cursor: abrir 16 transcripts para pintar una
    lista costaria mas que todo lo demas junto, y 15 de esos datos no se miran.
    """
    if "_det" in r:
        return r["_det"]
    d = {}
    t = (r.get("meta") or {}).get("_transcript")
    if t:
        try:
            d["peso"] = t.stat().st_size
        except OSError:
            pass
        # 100 y no 60: medido sobre los 8 transcripts mas recientes, 60 lineas dan
        # entre 4 y 9 llamadas a herramienta y el recorrido saldria corto; 100 dan
        # entre 6 y 13. `ultimas_lineas` lee en bloques de 256 KB, esto corre para UNA
        # fila —la del cursor— y el coste medido no llega al milisegundo.
        crudos = []
        for raw in ultimas_lineas(t, 100):
            try:
                j = json.loads(raw)
            except Exception:
                continue
            crudos.append(j)
            for k in ("aiTitle", "lastPrompt", "gitBranch", "cwd"):
                if j.get(k):
                    d[k] = j[k]
            # Lo que la sesion dijo y lo que esta ejecutando salen de la MISMA cola
            # que ya se lee: volver a abrir el transcript costaria por fila.
            if j.get("isSidechain") or j.get("type") != "assistant":
                continue
            cont = j.get("message", {}).get("content")
            for b in (cont if isinstance(cont, list) else []):
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text":
                    txt = _sin_tabla(_clean(b.get("text") or ""))
                    if txt:
                        d["resp"] = txt
                elif b.get("type") == "tool_use":
                    d["tool"] = _resume_tool(b)
        # El recorrido sale de la MISMA cola: ni una lectura mas. Lo que se guarda son
        # los doce eventos ya resumidos, NUNCA las lineas crudas — una sola de ellas
        # puede pasar de 96 KB y `_det` se queda pegado a la fila hasta el proximo
        # refresco.
        d["ruta"] = recorrido(crudos)
    d["fase"] = _fase(r)
    r["_det"] = d
    return d


def _mb(x):
    return "?" if x is None else (f"{x/1024:.1f} GB" if x >= 1024 else f"{int(x)} MB")


# El tope de contexto NO viene en el transcript. Comprobado el 2026-08-26 sobre 1.500
# respuestas: `message.model` dice `claude-opus-5` a secas aunque la sesion corra en la
# ventana de un millon, y no hay ningun otro campo que lo publique. Asi que el tope se
# deduce por una cascada de hechos, en este orden, y el ultimo corrige a los demas:
#
#   1. `SERENO_CTX_MAX`, si el usuario lo fija a mano. Manda sobre todo lo demas.
#   2. Lo que dice ESTA sesion, y en este orden: la linea `cost-state` que el CLI
#      escribe al cerrar —su `modelUsage` va indexado por `claude-opus-5[1m]`, CON el
#      sufijo— y, si no la hay, el sufijo en el `message.model` del propio transcript.
#   3. El `model` de `~/.claude/settings.json`. Es de la MAQUINA, no de la sesion.
#   4. Nada de lo anterior: la ventana estandar.
#   5. Y por encima de todo lo de 2-4, una guarda: el tope nunca puede quedar por
#      debajo del contexto YA observado. Si la sesion lleva 560k dentro, su tope no es
#      200k lo diga quien lo diga. Es lo que impide pintar un 207%.
#
# La guarda 5 mira dos cosas: el contexto de AHORA y el PICO que la sesion llego a
# tener. La segunda existe porque compactar borra la prueba: el contexto cae a 16k y
# una sesion de un millon pasa a dibujarse contra la ventana estandar. El pico se
# reconstruye del transcript entero —el `usage` de cada respuesta y el `preTokens` de
# cada compactacion— y ahi si queda. Medido sobre los 524 transcripts de esta maquina,
# corrige 30 (5,7%), y en los 30 hacia el mismo lado: uno marcaba 171k sobre 200k, un
# 86% que pedia compactar cuando eran 171k de un millon, un 17%.
#
# El orden 2 antes que 3 es el que importa y cambio el 2026-08-27: la config global es
# la floja —una sesion lanzada con otro `--model` no la cumple— y mientras iba delante,
# un `cost-state` sin sufijo no podia corregirla. Ahora si: el unico hecho que habla de
# la sesion manda sobre el que habla de la maquina, en los DOS sentidos.
#
# El sentido que baja se apoya en un caso que NO se ha observado en esta maquina: de los
# 15 transcripts con `cost-state`, los 11 que nombran un modelo principal lo nombran con
# sufijo, y los otros 4 traen `modelUsage` vacio. La guarda 5 acota lo que puede salir
# mal: bajar por debajo de lo ya gastado es imposible.
CTX_1M = 1_000_000
CTX_STD = 200_000


def _ctx_max_env():
    """El tope que el usuario fija a mano en `SERENO_CTX_MAX`, o None."""
    if "_v" not in _ctx_max_env.__dict__:
        forzado = _env("CTX_MAX")
        _ctx_max_env._v = int(forzado) if forzado.isdigit() else None
    return _ctx_max_env._v


def _ctx_max_config():
    """El tope que dicta la configuracion de la MAQUINA, o None. Una vez por proceso.

    Sigue existiendo como funcion aparte porque su sitio en la cascada es lo que se
    discute: es config global, y una sesion lanzada con otro `--model` no la cumple.
    """
    if "_v" not in _ctx_max_config.__dict__:
        v = _ctx_max_env()
        if v is None and not DEMO:
            try:
                cfg = json.loads((HOME / ".claude/settings.json").read_text("utf-8"))
                if "[1m]" in str(cfg.get("model", "")).lower():
                    v = CTX_1M
            except Exception:
                pass
        _ctx_max_config._v = v
    return _ctx_max_config._v


def tope_contexto(modelo, ctx=0, ventana_1m=None, pico=0):
    forzado = _ctx_max_env()
    if forzado:
        return forzado                    # lo pusiste tu: no se discute
    # Lo que dice ESTA sesion, en los dos sentidos. `None` es "no se midio" y no decide
    # nada; `False` si decide, y es lo que permite bajar de un millon a la estandar.
    if ventana_1m is not None:
        tope = CTX_1M if ventana_1m else CTX_STD
    elif "[1m]" in (modelo or "").lower():
        tope = CTX_1M
    else:
        tope = _ctx_max_config() or CTX_STD        # la maquina, que es la floja
    # Y la guarda, que corrige a todas: una sesion con 560k dentro no tiene un tope de
    # 200k lo diga quien lo diga. Sin esto, dejar que `cost-state` baje el tope podria
    # pintar un 280%. `pico` es lo mismo con memoria: lo que la sesion llego a tener
    # antes de compactar, que es cuando el dato de ahora deja de delatarla. Es 0
    # mientras nadie haya leido el transcript entero, y 0 no decide nada.
    return CTX_1M if max(ctx or 0, pico or 0) > tope else tope


def _tok(n):
    if not n:
        return ""
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M".replace(".0M", "M")
    return f"{n // 1000}k" if n >= 1000 else str(n)


def _modelo_corto(m):
    """`claude-opus-5[1m]` -> `opus-5[1m]`. Sin el prefijo, que es el mismo en todos."""
    return re.sub(r"^claude-", "", m or "")


def color_contexto(lleno):
    """3=cian(holgado), 7=naranja(ya conviene mirarlo), 5=rojo(toca compactar)."""
    return 5 if lleno > 0.85 else 7 if lleno > 0.6 else 3


def _celdas(valor, tope, celdas=5):
    """Cuantas celdas de la barra ocupa `valor`. Sale aparte porque la quieren dos
    medidas de la MISMA barra —lo que hay ahora y lo que llego a haber— y si cada una
    redondeara por su cuenta, la segunda podria quedar por debajo de la primera.

    El minimo de una celda es a proposito: un hilo de contexto que redondea a cero
    desaparece de la barra y la sesion parece sin estrenar.
    """
    if not valor or not tope:
        return 0
    return max(1, min(celdas, round(celdas * valor / tope)))


def barra(valor, tope, celdas=5, pico=0):
    """Barra de bloques unicode. Una cifra sola no se compara de un vistazo; cinco
    celdas si: se ve de golpe cual es la sesion que se esta comiendo la maquina.

    `pico` es lo que la sesion llego a tener antes de compactar, y se pinta LLENO
    igual que lo de ahora. La diferencia entre "lo tiene" y "lo tuvo" la lleva el
    color, no el glifo: quien pinta esto apaga el pico si el terminal no da color
    (`_celdas` no decide nada de eso), porque una barra mas llena sin nada que lo
    matice miente hacia arriba.
    """
    if not valor or not tope:
        return " " * celdas
    llenas = _celdas(valor, tope, celdas)
    hasta = max(llenas, _celdas(pico, tope, celdas))
    # Segmentos (U+25B0/25B1) y no bloques llenos: `█` pinta un rectangulo macizo
    # que a tamaño de terminal parece una mancha de color, no una barra.
    return "\u25b0" * hasta + "\u25b1" * (celdas - hasta)


COL_BASE = 3 + 3 + 9 + 1   # margen+canal+margen, estado+choque, tiempo, marca adjunta
COL_CLI = 2                # el glifo del CLI y su blanco, solo cuando la lista mezcla
COL_CTX = 10              # barra de 5 celdas + " 88%"
COL_RAM = 8               # "  1.6 GB" + el blanco que la separa de la marca
COL_SEP = 3               # los dos blancos del titulo + el relleno del proyecto
T_COMODO = 44             # mas titulo que esto aporta menos que otra columna
P_MINIMO = 12             # por debajo, el nombre del proyecto ya no se reconoce


def reparto(hueco, largo, ancho_p, hay_ctx, hay_ram, mezcla=False):
    """Que columnas caben en `hueco` y cuanto mide cada una.

    Dos reglas, y la segunda no es cosmetica.

    **El titulo cobra primero.** Es la IDENTIDAD de la sesion. Antes se repartia al
    reves —las columnas de apoyo pedian lo suyo y el titulo se quedaba el resto— y a
    70 columnas la lista mostraba un "Refactor pa..." al lado de un "checkout-api"
    con su rama entera: recortaba lo unico que distingue una fila para conservar un
    dato que se repite en todas y que ademas sale entero en el panel.

    **Ensanchar la ventana no puede estrechar ninguna columna.** Al probarlo salio
    que si: a 56 columnas el proyecto no cabia y el titulo se quedaba 31; a 70 el
    proyecto volvia y el titulo bajaba a 26. Redimensionar encogia la fila. Por eso
    el titulo tiene un techo (`T_COMODO`) y las columnas se encienden en orden fijo
    **parando en la primera que no entra**: asi cada una tiene un umbral propio y,
    una vez encendida, ya no se apaga al seguir ensanchando.

    El orden de encendido, de la que mas aporta a la que menos:

      1. contexto -- el unico dato de la fila que no esta en ningun otro sitio;
      2. proyecto -- se estrecha con la ventana, y por debajo de 12 se va;
      3. RAM -- la repite el panel y solo la sabe quien corra bajo tmux.

    Una columna sin nada que decir vale 0 desde el principio: quien no use tmux no
    paga 8 columnas de blanco en cada fila.
    """
    # Con la lista mezclada, cada fila paga el glifo de su CLI.
    base = COL_BASE + (COL_CLI if mezcla else 0)
    t = max(12, min(largo, T_COMODO, hueco - base))
    sobra = hueco - base - t
    an_ctx = an_ram = 0

    if hay_ctx and sobra >= COL_CTX:
        an_ctx, sobra = COL_CTX, sobra - COL_CTX
    elif hay_ctx:
        return t, 0, 0, 0, base

    if ancho_p:
        cabe = sobra - COL_SEP
        if cabe < P_MINIMO:            # un proyecto a 8 columnas no dice nada
            # Se corta aqui y la RAM no se enciende aunque quepa: encenderla ahora
            # significaria apagarla al ensanchar, cuando el proyecto reclamase ese
            # hueco. Cuesta unas columnas en blanco en una franja estrecha de
            # anchos, y a cambio redimensionar nunca quita nada de la fila.
            return t, 0, an_ctx, 0, base + an_ctx
        # Se ESTRECHA con la ventana en vez de saltar de 30 a nada. Y encoger el
        # proyecto no puede encender la RAM: `sobra` solo crece cuando el proyecto ya
        # esta a su ancho natural, que es lo que mantiene el reparto monotono.
        ancho_p = min(ancho_p, cabe)
        sobra = cabe - ancho_p

    if hay_ram and sobra >= COL_RAM:
        an_ram = COL_RAM

    return (t, ancho_p, an_ctx, an_ram,
            base + an_ctx + an_ram + (ancho_p + COL_SEP if ancho_p else 0))


def aguja(valor, tope):
    """La misma idea que `barra` en UNA columna, por altura del bloque.

    Dos barras de cinco celdas pegadas compiten y no gana ninguna: la de contexto y la
    de RAM se leian como una sola cosa repetida. La RAM se conforma con esto —comparar
    de un vistazo quien se come la maquina— y le deja las cinco celdas al contexto, que
    es el dato que hay que leer con precision."""
    if not valor or not tope:
        return " "
    return "\u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588"[
        max(0, min(7, round(7 * valor / tope)))]


def color_tiempo(idle):
    """5=rojo(nada), 9=verde recien, 6=azul hace poco, 4=gris lleva rato."""
    if idle is None:
        return 4
    if idle < 90:
        return 9
    if idle < INACTIVA:
        return 6
    return 7 if idle < 6 * INACTIVA else 4


# ──────────────────── orden y filtro de la lista ───────────────────
# Los dos viven FUERA de `pick_ui` y sin tocar curses a proposito: son las dos reglas
# que deciden que fila ve el usuario y en que sitio, y dentro del bucle de pintado no
# habia forma de comprobarlas sin arrancar un pty. Mismo motivo que `reparto()`.

MODOS_ORDEN = ("activity", "context", "project", "memory", "spend")


def modo_orden_inicial():
    """`SERENO_SORT=context` o `-context` (invertido). Devuelve (modo, invertido).

    Es una variable de entorno y no un fichero de preferencias a proposito: sereno no
    tiene fichero de configuracion y esa es una propiedad que se anuncia en el README y
    en SECURITY.md. Un orden guardado en el perfil del shell lo ha escrito el usuario y
    lo puede leer; uno guardado por el programa, ni una cosa ni la otra.
    """
    v = _env("SORT").strip().lower()
    inv = v.startswith("-")
    v = v.lstrip("-")
    return (v if v in MODOS_ORDEN else MODOS_ORDEN[0]), (inv and v in MODOS_ORDEN)


def etiqueta_orden(modo):
    """El nombre traducido de un modo. Existe porque `_(modo)` seria una clave DINAMICA:
    `tests/test_i18n.py` recorre el AST buscando `_("literal")`, no la veria pasar y
    daria las cuatro traducciones por huerfanas. Con literales el test las sigue
    vigilando, que es justo lo que se quiere de una tabla de idiomas."""
    return {"activity": _("activity"), "context": _("context"),
            "project": _("project"), "memory": _("memory"),
            "spend": _("spend")}.get(modo, modo)


def _plano(s):
    """Minusculas y sin tildes, para comparar. `sesion` tiene que encontrar `sesi\u00f3n`:
    los titulos que escribe Claude llevan acentos y el usuario que filtra, no."""
    return "".join(c for c in unicodedata.normalize("NFD", str(s or "").lower())
                   if not unicodedata.combining(c))


def casa(r, filtro):
    """Que campos mira el filtro de `/`.

    Hasta ahora solo el titulo, y eso hacia que teclear el nombre de un proyecto que SI
    esta en pantalla —y en dos filas— devolviera "(nada coincide)". Se miran los cuatro
    datos que identifican una sesion y que ademas se ven: titulo, proyecto, rama e id.

    El ESTADO se queda fuera, y no por olvido: `_fase()` devuelve una frase traducida,
    asi que filtrar por ella daria resultados distintos en ingles y en castellano.
    """
    if not filtro:
        return True
    a = _plano(filtro)
    return any(a in _plano(c) for c in (r.get("title_full"), r.get("proyecto"),
                                        r.get("rama"), r.get("name")))


def _ausente(r, modo):
    """1 si esta fila no tiene el dato por el que se ordena.

    Va aparte de la clave y se aplica en su propia pasada porque un dato que no consta
    tiene que caer al final SIEMPRE, tambien al invertir. Tratarlo como 0 pondria las
    sesiones sin contexto las primeras en cuanto pulsas `S`, que es la lectura al reves:
    un hueco no es un cero.
    """
    if modo == "context":
        return 0 if (r.get("pulso") or {}).get("ctx") else 1
    if modo == "project":
        return 0 if (r.get("proyecto") or "") else 1
    if modo == "memory":
        return 0 if r.get("mem_mb") else 1
    if modo == "spend":
        # `_uso` es None en las filas de otro CLI, que no tienen transcript, y en el
        # transcript que no se pudo leer entero. Las dos son huecos, no ceros. Y un
        # PARCIAL tambien: ordenar por una cifra a medias pondria delante a la que mas
        # se ha leido, no a la que mas ha gastado. Sube al fondo mientras carga y se
        # coloca cuando termina — una sola vez, asi que la lista no tiembla.
        u = r.get("_uso") or {}
        return 0 if (u.get("turnos") and u.get("completo")) else 1
    return 1 if r.get("idle") is None else 0


def _clave_orden(r, modo):
    """La clave principal. Cada modo apunta por defecto al extremo ACCIONABLE, que no es
    el mismo para todos: de la actividad interesa lo que se movio hace un momento, y del
    contexto y de la RAM lo que esta arriba del todo."""
    if modo == "context":
        # Por FRACCION del tope, no por tokens: 402k en una ventana de un millon esta
        # mas vacia que 93k en una de 200k, y lo que decide si toca compactar es la
        # fraccion. Ordenar por tokens crudos pondria la holgada delante de la llena.
        pu = r.get("pulso") or {}
        ctx = pu.get("ctx") or 0
        return -(ctx / tope_contexto(pu.get("modelo"), ctx, pu.get("ventana_1m"),
                                     pico_de(r)))
    if modo == "project":
        return ((r.get("proyecto") or "").lower(), (r.get("rama") or "").lower(),
                r.get("idle") or 0)
    if modo == "spend":
        # Entrada nueva mas salida, y la cache LEIDA fuera, por lo mismo que ya explica
        # `_uso_texto`: es material releido y es cien veces mayor que todo lo demas.
        # Cual de las tres se elija da bastante igual: medidos los 40 transcripts de
        # esta maquina, `out`, `in+cw+out` y `cr` correlacionan rho >= 0,98 entre si y
        # comparten el top-5, asi que se toma la que se explica en una linea.
        u = r.get("_uso") or {}
        return -((u.get("in") or 0) + (u.get("cw") or 0) + (u.get("out") or 0))
    if modo == "memory":
        return -(r.get("mem_mb") or 0)
    return r.get("idle") or 0


def vacia(r):
    """1 si la sesion nunca recibio una respuesta. No hay nada a lo que volver.

    El hecho es que NINGUNA respuesta consumio un token. `pico` es el mayor contexto que
    la sesion llego a tener, asi que un 0 solo sale de cero respuestas de verdad — y solo
    se mira con el transcript leido ENTERO: a medias, 0 significa "todavia no se sabe", no
    "no hay nada". Un dato ausente no es un dato bueno.

    En esta maquina son 21 de 39 filas del historial, y 16 de ellas son la misma: sesiones
    que arrancaron y murieron en el acto con `API Error: 401 · Please run /login`, cero
    tokens. Sin esto, mas de la mitad de la lista de "a cual vuelvo" son sesiones a las que
    no se puede volver.

    **Las vivas no se marcan nunca**, aunque esten a cero. Una que acabas de lanzar todavia
    no ha contestado y es justo la que quieres arriba: medido, habia una con 23 segundos de
    vida que esta guarda salva.
    """
    if r.get("fuente", "claude") != "historial":
        return 0
    u = r.get("_uso") or {}
    return 1 if (u.get("completo") and not u.get("pico")) else 0


def sin_sitio(r):
    """1 si el directorio de trabajo de esa sesion ya no existe.

    Es la gemela de `vacia()` y responde a la misma pregunta —¿se puede volver aqui?—
    por el otro lado: aquella son sesiones que nunca contestaron, estas contestaron de
    sobra pero reanudarlas te deja en un `cd` a un sitio que no esta.

    En la maquina donde se escribio esto son **40 de las 46 filas** del historial. Y no
    es un espejismo de una tarde rara: quitando las 53 sesiones que un optimizador dejo
    esa manana, siguen siendo **28 de 37**, de dos clases muy concretas — worktrees ya
    borradas (10 de 15) y directorios temporales (18 de 18, todos).

    **Las vivas no se marcan nunca**, igual que en `vacia()`: su proceso esta corriendo
    dentro de ese directorio, asi que existe por definicion.

    No se ocultan, se hunden. Un directorio que hoy no esta puede ser una worktree que
    vuelvas a crear o un disco que vuelvas a montar, y el TTL de `hay_sitio()` hace que
    la fila reviva sola. Esconderlas seria cambiar un error por el contrario.
    """
    if r.get("fuente", "claude") != "historial":
        return 0
    return 0 if r.get("_sitio", True) else 1


def ordena(rows, modo="activity", invertido=False):
    """Ordena la lista. Pura: ni pinta, ni lee el reloj, ni toca disco.

    Por eso el modo `spend` lee el campo `_uso` que ya este en la fila y no lo va a
    buscar: quien llama pasa antes por `avanza_uso()`. Sin esa llamada, `spend` no
    revienta —trata las filas como huecos y las deja donde estaban—, que es la forma
    correcta de fallar en una funcion que se llama cuatro veces por segundo.

    Tres pasadas y no una clave compuesta, aprovechando que `sort` es estable:

      1. el NOMBRE, que es el desempate. Va primero y aparte porque el orden principal
         se invierte y el desempate no debe invertirse con el: la lista se repinta sola
         cada 2,5 s y dos filas empatadas que se intercambian en cada refresco se leen
         como parpadeo.
      2. el orden principal del modo, que si respeta `invertido`.
      3. los huecos al fondo, en las dos direcciones.
      4. debajo de los huecos, las que ya no tienen sitio al que volver.
      5. y debajo de todo, las que nunca arrancaron. Un hueco es una sesion real cuyo
         dato no consta; una sin sitio tiene el dato pero no el destino; una vacia no
         tiene nada. Las dos ultimas pasadas van al final y por eso mandan sobre el
         resto, y en ese orden: no tener nada es peor que no tener donde.
    """
    if modo not in MODOS_ORDEN:
        modo = MODOS_ORDEN[0]
    out = sorted(rows, key=lambda r: r.get("name") or "")
    out.sort(key=lambda r: _clave_orden(r, modo), reverse=invertido)
    out.sort(key=lambda r: _ausente(r, modo))
    out.sort(key=sin_sitio)
    out.sort(key=vacia)
    return out


def copia_al_portapapeles(texto):
    """Pide al TERMINAL que copie, con OSC 52. No lanza ningun programa.

    La alternativa era `pbcopy` en macOS y `xclip`/`wl-copy` en Linux: tres binarios
    nuevos en `PERMITIDOS` de `tests/test_sin_red.py` y tres lineas mas en el "Runs" de
    SECURITY.md, a cambio de un atajo de comodidad. OSC 52 es una secuencia de escape
    —la escribe el proceso y la atiende el emulador— asi que no anade ni un binario, y
    ademas funciona por SSH, que `pbcopy` no.

    Devuelve si se pudo ESCRIBIR, que no es lo mismo que "el portapapeles tiene el
    texto": Terminal.app ignora OSC 52 y tmux solo la reenvia con `set-clipboard on`.
    Por eso quien llama ensena ademas el id en el aviso.
    """
    try:
        b64 = base64.b64encode(texto.encode("utf-8")).decode("ascii")
        sys.stdout.write("\033]52;c;" + b64 + "\a")
        sys.stdout.flush()
        return True
    except Exception:
        return False


def campos_panel(r, d, cwd_cur, ahora=None):
    """Los pares etiqueta/valor del panel lateral, en orden y ya filtrados.

    Cada campo es `(etiqueta, valor, par_de_color)` y, en los dos que se pueden copiar
    al pincharlos, un cuarto elemento con lo que se pega — que NO es lo que se pinta.
    Se pintan con la etiqueta a la izquierda y el valor a la derecha: con 70 columnas de
    panel, una lista de valores sueltos no se lee, no se sabe que es cada cosa. Cuesta
    10 columnas y las hay de sobra.
    Los que salen vacios no llegan: un panel con cinco etiquetas en blanco no dice que
    no haya dato, parece roto.

    Se saco de `pick_ui` porque son sesenta lineas de decisiones —cuando el contexto se
    pinta en rojo, que se ensena mientras el acumulado se lee a medias, que id sirve
    para `--resume`— que solo se podian comprobar arrancando curses.
    """
    ahora = time.time() if ahora is None else ahora
    fu = r.get("fuente", "claude")
    pu_cur = r.get("pulso") or {}
    ctx_cur = pu_cur.get("ctx")
    # Lo que `avanza_uso()` haya leido ya, sin ir a buscar mas: aqui no se
    # abre ningun fichero, que es lo que quitaba 120 ms cada vez que el
    # cursor llegaba a una sesion grande. Lo que falte llega en la vuelta
    # siguiente. El pico si se usa aunque el acumulado este a medias: solo
    # puede crecer, asi que un parcial se queda corto pero nunca miente.
    uso_cur = r.get("_uso")
    listo_cur = bool(uso_cur and uso_cur.get("completo"))
    tope_cur = tope_contexto(pu_cur.get("modelo"), ctx_cur,
                             pu_cur.get("ventana_1m"), pico_de(r))
    campos = [
        (_("status"), d.get("fase") or "", 9 if (d.get("fase") or "").startswith("te espera")
         else 7 if (d.get("fase") or "").startswith(("esperando", "escribiendo", "lleva")) else 4),
        # El cuarto elemento es lo que se copia al pinchar, y aqui NO es
        # lo que se pinta: la etiqueta ensena el nombre corto del proyecto
        # y la rama, pero lo que se pega en una terminal es la ruta entera.
        # En las 40 sesiones del historial de esta maquina la ruta completa
        # no se ve ni una vez, asi que un clic que copiara lo pintado
        # copiaria justo lo que ya se estaba leyendo.
        (_("project"), " \u00b7 ".join(x for x in (r.get("proyecto"),
                                                   r.get("rama")) if x), 8,
         cwd_cur or None),
        (_("open for"), _lapso(max(0, ahora - r["created"]))
         if r.get("created") else "", 4),
        (_("memory"), _mb(r["mem_mb"]) if r["mem_mb"] else "", 8),
        # El porcentaje va con las cifras al lado: la barra de la lista
        # dice "va justa", pero para decidir si compactar hace falta saber
        # si el tope son 200k o un millon.
        # Las compactaciones van PEGADAS al porcentaje porque son lo que lo
        # explica: una sesion de doce horas marcando 20% no es una sesion
        # fresca, es una que ha tirado el contexto tres veces. Leer el numero
        # sin el dato de al lado lleva a la conclusion contraria.
        (_("context"), (f"{_tok(ctx_cur)} / {_tok(tope_cur)}  "
                        f"{round(100 * ctx_cur / tope_cur)}%"
                        + ("  \u00b7 " + _("{n} compaction(s)",
                                          n=uso_cur["compacta"])
                           if listo_cur and uso_cur["compacta"] else ""))
         if ctx_cur else "", color_contexto(ctx_cur / tope_cur if ctx_cur else 0)),
        (_("model"), _modelo_corto(pu_cur.get("modelo")), 4),
        # Mientras se lee, un guion y no una cifra: media lectura da media
        # cifra, y una cifra a medias en una columna que dice "gastado" se
        # lee como el total. Dura una vuelta o dos.
        (_("spent"), _uso_texto(uso_cur) if listo_cur
         else (_("reading\u2026") if uso_cur else ""), 8),
        (_("rhythm"), _uso_ritmo(uso_cur) if listo_cur else "", 4),
        (_("history"), f"{max(1, (d.get('peso') or 0) // 1024 // 1024)} MB"
         if d.get("peso") else
         ("" if fu != "claude" else _("NO TRANSCRIPT: not recoverable")), 5),
        # El id de la SESION, no la clave de la fila: en una viva esta era
        # el nombre de tmux, que no sirve para `claude --resume`.
        (_("session"), id_sesion(r) or r["name"], 4,
         id_sesion(r) or r["name"]),
    ]
    if fu != "claude":
        campos.insert(0, (_("source"),
                          _("{f} \u00b7 ENTER resumes it",
                            f=etiqueta_fuente(fu)), 7))
    return [c for c in campos if c[1]]


def bloques_panel(r, d, ult, hay_ruta):
    """Los bloques de texto del panel, en el orden en que se leen, ya sin los vacios.

    Cada uno es `(cabecera, texto, par, tope_de_lineas, copiable)`. El quinto dice si
    la cabecera copia su texto al pincharla: solo el prompt y la respuesta, que son los
    dos que uno vuelve a usar en otro sitio y ademas los unicos que se pintan
    RECORTADOS —medido en las 40 sesiones del historial, 15 de 37 respuestas no caben—,
    asi que el clic no repite lo que se ve, rescata lo que no cabe. El choque y la
    llamada en curso se leen y se acabo.

    El orden no es cosmetico. El choque va ARRIBA del todo, por delante de lo que la
    sesion esta haciendo: si dos escriben en el mismo fichero, eso es lo primero que hay
    que leer del panel, no el ultimo prompt. Y "ahora mismo" solo aparece cuando el
    recorrido NO cabe: el recorrido ensena esa misma llamada con su duracion en vivo, y
    de los dos dibujos del mismo hecho se queda el que ademas trae el camino.
    """
    cl = r.get("colision")
    return [b for b in (
        ((_("\u25b8 another session is writing here too"),
          _texto_colision(cl), 5, 3, False) if cl else None),
        ((_("\u25b8 right now"), d.get("tool"), 7, 2, False)
         if (not hay_ruta and (r.get("pulso") or {}).get("herramienta"))
         else None),
        (_("\u25b8 what you last said"), ult, 6, 4, True),
        (_("\u25b8 what it last replied"), d.get("resp"), 9, 5, True),
    ) if b and b[1]]


def reparto_panel(fila0, fondo, n_campos, bloques, n_ruta_total, n_alertas,
                  ancho_det, hay_ruta):
    """Donde empieza cada zona del panel lateral, y cuantas lineas se lleva cada bloque.

    Devuelve `(base_campos, base_ruta, n_ruta, hay_ruta, cuotas)`. Es la aritmetica que
    decide QUE SE VE: si el recorrido cabe, cuantos de sus pasos entran, y cuanto texto
    del prompt y de la respuesta sobrevive al recorte. Estaba dentro de `pick_ui` y por
    tanto solo se podia comprobar arrancando curses en un pseudo-terminal — que dice si
    el programa pinta, no si repartio bien.

    `bloques` son los `(etiqueta, texto, par, tope, copiable)` que ya se sabe que tienen
    texto; de cada uno solo se miran aqui el texto y su tope de lineas.
    """
    # Los metadatos se anclan ABAJO y el texto fluye desde arriba: asi las etiquetas
    # caen siempre en la misma linea y el ojo no las persigue cuando el prompt de la
    # sesion de al lado ocupa el doble. Sin texto arriba (las sesiones de otros CLI no
    # traen prompt) anclar abajo dejaria veinte lineas en blanco y tres etiquetas al
    # fondo.
    base_campos = (max(fila0 + 2, fondo - n_campos + 1)
                   if (bloques or hay_ruta) else fila0)
    # El recorrido se reserva su sitio ANTES de repartir el texto: cuando falta altura
    # lo que cede es la respuesta —que sigue entera dentro de la sesion— y no la unica
    # vista que dice donde se atasco. Y si la ventana es baja encoge por el extremo
    # VIEJO antes de desaparecer: dos filas del camino informan mas que ninguna, y la
    # que importa se queda.
    n_ruta = 0
    if hay_ruta:
        margen = 2 if bloques else 0
        sitio = base_campos - fila0 - 2 - n_alertas - margen
        n_ruta = max(0, min(RUTA_VISIBLE, n_ruta_total, sitio))
        hay_ruta = n_ruta > 0
    alto_ruta = (2 + n_alertas + n_ruta) if hay_ruta else 0
    base_ruta = base_campos - alto_ruta
    # Tope por bloque, y reparto proporcional solo si no caben: sin tope, una respuesta
    # con tabla se comia veinte lineas y tapaba el prompt.
    libre = max(0, base_ruta - fila0 - 1 - 2 * len(bloques))
    pide = [min(tope, max(1, -(-ancho(t) // max(1, ancho_det))))
            for _e, t, _p, tope, _c in bloques]
    total = sum(pide)
    cuotas = [q if total <= libre
              else max(1, min(q, round(libre * q / max(1, total))))
              for q in pide]
    return base_campos, base_ruta, n_ruta, hay_ruta, cuotas


def pick_ui(rows, muertas=False, ejecutar=None, recargar=None, vista_inicial="claude"):
    """Devuelve ('close'|'reopen', [filas]) o None si no se pudo pintar/se salio.

    `muertas=True` es la rama de despues de un apagon: mismas teclas, otras
    palabras — ahi no se cierra un proceso, se descarta una entrada del registro.

    `recargar() -> filas` refresca sola cada pocos segundos: una lista de sesiones es
    un panel de estado, y una foto fija miente en cuanto una empieza a trabajar.

    `ejecutar(verbo, seleccion) -> (aviso, filas_nuevas)` hace el trabajo SIN salir
    del selector: cerrar o reabrir no deberian echarte de la herramienta, igual que
    no te echan de lazygit. Si no se pasa, se devuelve la accion y decide quien llame.
    """
    try:
        import curses
    except ImportError:
        return None

    res = {"out": None, "toco": False}
    # La pestana de arranque no siempre es "claude": una busqueda devuelve sobre todo
    # sesiones del historial, y abrirla en la pestana de las vivas ensenaba "(nothing
    # matches)" con los resultados escritos justo encima.
    vista = vista_inicial

    def run(stdscr):
        # `rows` se reasigna aqui dentro (filtro/vista), asi que sin nonlocal Python
        # la trataria como local y `todas = list(rows)` explotaria antes de nacer.
        nonlocal vista, rows
        curses.curs_set(0)
        stdscr.keypad(True)
        # Sin esto, lo que hubiera en la terminal antes de arrancar sobrevive en las
        # celdas que curses cree ya vacias: en la grabacion quedaba una letra suelta
        # del comando anterior flotando bajo la lista.
        stdscr.clearok(True)
        color, foco_bg = False, False
        try:
            curses.start_color()
            curses.use_default_colors()
            hay256 = curses.COLORS >= 256
            curses.init_pair(1, curses.COLOR_GREEN, -1)    # trabajando ahora
            curses.init_pair(2, curses.COLOR_YELLOW, -1)   # marcada para cerrar
            curses.init_pair(3, curses.COLOR_CYAN, -1)     # cabecera y pestanas
            curses.init_pair(4, 244 if hay256 else curses.COLOR_WHITE, -1)
            curses.init_pair(5, curses.COLOR_RED, -1)      # sin transcript: irrecuperable
            curses.init_pair(6, 39 if hay256 else curses.COLOR_CYAN, -1)     # azul vivo
            curses.init_pair(7, 208 if hay256 else curses.COLOR_YELLOW, -1)  # naranja
            curses.init_pair(8, 141 if hay256 else curses.COLOR_MAGENTA, -1) # violeta
            curses.init_pair(9, 84 if hay256 else curses.COLOR_GREEN, -1)    # verde menta
            # gris 244 explicito y no A_DIM: hay terminales que ignoran A_DIM y
            # entonces "en espera" y "trabajando" acaban del mismo color.
            color = True
            # Pares 10..19: LA MISMA paleta, un punto mas viva, sobre gris 236. La
            # fila bajo el cursor se pinta con estos y no con A_REVERSE: el reverse
            # la convertia en un bloque blanco y borraba el color de cada columna
            # (estado, proyecto, tiempo, RAM) justo en la unica fila que estas
            # mirando. Cambiar el FONDO marca la fila sin tirar la informacion.
            if hay256 and curses.COLOR_PAIRS >= 30:
                for par, fg in enumerate((253, 41, 220, 45, 250, 203, 39, 214, 147, 84)):
                    curses.init_pair(10 + par, fg, 238)      # fila bajo el cursor
                # El hover NO puede parecerse al foco o dejan de distinguirse: 234 es
                # casi el negro del terminal, lo justo para decir "el raton esta aqui".
                for par, fg in enumerate((-1, curses.COLOR_GREEN, curses.COLOR_YELLOW,
                                          curses.COLOR_CYAN, 244, curses.COLOR_RED,
                                          39, 208, 141, 84)):
                    curses.init_pair(20 + par, fg, 234)
                foco_bg = True
        except curses.error:
            pass
        C = (lambda n: curses.color_pair(n)) if color else (lambda n: 0)
        # Sin 256 colores no hay fondo que valga: ahi el reverse sigue siendo lo unico
        # que se ve, y feo se lee mejor que invisible.
        CF = ((lambda n: curses.color_pair(10 + n)) if foco_bg
              else (lambda n: curses.A_REVERSE))
        CH = ((lambda n: curses.color_pair(20 + n)) if foco_bg
              else (lambda n: 0))

        # ── raton ──
        # `mouseinterval(0)` desactiva la espera con la que ncurses agrupa clicks: sin
        # el, cada click simple arrastraria 200 ms de latencia para poder decidir si
        # era doble. El doble se detecta aqui con dos marcas de tiempo y sale gratis.
        raton = False
        try:
            disponible, _antes = curses.mousemask(curses.ALL_MOUSE_EVENTS
                                             | curses.REPORT_MOUSE_POSITION)
            raton = bool(disponible)
            curses.mouseinterval(0)
        except curses.error:
            pass
        if raton:
            # 1006 (SGR) y 1003 (todo movimiento). El 1006 no es un lujo: el protocolo
            # viejo mete la columna en UN byte y muere en la 223, asi que en una ventana
            # ancha los clicks del panel derecho llegan a otra parte.
            res["ratón"] = True
            sys.stdout.write("\033[?1006h\033[?1003h")
            sys.stdout.flush()
        espera = 2500 if recargar else -1

        def leer_sgr(win, restaurar=None):
            """Parsea `CSI < boton ; x ; y M|m` a mano -> (boton, x, y, pulsado).

            El ncurses que trae macOS es el 6.0 de 2015 y solo conoce el raton x11 de
            `kmous=\\E[M`: medido en esta maquina, un evento SGR le llega como teclas
            sueltas (27, 91, 60, 48...) y se pierde entero. El terminal SI habla SGR,
            asi que se pide y se parsea aqui. Con un ncurses moderno esto ni se ejecuta:
            el evento sale por KEY_MOUSE antes de llegar.
            """
            win.timeout(30)          # la secuencia viaja de una pieza; 30 ms sobran
            try:
                k = win.getch()
                if k != ord("["):
                    if k != -1:
                        curses.ungetch(k)
                    return None
                if win.getch() != ord("<"):
                    return None
                campos, num = [], ""
                for _ in range(24):
                    k = win.getch()
                    if k == ord(";"):
                        campos.append(num)
                        num = ""
                    elif k in (ord("M"), ord("m")):
                        campos.append(num)
                        if len(campos) != 3 or not all(c.isdigit() for c in campos):
                            return None
                        b, mx, my = (int(c) for c in campos)
                        return b, mx - 1, my - 1, k == ord("M")
                    elif 48 <= k <= 57:
                        num += chr(k)
                    else:
                        return None
            finally:
                win.timeout(espera if restaurar is None else restaurar)
            return None

        def tecla_limpia(win):
            """Una pulsacion de verdad: descarta el raton. Sin esto, pasar el raton por
            encima de un dialogo lo cerraba — y en el de cerrar sesiones, lo cancelaba."""
            while True:
                k = win.getch()
                if k == curses.KEY_MOUSE:
                    continue
                if k == 27 and raton:
                    if leer_sgr(win, -1) is None:
                        return 27          # ESC de verdad: cierra el dialogo
                    continue               # era el raton: seguimos esperando
                return k

        marcadas, cur, top, aviso = set(), 0, 0, ""
        filtro, buscando, extra, ancla, ayuda = "", False, [], None, False
        vista_now = False
        modo, orden_inv = modo_orden_inicial()
        todas, foco = list(rows), None
        sobre, ultimo_click = None, (None, 0.0)
        if recargar:
            stdscr.timeout(2500)      # refresco solo; -1 seria bloqueante
        ultima_recarga = time.monotonic()
        while True:
            # El refresco iba SOLO en el `timeout` del `getch`, asi que mientras te
            # movias por la lista con las flechas no llegaba nunca: un `/rename` hecho
            # en otra ventana no aparecia hasta que soltabas el teclado 2,5 s. Ahora se
            # mira el reloj tambien aqui, con el mismo periodo, asi que el titulo llega
            # igual estes navegando o quieto. No cuesta mas: es el mismo refresco, solo
            # que ya no se pospone por teclear.
            if recargar and time.monotonic() - ultima_recarga >= 2.5:
                foco = rows[cur]["name"] if rows and 0 <= cur < len(rows) else foco
                todas = recargar()
                ultima_recarga = time.monotonic()
            fuentes = clis_presentes(todas + extra)
            base = todas + extra
            candidatas = [r for r in base if casa(r, filtro)
                          and (vista == "todas" or cli_de(r) == vista)]
            # Un trozo de transcript por vuelta, empezando por la fila que se esta
            # mirando —`rows` y `cur` son los de la vuelta anterior, que para elegir a
            # quien adelantar sobra—. De aqui salen tres cosas: el panel deja de dar un
            # tiron de 120 ms al llegar a una sesion grande, la barra de contexto de
            # TODA la lista gana el pico (que compactar borra), y el orden por gasto
            # deja de costar 389 ms de golpe al entrar.
            mirando = [rows[cur]] if 0 <= cur < len(rows) else []
            avanza_uso(mirando + candidatas)
            rows = ordena(candidatas, modo, orden_inv)
            if not rows:
                rows = [{"name": "", "title": "", "title_full": _("(nothing matches)"),
                         "idle": None, "working": None, "attached": False,
                         "mem_mb": None, "meta": {}, "_vacio": True,
                         "pulso": {"escribe": None, "herramienta": None}}]
            if foco:                  # tras un refresco, el cursor sigue a su sesion
                for k, r in enumerate(rows):
                    if r["name"] == foco:
                        cur = k
                        break
                foco = None
            cur = max(0, min(cur, len(rows) - 1))
            stdscr.erase()
            h, w = stdscr.getmaxyx()
            trab = sum(1 for r in rows if r["working"])
            # Si lo que se esta mirando tiene sesiones de mas de un CLI. De aqui sale
            # tanto el glifo de cada fila como las dos columnas que cuesta.
            mezcla = len({cli_de(r) for r in rows if not r.get("_vacio")}) > 1

            cab = (_("Sessions that died") if muertas else
                   _("Claude sessions") if vista == "claude" else
                   _("All sessions") if vista == "todas"
                   else _("{v} sessions", v=etiqueta_fuente(vista)))
            externa = vista not in ("claude", "todas")
            ram_total = sum(r["mem_mb"] or 0 for r in rows)
            zonas = []          # (y, x0, x1, que, dato) — lo que el raton puede tocar
            hx = 2
            def cab_put(txt, par=0, extra=0):
                nonlocal hx
                if hx < w - 1:
                    stdscr.addnstr(0, hx, txt, w - 1 - hx, C(par) | extra)
                    hx += ancho(txt)
            if muertas:
                cab_put(cab, 6, curses.A_BOLD)
                cab_put("   ")
            else:
                # Pestanas en vez del titulo: "Sesiones de Claude" ya lo dice la
                # pestana activa, y ademas ensena QUE otras vistas hay — cosa que una
                # tecla escondida (TAB) no hace. Se pinchan.
                for nom in (["claude"] + [f for f in fuentes if f != "claude"]
                            + ["todas"]):
                    x0, act = hx, nom == vista
                    # La pestana lleva SU glifo, que es lo que hace de leyenda: la fila
                    # marcada con el mismo simbolo se asocia sola, sin una linea de
                    # ayuda aparte que nadie lee.
                    gl = GLIFO_CLI.get(nom, "")
                    cab_put(f" {gl}{' ' if gl else ''}{etiqueta_fuente(nom)} ",
                            0 if act else 4,
                            (CF(6) | curses.A_BOLD) if act else 0)
                    zonas.append((0, x0, hx - 1, "vista", nom))
                cab_put("   ")
            if filtro or buscando:
                cab_put(_("filter: ") + filtro + "\u2588", 2, curses.A_BOLD)
                cab_put("   ")
            # Solo cuando NO es el de por defecto, igual que el chip del filtro. La
            # cabecera ya se recorta a 80 columnas: un "orden: actividad" permanente se
            # comeria los contadores para decir lo que se ve mirando la lista.
            if modo != MODOS_ORDEN[0] or orden_inv:
                x0 = hx
                cab_put(_("sort: ") + etiqueta_orden(modo)
                        + ("\u2191" if orden_inv else "\u2193"), 7, curses.A_BOLD)
                zonas.append((0, x0, hx - 1, "orden", None))
                cab_put("   ")
            # Las que nunca arrancaron no se cuentan como reanudables: reanudar una te
            # devuelve su error de arranque y nada mas. Solo se descuentan de ESE rotulo
            # — en "todas" el numero es el total de filas y ahi si es verdad.
            vacias = sum(1 for r in rows if vacia(r))
            # Las que ya no tienen directorio tampoco son reanudables, y por el mismo
            # motivo que las vacias: reanudar una te deja en un `cd` a un sitio que no
            # esta. Se cuentan aparte de aquellas — una sesion sin arrancar Y sin sitio
            # se contaria dos veces y el rotulo dejaria de sumar.
            sin_sitios = sum(1 for r in rows if sin_sitio(r) and not vacia(r))
            resumible = (muertas or externa) and vista != "todas"
            cab_put(str(len(rows) - ((vacias + sin_sitios) if resumible else 0)), 6,
                    curses.A_BOLD)
            # En "todas" conviven abiertas y reanudables: llamarlas "abiertas" a todas
            # decia que 46 sesiones muertas seguian corriendo.
            cab_put(_(" total") if vista == "todas" else
                    _(" resumable") if (muertas or externa) else _(" open"), 4)
            if vacias:
                cab_put("  \u00b7  ", 4)
                cab_put(str(vacias), 4, curses.A_BOLD)
                cab_put(_(" never started"), 4)
            if sin_sitios:
                cab_put("  \u00b7  ", 4)
                cab_put(str(sin_sitios), 4, curses.A_BOLD)
                cab_put(_(" with nowhere to go back to"), 4)
            currando = sum(1 for r in rows if (r.get("pulso") or {}).get("herramienta"))
            escriben = sum(1 for r in rows if (r.get("pulso") or {}).get("escribe")
                           and not (r.get("pulso") or {}).get("herramienta"))
            if escriben:
                cab_put("  \u00b7  ", 4)
                cab_put("\u25cf ", 9, curses.A_BOLD)
                cab_put(str(escriben), 9, curses.A_BOLD)
                cab_put(_(" writing"), 4)
            if currando:
                cab_put("  \u00b7  ", 4)
                cab_put("\u25d0 ", 7, curses.A_BOLD)
                cab_put(str(currando), 7, curses.A_BOLD)
                cab_put(_(" in a command"), 4)
            if not (muertas or externa):
                # "En espera" son las VIVAS que no estan trabajando. Las paradas no
                # cuentan aqui: tienen su propio contador debajo. Desde que `historial`
                # dejo de ser pestana, la vista `claude` trae las dos cosas, asi que
                # esta cuenta ya no la afina el filtro — la afina este `== "claude"`.
                quietas = sum(1 for r in rows if not r["working"]
                              and r.get("fuente", "claude") == "claude")
                if quietas or vista != "todas":
                    cab_put("  \u00b7  ", 4)
                    cab_put(str(quietas), 0)
                    cab_put(_(" idle"), 4)
            # Y las paradas, que ahora comparten pestana con las vivas: sin este numero
            # una lista de veinte filas no dice cuantas de ellas siguen ahi de verdad.
            reanud = sum(1 for r in rows if r.get("fuente", "claude") != "claude")
            if reanud and not muertas:
                cab_put("  \u00b7  ", 4)
                cab_put(str(reanud), 4, curses.A_BOLD)
                cab_put(_(" resumable"), 4)
            if ram_total:
                cab_put("  \u00b7  ", 4)
                cab_put(_mb(ram_total), 8, curses.A_BOLD)

            fondo = max(5, h - 6)          # ultima fila util del area de contenido
            alto = max(3, min(len(rows), fondo - 2))
            if cur < top:
                top = cur
            if cur >= top + alto:
                top = cur - alto + 1

            # Con 150 columnas la lista ocupaba un tercio y el resto estaba vacio:
            # a partir de 108 el detalle se va a una columna a la derecha.
            lateral = w >= 108
            # El ancho sobrante se lo lleva el PANEL, no el titulo: estirar el titulo
            # solo mete espacios en blanco entre columnas, mientras que el panel tiene
            # contenido de verdad que cortar (el ultimo prompt). Asi una ventana de 185
            # columnas se llena de informacion en vez de desierto.
            visibles = rows[top:top + alto]

            def _proy(r):
                pr, ra = r.get("proyecto") or "", r.get("rama") or ""
                if ra and ra not in ("main", "master"):
                    return f"{pr} \u2387{ra}" if pr else ra
                return pr

            # Cada columna pide lo que necesita y el sobrante va al panel. Fijar el
            # proyecto a 18 cortaba nombres largos teniendo la pantalla
            # medio vacia al lado.
            largo = max((ancho(r.get("title_full") or r["title"]) for r in visibles),
                        default=20)
            ancho_p = min(30, max((ancho(_proy(r)) for r in visibles), default=0))
            # Una columna que no tiene nada que decir no ocupa. La RAM solo la sabe
            # quien corre bajo tmux y el contexto solo lo publica Claude Code: sin
            # esto, quien no use ninguna de las dos paga 22 columnas de blanco en
            # cada fila. Mismo criterio que `ancho_p`, que ya vale 0 sin proyecto.
            anchura_t, ancho_p, an_ctx, an_ram, fijas = reparto(
                w - (52 if lateral else 3), largo, ancho_p,
                any((r.get("pulso") or {}).get("ctx") for r in visibles),
                any(r.get("mem_mb") for r in visibles), mezcla)
            ancho_lista = anchura_t + fijas
            ancho_lista += 1              # una columna en blanco para el scrollbar
            # Tope duro contra el borde. `anchura_t` tiene un minimo de 12 columnas, asi
            # que en una ventana estrecha `ancho_lista` acababa siendo MAYOR que la
            # pantalla y el relleno de la fila del cursor escribia fuera: curses no
            # avisa, aborta con `addnwstr() returned ERR` y se lleva el programa. Lo
            # cazo el test del pty en el CI, donde la ventana es pequena.
            ancho_lista = max(12, min(ancho_lista, w - 2))
            # El panel arranca en `ancho_lista + 4`, asi que lo que le cabe se mide
            # DESDE ahi, y sobra una columna al final: escribir en la ultima de la fila
            # hace que curses envuelva el sobrante al principio de la SIGUIENTE, y
            # aparecia un caracter suelto pegado al borde izquierdo dos filas mas
            # abajo. Se veia en las capturas y parecia suciedad del terminal.
            ancho_det = max(0, w - (ancho_lista + 4) - 1) if lateral else 0
            if lateral and ancho_det < 26:
                lateral, ancho_det, ancho_lista = False, 0, anchura_t + fijas
            fila0 = 2
            # Regla bajo la cabecera: sin ella el estado global y la primera fila se
            # leen como una sola cosa. La T marca donde arranca la columna de detalle.
            stdscr.addnstr(1, 2, "\u2500" * max(0, w - 3), max(0, w - 3), C(4))
            if lateral and ancho_lista + 2 < w - 1:
                stdscr.addnstr(1, ancho_lista + 2, "\u252c", 1, C(4))
            tope_ram = max((r["mem_mb"] or 0 for r in rows), default=0)
            for vis, i in enumerate(range(top, min(len(rows), top + alto))):
                r = rows[i]
                marcada = r["name"] in marcadas or (
                    ancla is not None and min(ancla, cur) <= i <= max(ancla, cur))
                fila_y, x = fila0 + vis, 0
                foco = i == cur
                roza = sobre == i and not foco
                zonas.append((fila_y, 0, 2, "marca", i))
                zonas.append((fila_y, 3, max(3, ancho_lista - 1), "fila", i))

                def put(txt, par=0, extra=0):
                    """Pinta un trozo con su propio color. Bajo el cursor solo cambia
                    el FONDO (pares 10..19), asi que el estado, el proyecto y la RAM
                    siguen distinguiendose en la fila que estas mirando."""
                    nonlocal x
                    if not txt or x >= ancho_lista:
                        return
                    attr = (CF(par) if foco else CH(par) if roza else C(par)) | extra
                    stdscr.addnstr(fila_y, x, txt, ancho_lista - x, attr)
                    # Acotado: `addnstr` recorta lo que pinta, pero `x` avanzaba el
                    # ancho ENTERO del texto, asi que en una ventana estrecha se salia
                    # de la pantalla y el siguiente addnstr moria con ERR.
                    x = min(x + ancho(txt), ancho_lista)

                sin_rastro = (r.get("fuente", "claude") == "claude"
                              and not r.get("_vacio") and not r.get("_demo")
                              and not (r.get("meta") or {}).get("_transcript"))
                # Barra de canal en vez de "[x] ": amarilla si esta marcada, azul si es
                # la fila bajo el cursor. Cuatro columnas menos de ruido repetido en
                # cada linea, y la seleccion se lee por color sin deletrear casillas.
                put(" ")
                put("\u258c" if marcada else ("\u258e" if foco else " "),
                    2 if marcada else 6, curses.A_BOLD)
                put(" ")
                pu = r.get("pulso") or {}
                # El estado va PEGADO al titulo y a la izquierda, no detras. Antes se
                # pintaba al terminar el titulo, que va relleno hasta el mas largo de
                # la pantalla: con un titulo corto quedaban quince blancos entre la
                # frase y el punto que dice si esa sesion esta viva. Aqui cae siempre
                # en la misma columna y se lee la lista entera de un barrido vertical.
                #
                # La herramienta gana sobre "escribe": el tool_use acaba de escribirse
                # en el transcript, asi que las dos son ciertas a la vez y la que
                # informa es la segunda ("esta corriendo algo"), no la primera.
                # El choque va en SU columna, entre el estado y el titulo. Meterlo en
                # el blanco que ya habia detras del estado salia gratis pero dejaba el
                # simbolo pegado a la primera letra —`\u25d0\u29c9Refactor`— y eso se lee como un
                # fallo de pintado, no como un aviso. La columna se paga en COL_BASE y
                # el titulo solo la nota por debajo de ~50 columnas, porque `reparto` ya
                # lo topa en T_COMODO. `\u29c9` mide UNA columna (east_asian_width 'N').
                col = r.get("colision") or {}
                # La columna del aviso es UNA y la comparten el choque y el atasco. El
                # choque gana cuando coinciden, y no por ser mas frecuente: si no lo
                # ves, dos sesiones pueden pisarse el trabajo; si no ves el atasco,
                # pierdes minutos. Los dos salen enteros en el panel y en `--list`.
                atasco = (r.get("pulso") or {}).get("atasco") or ()
                if pu.get("herramienta"):
                    put("\u25d0", 7, curses.A_BOLD)       # esperando a su comando
                elif pu.get("escribe"):
                    put("\u25cf", 9, curses.A_BOLD)        # escribiendo la respuesta
                else:
                    put(" ")
                put("\u29c9" if col else ("\u21bb" if atasco else " "),
                    5 if (col.get("nivel") or 0) >= 3 else 7, curses.A_BOLD)
                put(" ")
                # De que CLI es. Va aqui y no al final porque se lee en vertical con el
                # estado, de un barrido: al final de la fila habria que buscarlo.
                #
                # Y solo cuando la lista MEZCLA CLIs. En la pestana de uno solo, la
                # columna repetiria ocho veces lo que la pestana activa ya dice, y esas
                # dos columnas las quiere el titulo.
                if mezcla:
                    if not r.get("_vacio"):
                        gl, par_gl = glifo_cli(r)
                        put(gl, par_gl, curses.A_BOLD)
                        put(" ")
                    else:
                        put("  ")
                titulo = rellena(recorta(r.get("title_full") or r["title"], anchura_t),
                                 anchura_t)
                put(titulo, 2 if marcada else (5 if sin_rastro else
                                               4 if (vacia(r) or sin_sitio(r)) else 0),
                    curses.A_BOLD if (marcada or foco) else 0)
                proy = _proy(r)
                if ancho_p:
                    put("  ")
                    put(rellena(recorta(proy, ancho_p), ancho_p + 1), 8 if proy else 4)
                put(f"{_hace(r['idle']):>8} ", color_tiempo(r["idle"]))
                # Cuanto contexto lleva gastado. Es el dato que decide si una sesion
                # aguanta otra tarea o si toca compactarla, y hasta hoy solo se veia
                # entrando en ella. En blanco cuando no consta: una sesion de otro CLI
                # no lo publica, y cero seria mentira.
                if an_ctx:
                    ctx = pu.get("ctx")
                    tope_ctx = tope_contexto(pu.get("modelo"), ctx,
                                             pu.get("ventana_1m"), pico_de(r))
                    lleno = (ctx or 0) / tope_ctx
                    # Y lo que LLEGO a tener. Compactar borra la prueba: una sesion de
                    # 700 turnos que ha compactado dos veces marca un 11% y parece la
                    # mas fresca de la lista justo cuando es la mas gastada. Las celdas
                    # del pico van llenas y en gris: llenas para que se vea que estuvo
                    # ahi, en gris para que no se confunda con lo que tiene ahora.
                    #
                    # Sin color no se dibujan. Seria la misma barra mas llena sin nada
                    # que dijera que eso ya no esta, y eso es mentir hacia arriba: mejor
                    # la de siempre. `pico` es 0 hasta que se lee el transcript entero,
                    # y 0 no pinta nada.
                    alto_pico = pico_de(r) if color else 0
                    cad = barra(ctx, tope_ctx, pico=alto_pico)
                    llenas = _celdas(ctx, tope_ctx)
                    put(cad[:llenas], color_contexto(lleno))
                    put(cad[llenas:], 4)
                    put(f" {round(lleno * 100):>3}%" if ctx else "     ",
                        color_contexto(lleno))
                if an_ram:
                    # La cifra va coloreada por su cuota, que es lo que hacia la aguja
                    # de al lado. Dos dibujos para el mismo hecho, uno pegado al otro:
                    # sobraba el de menos precision.
                    cuota = (r["mem_mb"] or 0) / tope_ram if tope_ram else 0
                    put(f"{(_mb(r['mem_mb']) if r['mem_mb'] else ''):>7} ",
                        5 if cuota > 0.75 else 7 if cuota > 0.4 else 4)
                put("\u25aa" if r["attached"] and not r.get("_sin_proceso") else " ", 6)
                relleno = max(0, ancho_lista - x)
                if (foco or roza) and relleno:      # con n=0, addnstr devuelve ERR
                    stdscr.addnstr(fila_y, x, " " * relleno, relleno,
                                   CF(0) if foco else CH(0))

            y = fila0 + alto
            if len(rows) > alto:
                # La columna `ancho_lista` esta libre por construccion (todo el
                # contenido se recorta a ancho_lista-1) y la barra dice de un vistazo
                # cuanta lista queda debajo, que el contador solo dice leyendolo.
                grosor = max(1, round(alto * alto / len(rows)))
                arriba = round((alto - grosor) * top / max(1, len(rows) - alto))
                for k in range(alto):
                    pomo = arriba <= k < arriba + grosor
                    stdscr.addnstr(fila0 + k, ancho_lista,
                                   "\u2503" if pomo else "\u2502", 1,
                                   C(6) if pomo else C(4))
                    zonas.append((fila0 + k, ancho_lista, ancho_lista, "scroll", k))
                stdscr.addnstr(y, 4, _("\u2195  {a}\u2013{b} of {n}",
                                       a=top + 1, b=top + alto, n=len(rows)), w - 5, C(4))
                y += 1
            y += 1

            d = detalles(rows[cur])
            fu = rows[cur].get("fuente", "claude")
            cwd_cur = d.get("cwd") or (rows[cur].get("meta") or {}).get("cwd") or ""
            proyecto = pathlib.Path(cwd_cur).name
            ult = _clean(d.get("lastPrompt") or "")
            pistas = [x for x in (
                _("{f} \u00b7 ENTER resumes it", f=etiqueta_fuente(fu))
                if fu != "claude" else d.get("fase"),
                proyecto or None,
                d.get("gitBranch"),
                (_("{n} MB of history", n=max(1, (d.get('peso') or 0) // 1024 // 1024))
                 if d.get("peso") else
                 None if fu != "claude"
                 else _("NO TRANSCRIPT: closing it loses it")),
                rows[cur]["name"],
            ) if x]

            if lateral:
                x0 = ancho_lista + 4
                campos = campos_panel(rows[cur], d, cwd_cur)
                ruta = d.get("ruta") or []
                sn = sintomas(ruta)
                alertas_ruta = alertas(sn)
                hay_ruta = bool(ruta) and ancho_det >= RUTA_FIJO + 26
                bloques = bloques_panel(rows[cur], d, ult, hay_ruta)
                base_campos, base_ruta, n_ruta, hay_ruta, cuotas = reparto_panel(
                    fila0, fondo, len(campos), bloques, len(ruta),
                    len(alertas_ruta), ancho_det, hay_ruta)
                fila = fila0
                for (etiq, txt, par, _t, cop), cuota in zip(bloques, cuotas):
                    if fila >= base_ruta - 2:
                        break          # cabecera sin ni una linea debajo no informa
                    # La zona va en la CABECERA y no sobre el texto: el texto ocupa
                    # varias lineas y se recorta, asi que subrayarlo entero seria un
                    # parrafo subrayado —ilegible— y ademas dejaria la mitad de la
                    # zona fuera de lo que se copia. La cabecera es una linea y ya
                    # dice de que es lo que hay debajo.
                    stdscr.addnstr(fila, x0, etiq, ancho_det, C(par) | curses.A_BOLD
                                   | (curses.A_UNDERLINE if cop else 0))
                    if cop:
                        zonas.append((fila, x0, x0 + ancho(etiq) - 1, "copia", txt))
                    fila += 1
                    for trozo in _troceado(txt, ancho_det, cuota):
                        if fila >= base_ruta - 1:
                            break
                        stdscr.addnstr(fila, x0, trozo, ancho_det)
                        fila += 1
                    fila += 1

                if hay_ruta:
                    fila = base_ruta
                    # Los nombres llevan sufijo `_ev`/`_ruta` a proposito: `run()` es
                    # una funcion larga y ya tiene un `res` (el dict que devuelve), un
                    # `par` y un `cab`. Reusar cualquiera de los tres aqui los pisa, y
                    # el fallo no sale en esta linea sino donde se leen despues.
                    cab_ruta = _("\u25b8 what it has been doing")
                    stdscr.addnstr(fila, x0, cab_ruta, ancho_det, C(6) | curses.A_BOLD)
                    # Los que no caben se cuentan pero no se dibujan: "hay mas arriba"
                    # es informacion; media fila de un evento cortado, no.
                    ocultos = len(ruta) - n_ruta
                    if ocultos and ancho(cab_ruta) + 16 <= ancho_det:
                        stdscr.addnstr(fila, x0 + ancho(cab_ruta) + 2,
                                       _("(+{n} earlier)", n=ocultos),
                                       ancho_det - ancho(cab_ruta) - 2, C(4))
                    fila += 1
                    for clave in alertas_ruta:
                        # `!` y no un simbolo de aviso: U+26A0 es de ancho ambiguo y
                        # descuadraria la columna en la mitad de los terminales.
                        stdscr.addnstr(fila, x0 + 2, "!", 1, C(5) | curses.A_BOLD)
                        stdscr.addnstr(fila, x0 + 4,
                                       recorta(_TEXTO_ALERTA[clave](sn), ancho_det - 4),
                                       ancho_det - 4, C(5))
                        fila += 1
                    for e in ruta[-n_ruta:]:
                        glifo, par_ev, dur, res_ev = linea_ruta(e, ancho_det)
                        stdscr.addnstr(fila, x0 + 2, glifo, 1,
                                       C(par_ev) | curses.A_BOLD)
                        stdscr.addnstr(fila, x0 + 4, dur, 4, C(4))
                        stdscr.addnstr(fila, x0 + RUTA_FIJO, res_ev,
                                       ancho_det - RUTA_FIJO,
                                       C(par_ev) if (e["pend"] or e["err"]) else 0)
                        fila += 1

                fila = base_campos
                # `*resto` y no un cuarto elemento en los once: solo dos campos llevan
                # algo que copiar, y ponerle `None` a los otros nueve son nueve lineas
                # de ruido que no dicen nada.
                for etiq, valor, par, *resto in campos:
                    if fila > fondo:
                        break
                    cop = resto[0] if resto else None
                    txt_val = recorta(valor, ancho_det - 10)
                    stdscr.addnstr(fila, x0, f"{etiq:<10}", 10, C(4))
                    stdscr.addnstr(fila, x0 + 10, txt_val, ancho_det - 10, C(par)
                                   | (curses.A_BOLD if par in (5, 9) else 0)
                                   | (curses.A_UNDERLINE if cop else 0))
                    if cop:
                        zonas.append((fila, x0 + 10,
                                      x0 + 10 + max(0, ancho(txt_val) - 1), "copia", cop))
                    fila += 1
                # La vertical llega hasta donde hay algo: un separador colgando sobre
                # veinte lineas vacias es marco, no informacion.
                for k in range(fila0, max(fila0 + alto, fila)):
                    stdscr.addnstr(k, x0 - 2, "\u2502", 1, C(4))
            else:
                if ult:
                    stdscr.addnstr(y, 2, _("last:"), 8, C(6) | curses.A_BOLD)
                    stdscr.addnstr(y, 10, recorta(ult, max(20, w - 12)), w - 11)
                    y += 1
                stdscr.addnstr(y, 10, recorta("  \u00b7  ".join(pistas), w - 12),
                               w - 11, C(4))

            y = min(max(y + 1, h - 4), max(0, h - 3))
            n = len(marcadas)
            if aviso:                      # el aviso manda: va donde se mira
                stdscr.addnstr(y, 2, " " + aviso + " ", w - 3,
                               (C(9) if aviso.startswith("Abierta") else C(2))
                               | curses.A_BOLD)
            elif n:
                stdscr.addnstr(y, 2,
                               _("{n} marked to discard", n=n) if muertas
                               else _("{n} marked to close", n=n),
                               w - 3, C(2) | curses.A_BOLD)
            # Pastillas con fondo en vez de texto suelto: se leen como botones, que es
            # lo que ya son — se pinchan y hacen lo mismo que su tecla.
            hx2 = 2
            # El orden NO es decorativo: va de mas esencial a menos, porque el bucle
            # para en la primera que no cabe y a 80 columnas —que es media flota— solo
            # entran cinco. Antes `? ayuda` era la sexta: la puerta al resto de teclas
            # no se veia justo en la ventana donde mas falta hace. Y `TAB` baja porque
            # las pestanas ya salen pintadas arriba, con sus nombres.
            for tecla, txt, cod in ((_("ENTER"), _("open"), 10),
                                    (_("SPACE"), _("mark"), 32),
                                    ("x", _("close"), ord("x")),
                                    ("?", _("help"), ord("?")),
                                    ("/", _("filter"), ord("/")),
                                    ("s", _("sort"), ord("s")),
                                    ("TAB", "CLI", 9),
                                    ("q", _("quit"), ord("q"))):
                pastilla = f" {tecla} {txt} "
                if hx2 + ancho(pastilla) >= w - 2:
                    break
                stdscr.addnstr(y + 2, hx2, f" {tecla} ", w - 1 - hx2,
                               CF(7) | curses.A_BOLD)
                stdscr.addnstr(y + 2, hx2 + len(tecla) + 2, f"{txt} ", w - 1 - hx2, CF(0))
                zonas.append((y + 2, hx2, hx2 + ancho(pastilla) - 1, "tecla", cod))
                hx2 += ancho(pastilla) + 2
            stdscr.refresh()

            if vista_now:
                # El panel ya pintaba este recorrido, pero solo el de la fila del
                # cursor. Las lineas las compone `lineas_now()`, la MISMA que usa
                # `--now` en la terminal: dos compositores del mismo hecho acaban
                # diciendo cosas distintas y aqui no se veria hasta compararlos.
                lineas_v = lineas_now(que_hacen(),
                                      max(30, min(110, w - 4) - 32))
                alto_v, ancho_v, y_v, x_v, caben = caja_now(h, w, len(lineas_v))
                ocultas = max(0, len(lineas_v) - caben)
                lineas_v = lineas_v[:caben]
                win = curses.newwin(alto_v, ancho_v, y_v, x_v)
                win.attrset(C(6))
                win.box()
                win.attrset(0)
                win.addnstr(1, 3, _("What they are all running"), ancho_v - 6,
                            C(6) | curses.A_BOLD)
                cierre = " " + _("any key closes") + " "
                if ancho_v > ancho(cierre) + 6:
                    win.addnstr(alto_v - 1, ancho_v - ancho(cierre) - 3, cierre,
                                ancho(cierre), C(4))
                # Lo que no cabe se CUENTA aunque no se dibuje: media pantalla de
                # sesiones sin decir que faltan es peor que decir cuantas faltan.
                if ocultas:
                    aviso_v = " " + _("{n} lines more", n=ocultas) + " "
                    if ancho_v > ancho(aviso_v) + 6:
                        win.addnstr(0, 3, aviso_v, ancho(aviso_v), C(4))
                for k, (texto, par) in enumerate(lineas_v):
                    if texto:
                        win.addnstr(3 + k, 2, texto, max(1, ancho_v - 4), C(par))
                win.refresh()
                win.timeout(-1)
                tecla_limpia(win)
                vista_now = False
                continue

            if ayuda:
                teclas = [
                    (_("ENTER"), _("open it (a NEW window when Warp is there)")),
                    (_("arrows"), _("move (j / k too)")),
                    (_("home/end"), _("first / last (g / G too)")),
                    ("s / S", _("sort: activity, context, project, memory, spend / invert")),
                    ("y", _("copy the session id")),
                    (_("SPACE"), _("mark / unmark")),
                    ("v", _("range mode: drop an anchor, SPACE marks to the cursor")),
                    ("x", _("close the marked ones (asks first)")),
                    ("/", _("filter by title, project, branch or id")),
                    ("TAB", _("switch CLI: claude, history, codex, gemini, all")),
                    ("a / i", _("mark all / invert")),
                    ("d", _("mark the ones idle for over an hour")),
                    ("r", _("reopen the marked ones as tabs")),
                    ("c", _("hand the marked ones to another CLI (codex, claude...)")),
                    ("n", _("what they are ALL running, in one screen")),
                    ("q", _("quit without touching anything")),
                    ("", ""),
                    (_("mouse"), _("click selects, double click opens")),
                    ("", _("underlined values copy when you click them")),
                    ("", _("right click, or click the bar on the left: mark")),
                    ("", _("wheel scrolls; tabs and buttons below are clickable")),
                    ("", ""),
                    # Quien vive dentro del selector no se entera de que existen los
                    # tres modos que no abren interfaz. Aqui es donde va a mirar.
                    (_("outside"), _("--watch: tells you when one stops and waits")),
                    ("", _("--find \"text\": searches what was said")),
                    ("", _("--json: for statuslines and scripts")),
                    ("", _("\u29c9 in a row: another session is writing in the same place")),
                    ("", _("\u21bb in a row: it is going in circles \u2014 see the panel")),
                ]
                alto_v, ancho_v = min(h - 2, len(teclas) + 4), max(30, min(70, w - 4))
                teclas = teclas[:max(0, alto_v - 4)]
                win = curses.newwin(alto_v, ancho_v, max(0, (h - alto_v) // 2),
                                    max(0, (w - ancho_v) // 2))
                win.attrset(C(6))
                win.box()
                win.attrset(0)
                win.addnstr(1, 3, _("Keys"), ancho_v - 6, C(6) | curses.A_BOLD)
                # Como se sale, escrito en el propio marco. Un modal sin salida a la
                # vista hace probar teclas, y aqui casi todas hacen algo.
                cierre = " " + _("any key closes") + " "
                if ancho_v > ancho(cierre) + 6:
                    win.addnstr(alto_v - 1, ancho_v - ancho(cierre) - 3, cierre,
                                ancho(cierre), C(4))
                for k, (tec, txt) in enumerate(teclas):
                    if tec:
                        win.addnstr(3 + k, 3, f"{tec:<11}", 11, C(7) | curses.A_BOLD)
                    if txt:
                        win.addnstr(3 + k, 14, txt, max(1, ancho_v - 17), C(4))
                win.refresh()
                win.timeout(-1)
                tecla_limpia(win)
                ayuda = False
                continue

            c = stdscr.getch()
            if c == -1:               # nadie ha tocado nada: refrescar y seguir
                foco = rows[cur]["name"] if rows else None
                todas = recargar()
                ultima_recarga = time.monotonic()
                continue
            ev = None
            if c == curses.KEY_MOUSE:                 # ncurses lo parseo el
                try:
                    _id, mx, my, _z, bs = curses.getmouse()
                except curses.error:
                    continue
                # BUTTON5 solo existe si ncurses se compilo con la v2 del protocolo:
                # sin el getattr, la rueda hacia abajo tira la sesion con AttributeError.
                ev = (mx, my, bool(bs & curses.BUTTON4_PRESSED),
                      bool(bs & getattr(curses, "BUTTON5_PRESSED", 0x00200000)),
                      bool(bs & (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED)),
                      bool(bs & (curses.BUTTON3_PRESSED | curses.BUTTON3_CLICKED)))
            elif c == 27 and raton:                   # ncurses no sabe: SGR a mano
                sgr = leer_sgr(stdscr)
                if not sgr:
                    continue
                b, mx, my, pulsado = sgr
                rueda, bot = bool(b & 64), b & 3
                mueve = bool(b & 32) and not rueda
                ev = (mx, my, rueda and bot == 0, rueda and bot == 1,
                      pulsado and not mueve and bot == 0,
                      pulsado and not mueve and bot == 2)

            if ev:
                mx, my, arriba, abajo, pulsa, dcha = ev
                if arriba or abajo:
                    # La rueda desplaza la VISTA y solo arrastra el cursor si se le
                    # sale: mover la seleccion con la rueda hace perder el sitio.
                    top = (max(0, top - 3) if arriba
                           else min(max(0, len(rows) - alto), top + 3))
                    cur = max(top, min(cur, top + alto - 1))
                    continue
                golpe = next((z for z in zonas if z[0] == my and z[1] <= mx <= z[2]), None)
                if not (pulsa or dcha):          # solo esta pasando por encima
                    nuevo = golpe[4] if golpe and golpe[3] in ("fila", "marca") else None
                    if nuevo == sobre:
                        continue                 # nada que repintar: no gastes la vuelta
                    sobre = nuevo
                    continue
                if not golpe:
                    continue
                _y, _x0, _x1, que, dato = golpe
                buscando = False
                if que == "orden":
                    foco = rows[cur]["name"]
                    modo = MODOS_ORDEN[(MODOS_ORDEN.index(modo) + 1) % len(MODOS_ORDEN)]
                    continue
                if que == "vista":
                    if dato != "claude" and not extra:
                        extra = sesiones_externas(_ids(todas))
                    vista, cur, top = dato, 0, 0
                    aviso = ""
                    continue
                if que == "scroll":
                    top = max(0, min(round((len(rows) - alto) * dato / max(1, alto - 1)),
                                     max(0, len(rows) - alto)))
                    cur = max(top, min(cur, top + alto - 1))
                    continue
                if que == "copia":
                    # Sale por `continue` a proposito: unas lineas mas abajo hay un
                    # `aviso = ""` que limpia el rotulo despues de atender al raton,
                    # y sin el `continue` este aviso no llegaria a verse nunca.
                    copia_al_portapapeles(dato)
                    # Recortado: el texto de una respuesta ocupa parrafos y el rotulo
                    # es una linea. Aqui no hace falta ensenarlo entero como con el id
                    # —eso era para poder seleccionarlo a mano si OSC 52 no va—, basta
                    # con decir QUE se ha copiado.
                    aviso = _("copied: {s}", s=recorta(dato, 48))
                    continue
                if que == "marca" or (que == "fila" and dcha):
                    if not rows[dato].get("_vacio"):
                        marcadas.symmetric_difference_update({rows[dato]["name"]})
                    cur = dato
                    aviso = ""
                    continue
                if que == "fila":
                    ahora = time.time()
                    doble = ultimo_click[0] == dato and ahora - ultimo_click[1] < 0.45
                    ultimo_click, cur = (dato, ahora), dato
                    if not doble:
                        aviso = ""
                        continue
                    c = 10                       # doble click = ENTER
                elif que == "tecla":
                    c = dato                     # la pastilla del pie hace de tecla

            # El aviso se limpia DESPUES del raton, no antes: con 1003 cada pixel de
            # movimiento es un evento, y borrarlo arriba hacia que un "Abierta en una
            # ventana nueva" durara lo que tardas en rozar el raton.
            aviso = ""
            if c in (ord("n"), ord("N")):
                vista_now = True
                continue
            if c == ord("?"):
                ayuda = True
                continue

            if buscando:                    # modo filtro: casi todo es texto
                if c == -1:
                    continue
                if c in (curses.KEY_ENTER, 10, 13, 27):
                    buscando = False
                elif c in (curses.KEY_BACKSPACE, 127, 8):
                    filtro = filtro[:-1]
                    if not filtro:
                        buscando = False
                elif 32 <= c < 127:
                    filtro += chr(c)
                    cur = 0
                continue

            if c == ord("/"):
                buscando, filtro, cur = True, "", 0
                continue
            # `s` y `S` viven aqui, con `/` y TAB, porque son lo mismo: mandan sobre QUE
            # se ve y en que sitio, no sobre la fila. Y el cursor sigue a SU sesion en
            # vez de quedarse en el indice: reordenar no puede cambiarte de sesion
            # seleccionada debajo de la mano.
            if c == ord("s"):
                foco = rows[cur]["name"]
                modo = MODOS_ORDEN[(MODOS_ORDEN.index(modo) + 1) % len(MODOS_ORDEN)]
                continue
            if c == ord("S"):
                foco = rows[cur]["name"]
                orden_inv = not orden_inv
                continue
            if c == 9:                      # Tab: claude -> historial -> ... -> todas
                if not extra:
                    extra = sesiones_externas(_ids(todas))
                # `fuentes` se calculo arriba del bucle, cuando `extra` aun estaba vacio:
                # usarlo aqui dejaba el ciclo en ["claude", "todas"] y el PRIMER Tab
                # saltaba al final. Se recalcula con lo que se acaba de cargar.
                fuentes = clis_presentes(todas + extra)
                orden = ["claude"] + [f for f in fuentes if f != "claude"] + ["todas"]
                vista = orden[(orden.index(vista) + 1) % len(orden)] if vista in orden else "claude"
                cur = 0
                continue
            if rows and rows[0].get("_vacio"):
                if c in (ord("q"), ord("Q")):
                    return
                if c in (curses.KEY_BACKSPACE, 127, 8):
                    filtro = ""
                continue

            if c in (curses.KEY_UP, ord("k")):
                cur = (cur - 1) % len(rows)
            elif c in (curses.KEY_DOWN, ord("j")):
                cur = (cur + 1) % len(rows)
            elif c in (curses.KEY_HOME, ord("g")):
                cur = 0
            elif c in (curses.KEY_END, ord("G")):
                # `g`/`G` ademas de home/end: `j`/`k` ya estan, y en un teclado de
                # portatil de Apple no hay teclas Inicio/Fin —son fn+flecha, que no
                # todos los terminales traducen a KEY_HOME/KEY_END.
                cur = len(rows) - 1
            elif c == ord("y"):
                # El id de la sesion de Claude, que es el que se le pasa a `--resume`.
                # Antes se copiaba `name`, que en una sesion viva es el nombre de tmux:
                # se pegaba en un `claude --resume` y no reanudaba nada.
                que_copiar = id_sesion(rows[cur]) or rows[cur]["name"]
                copia_al_portapapeles(que_copiar)
                # El id se ensena ADEMAS de copiarlo: hay terminales que ignoran OSC 52
                # y el fallo seria mudo. Asi, como poco, se puede seleccionar a mano.
                aviso = _("copied: {s}", s=que_copiar)
            elif c == ord(" "):
                if ancla is not None:          # modo rango: marca de ancla a cursor
                    for i in range(min(ancla, cur), max(ancla, cur) + 1):
                        marcadas.add(rows[i]["name"])
                    ancla = None
                else:
                    marcadas.symmetric_difference_update({rows[cur]["name"]})
                    cur = min(cur + 1, len(rows) - 1)
            elif c in (ord("v"), ord("V")):
                ancla = None if ancla is not None else cur
            elif c in (ord("a"), ord("A")):
                nombres = {r["name"] for r in rows}
                marcadas = (marcadas - nombres) if nombres <= marcadas else (marcadas | nombres)
            elif c in (ord("i"), ord("I")):
                marcadas ^= {r["name"] for r in rows}
            elif c in (ord("d"), ord("D")):
                quietas = {r["name"] for r in rows if (r["idle"] or 0) >= INACTIVA}
                if not quietas:
                    aviso = _("None has been idle for over an hour.")
                marcadas |= quietas
            elif c in (ord("q"), ord("Q")):
                return          # ESC no vale para salir: llega suelto cuando el
                                # terminal parte una secuencia de flecha en dos
            elif c in (ord("c"), ord("C")):
                if not marcadas:
                    aviso = _("Mark which ones you want to hand over first.")
                    continue
                sel = [r for r in base if r["name"] in marcadas]
                destinos = destinos_de_relevo(sel)
                if not destinos:
                    aviso = (_("No other CLI found on your PATH.")
                             if not arneses_disponibles()
                             else _("Those are already {c} sessions.",
                                    c=arneses_disponibles()[0]))
                    continue
                con_conv = _env("SERENO_RELEVO") == "completo"
                hay_donde = lanzadores_disponibles()
                # Se abre por donde lo dejaste la ultima vez. Quien releva a Codex una
                # vez suele relevar a Codex siempre, y empezar cada vez por el primero
                # de la lista es hacerle teclear lo mismo una y otra vez.
                donde = pref("relevo_donde") if pref("relevo_donde") in hay_donde \
                    else (hay_donde[0] if hay_donde else None)
                ultimo = pref("relevo_arnes")
                if ultimo in destinos:
                    destinos = [ultimo] + [d for d in destinos if d != ultimo]
                elegido = None
                while elegido is None:
                    lin = lineas_relevo(sel, destinos, con_conv, min(70, w - 8),
                                        donde=donde, hay_donde=hay_donde)
                    alto_r = min(len(lin) + 2, h)
                    ancho_r = min(max(ancho(t) for t, _p in lin) + 6, w)
                    win = curses.newwin(alto_r, ancho_r, max(0, (h - alto_r) // 2),
                                        max(0, (w - ancho_r) // 2))
                    win.box()
                    for k, (txt, par) in enumerate(lin[:alto_r - 2]):
                        if txt:
                            win.addnstr(1 + k, 3, txt, ancho_r - 6,
                                        (C(par) if par else 0) | curses.A_BOLD)
                    win.refresh()
                    win.timeout(-1)
                    tec = tecla_limpia(win)
                    if tec in (ord("k"), ord("K")):
                        con_conv = not con_conv
                    elif tec in (ord("w"), ord("W")) and len(hay_donde) > 1:
                        donde = hay_donde[(hay_donde.index(donde) + 1) % len(hay_donde)]
                    elif ord("1") <= (tec or 0) <= ord("9"):
                        i = tec - ord("1")
                        if i < len(destinos):
                            elegido = destinos[i]
                    else:
                        elegido = ""          # cualquier otra tecla cancela
                if not elegido:
                    aviso = _("Cancelled, nothing was handed over.")
                    continue
                guarda_pref(relevo_arnes=elegido, relevo_donde=donde)
                _arnes, aviso = relevo(sel, elegido, con_conversacion=con_conv,
                                       lanzador=donde)
                marcadas.clear()
                ancla = None
                continue
            elif c in (ord("r"), ord("R")):
                # Antes, sin nada marcado, `r` abria TODAS las visibles de una vez. Es
                # la tecla de al lado de las flechas y el gesto no se puede deshacer:
                # ahora hay que decir cuales.
                if not marcadas:
                    aviso = _("Mark which ones you want to resume first.")
                    continue
                sel = [r for r in base if r["name"] in marcadas]
                con_pestana = [r for r in sel if r["attached"]]
                sel = [r for r in sel if not r["attached"]]
                if not sel:
                    aviso = _("Those already have a tab open.")
                    continue
                # Las que ya tienen pestana se caen de la lista, y hasta hoy en
                # silencio: marcabas seis, se abrian cuatro y no habia forma de saber
                # cuales faltaban ni por que.
                _sin_forma = pestanas_de(sel)[1]
                if not ejecutar:
                    res["out"] = ("reopen", sel)
                    return
                # Con dos o mas sitios donde abrirlas, se pregunta. Con uno no hay nada
                # que elegir y un cuadro de una sola opcion es solo una tecla de mas.
                donde = lanzadores_disponibles()
                # Mismo criterio que el cuadro del relevo: lo ultimo elegido va primero.
                # Dos cuadros con la misma forma no pueden recordar uno si y otro no.
                if pref("abrir_donde") in donde:
                    donde = [pref("abrir_donde")] + [d for d in donde
                                                     if d != pref("abrir_donde")]
                if len(donde) > 1:
                    donde = _pide_lanzador(sel, donde, h, w, curses, C, tecla_limpia)
                    if donde is None:
                        aviso = _("Cancelled, nothing was opened.")
                        continue
                    guarda_pref(abrir_donde=donde)
                else:
                    donde = donde[0] if donde else None
                aviso, todas = ejecutar("reopen", sel, donde)
                fuera = ([_("{n} already had a tab", n=len(con_pestana))] if con_pestana
                         else []) + ([_("{n} cannot be opened from here",
                                        n=len(_sin_forma))] if _sin_forma else [])
                if fuera:
                    aviso += " \u00b7 " + ", ".join(fuera)
                res["toco"] = True
                marcadas.clear()
                ancla = None
                continue
            elif c in (curses.KEY_ENTER, 10, 13):
                # No se sale del selector: la pestana desde la que miras la lista
                # se queda como estaba y puedes abrir otra a continuacion.
                if rows[cur].get("_vacio"):
                    continue
                if not hay_warp():
                    res["out"] = ("open", [rows[cur]])
                    return          # sin ventana nueva hay que soltar el tty primero
                abierto = abrir_sesion(rows[cur], callado=True)
                aviso = (_("Opened in a new window: {t}", t=recorta(abierto, w - 40))
                         if abierto else _("Don't know how to open that one."))
                continue
            elif c in (ord("x"), ord("X"), curses.KEY_DC):
                if not marcadas:
                    aviso = _("Mark what you want to close with SPACE first.")
                    continue
                sel = [r for r in base if r["name"] in marcadas]
                ajenas = [r for r in sel if r.get("fuente", "claude") != "claude"
                          or r.get("_sin_proceso")]
                if ajenas:
                    aviso = _("{n} are history, not processes: nothing to close."
                              " Unmark them.", n=len(ajenas))
                    continue
                vivas = sum(1 for r in sel if r["working"])
                verbo_c = _("Discard") if muertas else _("Close")
                muestra = sel[:5]
                alto_c, ancho_c = len(muestra) + 6, min(74, w - 4)
                win = curses.newwin(alto_c, ancho_c, max(0, (h - alto_c) // 2),
                                    max(0, (w - ancho_c) // 2))
                win.box()
                win.addnstr(1, 3, _("{v} {n} session(s):", v=verbo_c, n=len(sel)),
                            ancho_c - 6, curses.A_BOLD)
                for k, rr in enumerate(muestra):
                    marca = " \u25cf" if rr["working"] else "  "
                    win.addnstr(2 + k, 3,
                                "\u00b7 " + recorta(rr["title_full"], ancho_c - 12) + marca,
                                ancho_c - 6, C(1) if rr["working"] else 0)
                if len(sel) > len(muestra):
                    win.addnstr(2 + len(muestra), 5,
                                _("and {n} more", n=len(sel) - len(muestra)),
                                ancho_c - 8, curses.A_DIM)
                if vivas:
                    win.addnstr(alto_c - 3, 3,
                                _("HEADS UP: {n} are working right now", n=vivas),
                                ancho_c - 6, C(2) | curses.A_BOLD)
                win.addnstr(alto_c - 2, 3, _("[y] confirm    [any other key] cancel"),
                            ancho_c - 6, CF(7) | curses.A_BOLD)
                win.refresh()
                win.timeout(-1)
                if tecla_limpia(win) in (ord("s"), ord("S"), ord("y"), ord("Y")):
                    if not ejecutar:
                        res["out"] = ("close", sel)
                        return
                    aviso, todas = ejecutar("close", sel)
                    res["toco"] = True
                    marcadas.clear()
                    ancla, cur, top = None, 0, 0
                    if not todas and not extra:
                        return
                    continue
                aviso = _("Cancelled, nothing was closed.")

    # Limpiar la pantalla ANTES de entrar en curses, no desde dentro: `clearok` deja
    # que curses decida, y lo que quedo escrito en la terminal antes de arrancar
    # sobrevivio igual en la grabacion (una `s` suelta del comando anterior).
    try:
        sys.stdout.write("\033[2J\033[3J\033[H")
        sys.stdout.flush()
    except Exception:
        pass
    try:
        curses.wrapper(run)
    except Exception:
        if _env("DEBUG"):
            raise
        return None
    finally:
        # `endwin()` deshace lo que activo ncurses, no el 1003/1006 que pusimos a
        # mano: sin esto la terminal se queda escupiendo eventos de raton al shell.
        if res.get("ratón"):
            try:
                sys.stdout.write("\033[?1003l\033[?1006l")
                sys.stdout.flush()
            except Exception:
                pass
    # Salir despues de haber hecho algo no es "no hacer nada": quien llama no debe
    # reimprimir la lista vieja ni anunciar "sin cambios".
    return res["out"] or (("hecho", []) if res["toco"] else None)


# ─────────────────── sesiones de los otros CLI de agente ───────────────────
# Claude no es el unico que deja sesiones reanudables por aqui. Estas no viven en
# tmux (no las lanza nuestro wrapper): son historial en disco, se listan como
# muertas y se abren con el `resume` de su propio CLI.
CODEX_INDEX = HOME / ".codex/session_index.jsonl"
CODEX_SESIONES = HOME / ".codex/sessions"
GEMINI_TMP = HOME / ".gemini/tmp"
ANTIGRAVITY = HOME / ".gemini/antigravity-cli/conversations"


def _fila_externa(fuente, sid, titulo, epoch, abrir, cwd=""):
    return {"name": sid, "created": int(epoch or 0), "attached": False,
            "meta": {"cwd": cwd}, "pid": "", "mem_mb": None,
            "title": (titulo[:33] + "\u2026") if len(titulo) > 34 else titulo,
            "title_full": titulo, "idle": max(0, time.time() - epoch) if epoch else None,
            "working": False, "fuente": fuente, "abrir": abrir}


def _iso(ts):
    try:
        return dt_parse(ts)
    except Exception:
        return 0


def dt_parse(ts):
    return datetime.datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()


def sesiones_codex(limite=40):
    """Del indice que Codex ya mantiene: {id, thread_name, updated_at} por linea.

    Se lee el indice y no los 441 rollouts: el fichero por sesion pesa megas y el
    indice trae exactamente titulo y fecha, que es lo unico que se pinta.
    """
    if not CODEX_INDEX.is_file():
        return []
    vistos = {}
    try:
        for linea in _tail(CODEX_INDEX, 512 * 1024).decode("utf-8", "replace").splitlines():
            try:
                j = json.loads(linea)
            except Exception:
                continue
            if j.get("id"):
                vistos[j["id"]] = j
    except Exception:
        return []
    out = []
    for j in vistos.values():
        out.append(_fila_externa("codex", j["id"],
                                 j.get("thread_name") or "(sin nombre)",
                                 _iso(j.get("updated_at") or ""),
                                 ["codex", "resume", j["id"]]))
    out.sort(key=lambda r: -(r["created"] or 0))
    out = out[:limite]
    donde = _cwd_codex([r["name"] for r in out])
    for r in out:
        r["meta"]["cwd"] = donde.get(r["name"], "")
    return out


def _cwd_codex(ids):
    """El directorio de cada sesion de Codex, sacado de la cabecera de su rollout.

    El indice no lo trae, y sin el una fila de Codex no tiene proyecto que pintar ni
    sitio al que relevar: se descarta entera. Esta aqui y no en `sesiones_codex` porque
    solo interesan las filas que se van a pintar — se abren 40 ficheros, no los 699 — y
    de cada uno la PRIMERA linea, que es la cabecera con `payload.cwd`.
    """
    quiero = set(ids)
    if not quiero or not CODEX_SESIONES.is_dir():
        return {}
    # El uuid va al final del nombre (`rollout-<fecha>-<uuid>.jsonl`), asi que se lee
    # del final del `stem` en vez de partir por guiones: la fecha tambien los lleva.
    suyos = {}
    for f in CODEX_SESIONES.glob("*/*/*/rollout-*.jsonl"):
        sid = f.stem[-36:]
        if sid in quiero:
            hay = suyos.get(sid)
            if hay is None or f.stat().st_mtime > hay.stat().st_mtime:
                suyos[sid] = f
    fuera = {}
    for sid, f in suyos.items():
        try:
            with f.open("r", errors="replace") as fh:
                cab = json.loads(fh.readline())
        except Exception:
            continue
        cwd = (cab.get("payload") or {}).get("cwd") or ""
        if cwd:
            fuera[sid] = cwd
    return fuera


def _sesiones_json_dir(fuente, raiz, patron, abrir_cmd, limite=20):
    """Gemini y Antigravity guardan un fichero por conversacion. Hoy sus carpetas
    estan vacias (verificado 2026-08-25); esto las recoge en cuanto escriban algo."""
    if not raiz.is_dir():
        return []
    out = []
    for f in sorted(raiz.glob(patron), key=lambda x: -x.stat().st_mtime)[:limite]:
        titulo = f.stem
        try:
            j = json.loads(f.read_text()[:200000])
            for k in ("title", "name", "summary", "thread_name"):
                if isinstance(j, dict) and j.get(k):
                    titulo = str(j[k])
                    break
        except Exception:
            pass
        out.append(_fila_externa(fuente, f.stem, titulo, f.stat().st_mtime,
                                 abrir_cmd + [f.stem]))
    return out


def sesiones_externas(vistos=()):
    if DEMO:
        return [r for r in sesiones_demo() if r.get("fuente") != "claude"]
    # El historial de Claude va aqui y no en la lista principal a proposito: son
    # sesiones reanudables, no abiertas. Mezclarlas enterraria las cinco que estan
    # vivas bajo cuarenta que no lo estan.
    fuera = [f for f in sesiones_de_disco(vistos=vistos, solo_activas=False, limite=40)
             if f["fuente"] == "historial"]
    fuera += sesiones_codex()
    fuera += _sesiones_json_dir("gemini", GEMINI_TMP, "*/chats/*.json", ["gemini", "--resume"])
    fuera += _sesiones_json_dir("antigravity", ANTIGRAVITY, "*.json", ["antigravity", "resume"])
    return fuera


def orphans():
    if DEMO:
        return []
    if not LIVE.is_dir():
        return []
    entries = [read_entry(f) for f in sorted(LIVE.glob("*.env"))]
    entries = [e for e in entries if e]
    running = {e.get("id") for e in entries if e.get("id") and alive(e.get("pid"))}
    out = []
    for e in entries:
        if alive(e.get("pid")):
            continue
        if e.get("id") in running:      # ya reabierta en otra pestana viva
            continue
        e["_transcript"] = transcript_of(e)
        out.append(e)
    return out


def describe(e):
    sid = e.get("id") or _("(id not resolved)")
    started = e.get("started", "?")
    cwd = e.get("cwd", "?")
    ok = "ok" if e.get("_transcript") else _("NO TRANSCRIPT")
    flags = " ".join(e.get("resume_flags__list") or [])
    extra = f"   flags {flags}" if flags else ""
    line = (f"  {label(e):<34} {sid}  [{ok}]\n"
            + "      cwd " + str(cwd) + "   "
            + _("opened {t}", t=started) + extra)
    if e.get("_transcript"):
        ultimo = last_user_text(e["_transcript"])
        if ultimo and not ultimo.lower().startswith(label(e).rstrip("\u2026").lower()[:24]):
            line += "\n      " + _("last:") + f" {ultimo[:88]}"
    return line


def write_launch_config(items):
    """Las huerfanas son entradas del registro, no filas de la lista: no tienen `meta`
    ni pasan por `_comando_de()`, asi que su comando se compone aqui. El YAML, no."""
    pestanas = []
    for e in items:
        flags = e.get("resume_flags__list") or []
        cmd = " ".join(["claude", "--resume", e["id"]] + [shlex.quote(f) for f in flags])
        pestanas.append((label(e), cmd, e["cwd"]))
    return _escribe_config(CONFIG_NAME, pestanas), pestanas


def archive(items, folder):
    dest = ROOT / folder / time.strftime("%Y%m%d-%H%M%S")
    dest.mkdir(parents=True, exist_ok=True)
    for e in items:
        try:
            shutil.move(str(e["_file"]), str(dest / e["_file"].name))
        except OSError:
            pass
    return dest


def cmd_add(argv):
    sid = argv[0]
    cwd = str(pathlib.Path.cwd())
    title = None
    i = 1
    while i < len(argv):
        if argv[i] == "--cwd":
            cwd = argv[i + 1]; i += 2
        elif argv[i] == "--title":
            title = argv[i + 1]; i += 2
        else:
            i += 1
    proj = "".join(c if c.isalnum() else "-" for c in cwd)
    LIVE.mkdir(parents=True, exist_ok=True)
    f = LIVE / f"manual-{sid[:8]}-{int(time.time())}.env"
    f.write_text(
        f"id={shlex.quote(sid)}\n"
        f"cwd={shlex.quote(cwd)}\n"
        f"project_dir={shlex.quote(str(HOME / '.claude/projects' / proj))}\n"
        "pid=\n"
        f"started={shlex.quote(datetime.datetime.now().astimezone().strftime('%Y-%m-%dT%H:%M:%S%z'))}\n"
        f"title={shlex.quote(title or pathlib.Path(cwd).name)}\n"
        f"title_explicit={'1' if title else ''}\n"
    )
    print(_("registered {s} -> {f}", s=sid, f=f.name))


