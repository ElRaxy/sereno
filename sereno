# El dia empieza a las cinco de la manana y no a medianoche, a proposito: quien cierra a
# la una y media pregunta por el trabajo que acaba de hacer, y un corte a las 00:00 le
# contestaria con una jornada vacia justo cuando mas la mira.
HORA_JORNADA = 5
# Las columnas, aqui arriba: son formato y no frase, y en el cuerpo las confundiria con
# texto que deberia pasar por `_()` — lo vigila `tests/test_i18n.py`.
# Rejilla propia y no la de `--disk`: alli el numero son ficheros (tres cifras) y va
# seguido de un peso, aqui son sesiones (una cifra) y la fila quedaba con treinta
# columnas de blanco en medio. Misma familia, distinta medida.
_FILA_HOY_PROY = "  %-26s %3s  %10s%s"
_FILA_HOY_ABIERTA = "  %s %s %s%s %9s%s"


def corte_jornada(ahora=None):
    """El epoch en que empezo la jornada de `ahora`. `SERENO_JORNADA=7` mueve la hora."""
    crudo = _env("JORNADA")
    hora = int(crudo) if crudo.isdigit() and 0 <= int(crudo) <= 23 else HORA_JORNADA
    t = datetime.datetime.fromtimestamp(ahora if ahora is not None else time.time())
    inicio = t.replace(hour=hora, minute=0, second=0, microsecond=0)
    if t < inicio:                      # antes de la hora de corte, el dia es el de ayer
        inicio -= datetime.timedelta(days=1)
    return inicio.timestamp()


def jornada(corte=None, ahora=None):
    """Hechos de lo tocado desde que empezo el dia. Observa; no juzga y no formatea.

    Igual que `peso_historial`, y por lo mismo (`.claude/rules/llm-decision-boundary`):
    aqui solo salen cifras y enums, y quien decide que pintar es `cmd_hoy`. El filtro por
    mtime va ANTES de abrir nada: de 877 transcripts, un dia normal toca menos de veinte,
    y leer la cola de los otros 857 para tirarla seria el barrido que `sesiones_de_disco`
    ya evita.
    """
    corte = corte_jornada(ahora) if corte is None else corte
    fuera = {"corte": corte, "sesiones": [], "por_proyecto": [], "a_medias": [],
             "n_sesiones": 0, "n_proyectos": 0, "primera": None, "ultima": None}
    if DEMO or not PROJECTS.is_dir():
        return fuera
    cands = []
    for p in PROJECTS.glob("*/*.jsonl"):        # sin `**`: los subagentes no son sesiones
        if not _UUID.match(p.stem):
            continue
        if de_usar_y_tirar(_proyecto_de_dir(p.parent.name)):
            continue                            # lo que nacio para tirarse no es trabajo
        try:
            mt = p.stat().st_mtime
        except OSError:
            continue
        if mt >= corte:
            cands.append((mt, p))
    cands.sort(reverse=True)
    por_proy = {}
    for mt, p in cands:
        r = fila_de_transcript(p, mt)
        pu = r.get("pulso") or {}
        ctx = pu.get("ctx")
        u = uso_de(r) if USO else None
        s = {
            "id": p.stem,
            "titulo": r.get("title_full") or "",
            "proyecto": r.get("proyecto") or "",
            "estado": estado_estable(r),
            "idle": round(r["idle"]) if r.get("idle") is not None else None,
            "ctx": ctx,
            "ctx_max": tope_contexto(pu.get("modelo"), ctx, pu.get("ventana_1m"),
                                     pico_de(r)) if ctx else None,
            # `None` y no cero cuando no se midio: sin `--usage` nadie ha leido el
            # transcript entero, y un cero ahi se leeria como "no trabajo".
            "turnos": u["turnos"] if u else None,
            "activo": round(u["activo"]) if u else None,
            "compacta": u["compacta"] if u else None,
        }
        fuera["sesiones"].append(s)
        d = por_proy.setdefault(s["proyecto"], {"proyecto": s["proyecto"], "sesiones": 0,
                                                "idle": None, "turnos": None,
                                                "activo": None})
        d["sesiones"] += 1
        if s["idle"] is not None:
            d["idle"] = s["idle"] if d["idle"] is None else min(d["idle"], s["idle"])
        for campo in ("turnos", "activo"):
            if s[campo] is not None:
                d[campo] = (d[campo] or 0) + s[campo]
    fuera["n_sesiones"] = len(fuera["sesiones"])
    fuera["por_proyecto"] = sorted(por_proy.values(),
                                   key=lambda d: (-d["sesiones"], d["proyecto"]))
    fuera["n_proyectos"] = len(fuera["por_proyecto"])
    # A medias = lo que al cerrar el dia sigue esperandote o con un comando a medio
    # correr. El umbral NO se pone aqui: `estado_estable` ya separa lo que te espera de
    # lo que se dio por parado, y meter un segundo corte daria dos respuestas distintas a
    # la misma pregunta segun por donde se mire — que es lo que este programa existe para
    # no hacer.
    # Lo que trabaja va primero y lo demas por lo mas reciente. Sin orden, la lista
    # sale en el del `mtime` de los ficheros y mezcla las dos cosas: al cerrar el dia
    # lo que se mira es que sigue en marcha, no en que orden se toco el disco.
    fuera["a_medias"] = sorted(
        [s for s in fuera["sesiones"]
         if s["estado"] in ("waiting", "writing", "in_command")],
        key=lambda s: (s["estado"] == "waiting", s["idle"] if s["idle"] is not None else 1e9))
    if cands:
        fuera["primera"], fuera["ultima"] = cands[-1][0], cands[0][0]
    return fuera


def _hora(epoch):
    return time.strftime("%H:%M", time.localtime(epoch)) if epoch else ""


def cmd_hoy(tope=10):
    """Imprime lo que `jornada()` observo. Solo formatea: no vuelve a mirar nada."""
    j = jornada()
    if not j["n_sesiones"]:
        print(_("Nothing touched since {h}.", h=_hora(j["corte"])))
        return 1
    # Una y muchas son dos cadenas, como en el resto de la interfaz desde la 1.29.0:
    # "1 sesion(es)" delata que nadie lo leyo.
    ses = (_("one session") if j["n_sesiones"] == 1
           else _("{n} sessions", n=j["n_sesiones"]))
    proy = (_("one project") if j["n_proyectos"] == 1
            else _("{n} projects", n=j["n_proyectos"]))
    print(_("Today \u00b7 since {h} \u00b7 {s} in {p}",
            h=_hora(j["corte"]), s=ses, p=proy))
    print("  " + _("first at {a}, last at {b}",
                   a=_hora(j["primera"]), b=_hora(j["ultima"])))
    print()
    print(_("by project"))
    for d in j["por_proyecto"][:tope]:
        cola = ""
        if d["turnos"] is not None:
            cola = "   " + _("{n} replies", n=d["turnos"])
            if d["activo"]:
                cola += " \u00b7 " + _dur(d["activo"])
        print(_FILA_HOY_PROY % (recorta(d["proyecto"] or "?", 26), d["sesiones"],
                                _hace(d["idle"]) if d["idle"] is not None else "", cola))
    resto = j["n_proyectos"] - len(j["por_proyecto"][:tope])
    if resto > 0:
        print("  " + _("and {n} more projects", n=resto))
    if j["a_medias"]:
        print()
        print(_("still open"))
        muestra = j["a_medias"][:tope]
        # El titulo se rellena a lo que mide el mas largo de los que se van a pintar, no
        # a un 38 fijo: con titulos cortos, ese numero abria un rio de blanco hasta el
        # estado. Suelo y techo para que la columna no baile de una ejecucion a otra.
        ancho_t = max(24, min(44, max(ancho(s["titulo"] or s["id"][:8])
                                      for s in muestra)))
        # El proyecto solo cuando la jornada toco mas de uno: repetir el mismo nombre en
        # todas las lineas es tinta que no distingue nada.
        con_proy = j["n_proyectos"] > 1
        for s in muestra:
            pct = "  %3d%%" % round(100 * s["ctx"] / s["ctx_max"]) if s["ctx"] and s["ctx_max"] else ""
            titulo = recorta(s["titulo"] or s["id"][:8], ancho_t)
            # Cada cosa en SU columna: pegar el proyecto delante del estado en un solo
            # campo relleno hacia el mensaje bailando segun lo largo que fuera el nombre.
            proy = (rellena(recorta(s["proyecto"] or "", 14), 16) if con_proy else "")
            print(_FILA_HOY_ABIERTA % (
                ICONO.get(s["estado"], "?"), rellena(titulo, ancho_t), proy,
                rellena(ESTADO_LARGO(s["estado"]), 16),
                _hace(s["idle"]) if s["idle"] is not None else "", pct))
    if not USO:
        print()
        print("  " + _("`{p} --hoy --usage` adds what each project burned "
                       "(reads whole transcripts)", p=PROG))
    return 0


def _peso(b):
    """Bytes legibles. No se reusa `_mb`: redondea a entero porque nacio para la columna
    de RAM, donde 0,8 MB no existe — aqui hay proyectos de 800 KB y salian como "0 MB",
    que ademas es lo que se lee como "no ocupa nada" justo cuando se esta contando peso.
    """
    if b >= 1024 ** 3:
        return "%.1f GB" % (b / 1024 ** 3)
    if b >= 1024 ** 2:
        return "%.1f MB" % (b / 1024 ** 2)
    return "%d KB" % max(1, b // 1024)


def cmd_disk(tope=8):
    """Imprime lo que `peso_historial()` observo. Solo formatea: no vuelve a mirar nada."""
    h = peso_historial()
    if not h["sesiones"]:
        print(_("No transcripts in {d}", d=h["raiz"]))
        return 1
    print(_("{mb} in {n} sessions · {d}",
            mb=_peso(h["bytes"]), n=h["sesiones"], d=h["raiz"]))
    if h["subagentes"]:
        print(_("  plus {n} subagent transcripts, {mb}",
                n=h["subagentes"], mb=_peso(h["bytes_subagentes"])))
    if h["de_usar_y_tirar"]:
        print(_("  plus one throwaway session born in a temp dir, {mb}",
                mb=_peso(h["bytes_de_usar_y_tirar"])) if h["de_usar_y_tirar"] == 1 else
              _("  plus {n} throwaway sessions born in a temp dir, {mb}",
                n=h["de_usar_y_tirar"], mb=_peso(h["bytes_de_usar_y_tirar"])))
    print()
    print(_("by project"))
    # La cola se resume en una linea. Sin esto, en esta maquina cinco de las ocho lineas
    # eran proyectos de un fichero suelto diciendo "0 KB": ordenar por peso los pone ahi
    # porque no hay mas, y el reparto que se venia a ver quedaba escondido entre ceros.
    gordos = [e for e in h["por_proyecto"] if e["bytes"] >= h["bytes"] // 100][:tope]
    for e in gordos:
        cola = ("   " + _("({mb} with nowhere to go back to)", mb=_peso(e["bytes_sin_sitio"]))
                if e["bytes_sin_sitio"] else "")
        linea = _FILA_PROY % (e["proyecto"][:30], e["ficheros"], _peso(e["bytes"]), cola)
        print(linea)
    resto_n = h["proyectos"] - len(gordos)
    resto_b = h["bytes"] - sum(e["bytes"] for e in gordos)
    if resto_n > 0:
        print("  " + _("and {n} more projects, {mb} between them",
                       n=resto_n, mb=_peso(resto_b)))
    print()
    print(_("the heaviest sessions"))
    for e in h["mayores"][:tope]:
        marca = "  " + _("no place to go back to") if e["sin_sitio"] else ""
        linea = _FILA_SES % (_peso(e["bytes"]),
                             _hace(e["idle"]) if e["idle"] is not None else "",
                             e.get("titulo") or "", e["id"][:8], marca)
        print(linea)
    if h["sin_sitio"]:
        print()
        print(_("{n} of them ({mb}) have no place to go back to.",
                n=h["sin_sitio"], mb=_peso(h["bytes_sin_sitio"])))
    # Lo que faltaba: el numero de arriba dice lo que OCUPA, no lo que ganarias. Los
    # tramos van anidados y de mas reciente a mas viejo, que es como se lee la pregunta
    # de verdad — "y si apuro un poco mas, cuanto mas".
    hay = [e for e in h["por_edad"] if e["sesiones"]]
    if hay:
        print()
        print(_("what you would get back, by how long untouched"))
        for e in hay:
            print(_FILA_EDAD % (_("over {n}d", n=e["dias"]), e["sesiones"],
                                _peso(e["bytes"])))
        # Dicho una vez y sin adornos: este comando informa y no borra nada, pero quien
        # lo lee esta a punto de borrar a mano, y una sesion sin transcript no vuelve.
        print("  " + (_("each tier includes the ones below \u00b7 deleting a "
                        "transcript takes that session out of --resume for good")
                      if len(hay) > 1 else
                      _("deleting a transcript takes that session out of --resume "
                        "for good")))
    return 0


def _parecido(malo):
    """El flag conocido mas cercano, o "". Sin `difflib`: la lista de imports cabe en
    una linea del README y es media promesa del proyecto.

    Dos reglas, porque los dos typos frecuentes no se parecen entre si. Una letra de
    mas o cambiada conserva el prefijo (`--jsonn`, `--wach`); una letra omitida lo
    rompe pero deja el resto en orden (`--lst` dentro de `--list`).
    """
    def prefijo(a, b):
        n = 0
        while n < min(len(a), len(b)) and a[n] == b[n]:
            n += 1
        return n

    def cabe_dentro(corto, largo):
        i = 0
        for c in largo:
            if i < len(corto) and corto[i] == c:
                i += 1
        return i == len(corto)

    # Cuatro: los dos guiones y dos letras. Con tres, `--frobnicate` sugeria `--find`
    # por compartir solo la efe, y una sugerencia mala estorba mas que ninguna.
    mejor = max(_FLAGS, key=lambda f: prefijo(f, malo))
    if prefijo(mejor, malo) >= 4:
        return mejor
    dentro = [f for f in _FLAGS if len(malo) >= 4 and cabe_dentro(malo, f)]
    return min(dentro, key=len) if dentro else ""


def flags_desconocidos(argv):
    fuera, saltar = [], 0
    for a in argv:
        if saltar:
            saltar -= 1
            continue
        if a.startswith("-") and a != "-":
            if a in _FLAGS:
                saltar = _FLAGS[a]
            else:
                fuera.append(a)
    return fuera


def nada_que_ensenar():
    """Que decir cuando no hay ni una sesion. Es la primera pantalla de mucha gente.

    "No sessions" a secas no distingue "aun no has abierto ninguna" de "esto no
    funciona en tu maquina", y quien acaba de instalarlo asume lo segundo. Si ni
    siquiera existe la carpeta que escribe el CLI, eso es un diagnostico y hay que
    darlo: casi siempre significa que Claude Code no ha corrido nunca aqui.
    """
    if not DEMO and not PROJECTS.is_dir():
        return (_("No sessions, and {d} does not exist.", d="~/.claude/projects")
                + "\n  " + _("That folder is written by Claude Code itself, so this "
                             "looks like a machine where it has not run yet.")
                + "\n  " + _("Try `{p} --demo` to see what this does.", p=PROG))
    return (_("No sessions running and none orphaned.")
            + "\n  " + _("Open one with `claude` and run `{p}` again.", p=PROG))


def main():
    argv = sys.argv[1:]
    if "--demo" in argv:
        # La variable de entorno escrita corta. Se toca la global en vez de reejecutar
        # el proceso: un `execv` perderia el nombre con el que te invocaron, y todos
        # los mensajes que lo nombran empezarian a mentir.
        global DEMO
        DEMO = True
        os.environ["SERENO_DEMO"] = "1"
        argv = [a for a in argv if a != "--demo"]
    if "--usage" in argv:
        # Igual que `--demo`: se toca la global en vez de encadenar el flag por seis
        # sitios distintos. El acumulado cuesta el transcript entero y por eso se pide.
        global USO
        USO = True
        argv = [a for a in argv if a != "--usage"]
    for malo in flags_desconocidos(argv):
        cerca = _parecido(malo)
        print(_("unknown option: {f}", f=malo)
              + (" " + _("Did you mean {g}?", g=cerca) if cerca else "")
              + "  " + _("`{p} --help` lists them all.", p=PROG))
        return 2
    if {"-h", "--help"} & set(argv):
        # El docstring ES la ayuda: dos textos que decir lo mismo acaban diciendo
        # cosas distintas, y el que se queda viejo siempre es el de --help.
        print((__doc__ or "").strip().replace("sereno ", PROG + " ", 1)
              .replace("\n  sereno ", "\n  " + PROG + " "))
        return 0
    if "--version" in argv:
        print(f"{PROG} {VERSION}")
        return 0
    if argv and argv[0] == "--add":
        return cmd_add(argv[1:])

    if "--dismiss" in argv:
        # Aqui arriba y no abajo con el resto de lo que hace el registro: descartar
        # huerfanas es tirar entradas cuyo PROCESO ESTA MUERTO, y eso no depende de que
        # ademas haya sesiones vivas. Cuando vivia abajo, la rama de las vivas se comia
        # el flag: con una sola sesion abierta —o sea, siempre— `--dismiss` imprimia la
        # lista de vivas y salia con 0 **sin descartar nada**. Un flag que se traga en
        # silencio es peor que uno que no existe: el que no existe se dice.
        muertas = orphans()
        if not muertas:
            print(_("Nothing to discard: no entry has lost its process."))
            return 0
        archive(muertas, "dismissed")
        # Una y muchas son dos cadenas, como en el resto de la interfaz desde la 1.29.0:
        # "Descartadas 1 entradas" delata que nadie lo leyo.
        print(_("Discarded one entry.") if len(muertas) == 1
              else _("Discarded {n} entries.", n=len(muertas)))
        return 0

    if "--disk" in argv:
        return cmd_disk()

    if "--now" in argv:
        return cmd_now()

    if "--hoy" in argv or "--today" in argv:
        return cmd_hoy()

    if "--find" in argv:
        i = argv.index("--find")
        aguja = argv[i + 1] if len(argv) > i + 1 else ""
        if len(aguja) < 2:
            print(_("--find takes something to look for, 2 characters or more."))
            return 2
        res = buscar(aguja, todo="--all" in argv)
        if not res:
            print(_("Nothing said about \u201c{q}\u201d in the transcripts searched.",
                    q=aguja))
            return 1
        print_hallazgos(res, aguja)
        # Y despues el selector con SOLO esas: encontrarla es la mitad, lo que quieres
        # es volver a ella. Al salir con `q` el listado sigue ahi arriba.
        if sys.stdin.isatty() and "--list" not in argv:
            accion = pick_ui([f for f, _a in res], vista_inicial="todas")
            if accion and accion[0] == "open":
                return abrir_sesion(accion[1][0])
        return 0

    if "--watch" in argv:
        cada = 20
        if "--every" in argv:
            v = argv[argv.index("--every") + 1] if len(argv) > argv.index("--every") + 1 else ""
            if v.isdigit() and int(v) >= 2:
                cada = int(v)
            else:
                print(_("--every takes a number of seconds, 2 or more."))
                return 2
        return watch(cada)

    hook = "--hook" in argv
    if DEMO:
        # Nada de esto toca la maquina: ni tmux, ni Warp, ni el registro.
        if hook:
            hook_line(live_sessions(), None)
            return 0
        if "--json" in argv:
            print_json(sesiones_demo())
            return 0
        if "--list" in argv or not sys.stdin.isatty():
            print_live(sesiones_demo())
            return 0
        # Al selector van SOLO las vivas, como en el flujo real: pasarle tambien las
        # reanudables las duplicaba en cuanto TAB cargaba `extra`.
        # `donde` con valor por defecto: el selector lo pasa desde que `r` pregunta en
        # que terminal abrir, y un lambda de dos parametros reventaba la demo entera.
        pick_ui(live_sessions(), ejecutar=lambda verbo, sel, donde=None: (
            _("{n} closed and archived. The history is still on disk.", n=len(sel))
            if verbo == "close" else _("{n} reattached with {v}",
                                       n=len(sel), v=donde or "demo"), live_sessions()),
                recargar=live_sessions)
        return 0
    rows = live_sessions()

    # ── parar ──
    if "--stop-all" in argv:
        if not rows:
            print(_("No sessions running."))
            return 0
        tmux_kill()
        # Tambien por aqui: parar sin apuntarlo las devuelve desde el disco, y estas
        # dos rutas no pasan por `stop_rows`.
        apunta_cerradas([c for r in rows for c in _claves_de(r)])
        print(_("Stopped {n} sessions.", n=len(rows)))
        return 0
    if "--stop" in argv:
        name = argv[argv.index("--stop") + 1]
        tmux_kill(name)
        apunta_cerradas([c for r in rows if r["name"] == name for c in _claves_de(r)])
        print(_("Stopped {s}.", s=name))
        return 0
    for flag, forget in (("--close-sel", True), ("--stop-sel", False)):
        if flag in argv:
            try:
                expr = argv[argv.index(flag) + 1]
            except IndexError:
                print(_("{flag} needs a selection (e.g. \"1,4-6\" or \"idle\")", flag=flag))
                return 2
            idx = parse_sel(expr, rows)
            if idx is None:
                print(_("I don't understand that selection: {e}", e=expr))
                return 2
            n = stop_rows([rows[i] for i in idx], forget)
            print(_("{n} stopped and archived.", n=n) if forget
                  else _("{n} stopped.", n=n))
            return 0

    # ── sesiones vivas en tmux: siguen corriendo con Warp cerrado ──
    if rows:
        if hook:
            hook_line(rows, None)      # al abrir terminal: una linea, no un menu
            return 0

        if "--json" in argv:
            # Por defecto salen las vivas, que es lo que pinta la pestana de arranque.
            # `--all` anade el historial reanudable, el equivalente de pulsar TAB: una
            # statusline que solo cuenta lo vivo dice "ninguna" con seis esperandote.
            print_json(live_sessions(con_ram=True, solo_activas="--all" not in argv))
            return 0

        ejecutando = sum(1 for r in rows if r["working"])
        cabecera = ("\n\033[1m" + _("{n} Claude session(s) still running", n=len(rows))
                    + (" \u2014 " + _("{n} running something right now", n=ejecutando)
                       if ejecutando else "") + ":\033[0m")
        sueltas = [r for r in rows if not r["attached"]]

        if "--list" in argv:
            rows = live_sessions(con_ram=True)   # listar a mano si admite el coste
            print(cabecera)
            print_live(rows)
            return 0

        if "--yes" in argv:
            if not sueltas:
                print(cabecera); print_live(rows)
                print("\n  " + _("They all already have a tab open."))
                return 0
            return reopen(sueltas)

        if not sys.stdin.isatty():
            print(cabecera)
            print_live(rows)
            print("\n  " + _("Run `{p}` to manage them.", p=PROG))
            return 0

        rows = live_sessions(con_ram=True)      # el TUI si pinta RAM y titulos finos

        def ejecutar(verbo, sel, donde=None):
            """Hace el trabajo y devuelve la lista fresca, sin salir del selector."""
            if verbo == "close":
                n = stop_rows(sel, forget=True)
                aviso = _("{n} closed and archived. The history is still on disk.", n=n)
            else:
                # Esta era la CUARTA copia del `open` a pelo, y la mas usada: la tecla
                # `r` del selector. Por aqui no pasaban ni la guarda de la 1.24.0 ni los
                # lanzadores de la 1.25.0, asi que seguia reventando fuera de macOS y
                # anunciando las pestanas pedidas en vez de las abiertas.
                pestanas, _sf = pestanas_de(sel)
                _escribe_config(CONFIG_NAME, pestanas)
                cual, hechas = abre_varias(pestanas, CONFIG_NAME, donde)
                aviso = (_("{n} reattached with {v}", n=hechas, v=cual) if hechas
                         else _("Nothing here can open several at once: "
                                "no Warp, no tmux around, no Terminal.app."))
            return aviso, live_sessions(con_ram=True)

        accion = pick_ui(rows, ejecutar=ejecutar,
                         recargar=lambda: live_sessions(con_ram=True))
        if accion is None:          # salio con q, o el terminal no admite el selector
            print(cabecera)
            print_live(rows)
            print("\n  " + _("No changes."))
            return 0
        verbo, sel = accion
        if verbo == "hecho":
            return 0
        if verbo == "open":
            return abrir_sesion(sel[0])
        if verbo == "reopen":
            return reopen(sel)
        n = stop_rows(sel, forget=True)
        print("\n" + _("{n} session(s) closed. Their history is still on disk:"
                        " `claude-sessions --list` won't list them again, but"
                        " `claude --resume <id>` brings them back.", n=n))
        return 0

    # ── sin tmux vivo: quedan las que murieron de verdad (o son pre-tmux) ──
    items = orphans()

    # Sin registro y sin tmux —una maquina donde nadie instalo nuestro wrapper— el
    # historial de `~/.claude/projects` es TODO lo que hay, y lo escribe el propio CLI.
    # Antes se contestaba "no hay sesiones" teniendo cuarenta reanudables delante.
    if not items:
        hist = sesiones_de_disco(limite=40)
        if hist:
            if hook or not sys.stdin.isatty():
                return 0           # al abrir terminal no se avisa de historial viejo
            if "--json" in argv:
                print_json(hist)
                return 0
            if "--list" in argv:
                print("\n\033[1m" + _("{n} resumable session(s):", n=len(hist)) + "\033[0m")
                print_live(hist)
                return 0
            accion = pick_ui(hist, recargar=lambda: sesiones_de_disco(limite=40))
            if accion and accion[0] == "open":
                return abrir_sesion(accion[1][0])
            return 0

    resumable = [e for e in items if e.get("id") and e.get("_transcript")]

    if "--json" in argv:
        print_json([fila_de_huerfana(e) for e in items])
        return 0

    if "--list" in argv:
        if not items:
            print(nada_que_ensenar())
        for e in items:
            print(describe(e))
        return 0

    if not items:
        if not hook:
            print(nada_que_ensenar())
        return 0

    if hook:
        hook_line(None, items)
        return 0

    cabecera = ("\n\033[1m" + _("{n} session(s) died without leaving a process "
                                 "(resumable from their transcript):", n=len(items))
                + "\033[0m")

    skipped = [e for e in items if e not in resumable]
    if not resumable:
        print(cabecera)
        for e in items:
            print(describe(e))
        print("\n  " + _("None can be resumed (no id or no transcript); discarding them."))
        archive(items, "dismissed")
        return 0

    if "--yes" not in argv and sys.stdin.isatty():
        # Mismo selector que para las vivas: marcar = quitarlas de en medio,
        # r = reanudarlas. Un apagon deja aqui una lista larga y no todas interesan.
        def ejecutar_h(verbo, sel):
            elegidas = [r["meta"] for r in sel]
            if verbo == "close":
                archive(elegidas, "dismissed")
                aviso = _("{n} discarded: they will not be offered again.", n=len(elegidas))
            else:
                _path, pestanas = write_launch_config(elegidas)
                # Se archiva DESPUES de abrir, y solo si se abrio. Al reves —como estaba—
                # un `open` que falla dejaba las huerfanas marcadas como restauradas: no
                # se abrian y ademas dejaban de ofrecerse, que es perderlas.
                cual, hechas = reanuda(pestanas, CONFIG_NAME, elegidas)
                if hechas:
                    aviso = _("{n} resumed with {v}", n=hechas, v=cual)
                else:
                    aviso = _("Nothing here can open several at once: "
                              "no Warp, no tmux around, no Terminal.app.")
            quedan = [e for e in orphans() if e.get("id") and e.get("_transcript")]
            return aviso, [fila_de_huerfana(e) for e in quedan]

        accion = pick_ui([fila_de_huerfana(e) for e in resumable], muertas=True, ejecutar=ejecutar_h)
        if accion is None:
            print(cabecera)
            for e in items:
                print(describe(e))
            print("\n  " + _("No changes. Run `{p}` to come back.", p=PROG))
            return 0
        verbo, sel = accion
        if verbo == "hecho":
            return 0
        if verbo == "open":
            return abrir_sesion(sel[0])
        elegidas = [r["meta"] for r in sel]
        if verbo == "close":
            archive(elegidas, "dismissed")
            print("\n" + _("{n} discarded: they will not be offered again. Their history "
                            "is still on disk (`claude --resume <id>`).", n=len(elegidas)))
            return 0
        resumable = elegidas
    elif "--yes" not in argv:
        print(cabecera)
        for e in items:
            print(describe(e))
        print("\n  " + _("(not a terminal: nothing reopened. `{p} --yes` forces it)", p=PROG))
        return 0

    path, pestanas = write_launch_config(resumable)
    cual, hechas = reanuda(pestanas, CONFIG_NAME, resumable + skipped)
    if not hechas:
        # Sin abrir no se archiva: si se archivara, estas huerfanas no volverian a
        # ofrecerse y no se habria reanudado ninguna.
        print("\n" + _("Nothing here can open several at once: "
                       "no Warp, no tmux around, no Terminal.app."))
        print(_("One at a time does work: ENTER on each one."))
        return 1
    print("\n" + _("Opening {n} tabs with {v} -> {p}", n=hechas, v=cual, p=path))
    return 0


if __name__ == "__main__":
    sys.exit(main())
