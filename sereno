# ─────────────────────────── idioma de la interfaz ───────────────────────────
# Se traduce lo que sale por pantalla; los comentarios y los nombres de variables se
# quedan en castellano a proposito: reescribirlos no ayuda a nadie y se pierde matiz.
# La CLAVE es la cadena inglesa, asi que una cadena sin traducir sale en ingles — no
# revienta ni deja un identificador crudo delante del usuario.
_IDIOMAS = ("en", "es")


def _detecta_idioma():
    """`CLAUDE_SESSIONS_LANG` manda; si no, el locale; si no, ingles.

    En macOS hay que preguntarle a `defaults`: la terminal suele traer `LANG=C.UTF-8`
    —medido en esta maquina— y por ahi no se distingue un espanol de un japones.
    """
    v = _env("LANG")[:2].lower()
    if v in _IDIOMAS:
        return v
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        v = os.environ.get(var, "")[:2].lower()
        if v in _IDIOMAS:
            return v
    if sys.platform == "darwin":
        try:
            v = subprocess.run(["defaults", "read", "-g", "AppleLocale"],
                               capture_output=True, text=True, timeout=3).stdout[:2].lower()
            if v in _IDIOMAS:
                return v
        except Exception:
            pass
    return "en"


LANG_UI = _detecta_idioma()
TEXTOS = {"es": {}}          # lo rellena _T() al final del fichero


def _(clave, **kw):
    t = TEXTOS.get(LANG_UI, {}).get(clave, clave)
    return t.format(**kw) if kw else t


def read_entry(path):
    data = {}
    try:
        for line in path.read_text().splitlines():
            if "=" not in line:
                continue
            k, v = line.split("=", 1)
            try:
                parts = shlex.split(v)
            except ValueError:
                parts = [v]
            key = k.strip()
            data[key] = parts[0] if parts else ""
            data[key + "__list"] = parts
    except OSError:
        return None
    data["_file"] = path
    return data


def alive(pid):
    """Vivo = el PID existe Y su linea de comando menciona claude (evita reuso de PID)."""
    if not pid or not str(pid).isdigit() or int(pid) <= 1:
        return False
    try:
        os.kill(int(pid), 0)
    except (OSError, ProcessLookupError, PermissionError):
        return False
    try:
        out = subprocess.run(["ps", "-p", str(pid), "-o", "command="],
                             capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return True  # si no se puede comprobar, no la tratamos como muerta
    return "claude" in out


def transcript_of(e):
    pd, sid = e.get("project_dir"), e.get("id")
    if not pd or not sid:
        return None
    p = pathlib.Path(pd) / f"{sid}.jsonl"
    return p if p.is_file() else None


# El sucesor de una sesion reanudada, cacheado por (id, mtime del que ya conocemos).
_SUCESOR = {}
_CABECERA = 1024 * 1024


def transcript_vivo(e):
    """El fichero que la sesion esta escribiendo AHORA, no el que registro al nacer.

    El registro guarda el sessionId de arranque. Una sesion reanudada (`--continue`,
    `--resume`) empieza un fichero NUEVO con otro id y el registro no se entera, asi
    que la fila se quedaba congelada en la ultima actividad del fichero viejo. Visto
    el 2026-08-26 sobre una sesion que llevaba seis minutos trabajando: figuraba
    parada desde hacia tres horas, y su contexto decia 12% mientras el propio CLI
    mostraba 41%. Los dos sintomas, una sola causa.

    El enlace es exacto y no hay que adivinarlo por fechas: al reanudar, el transcript
    nuevo COPIA las lineas del viejo, y esas lineas conservan su `session_id` original
    (con guion bajo) aunque el `sessionId` de la linea sea ya el nuevo. Buscar esa
    firma en la cabecera identifica al sucesor sin ambiguedad.

    Solo se busca cuando el registrado lleva rancio: mientras la sesion escriba donde
    dice el registro, no hay nada que resolver. Acotado al directorio del proyecto y a
    ficheros mas nuevos que el registrado, son 8 ms.
    """
    p = transcript_of(e)
    if p is None:
        return None
    try:
        mt = p.stat().st_mtime
    except OSError:
        return p
    if time.time() - mt <= VIVA:
        return p                       # sigue escribiendo ahi: nada que buscar

    sid = e.get("id")
    clave = (sid, mt)
    if clave in _SUCESOR:
        return _SUCESOR[clave] or p
    firma = f'"session_id":"{sid}"'.encode()
    firma_esp = f'"session_id": "{sid}"'.encode()
    mejor = None
    try:
        for otro in p.parent.glob("*.jsonl"):
            if otro == p or not _UUID.match(otro.stem):
                continue
            try:
                omt = otro.stat().st_mtime
                if omt <= mt or (mejor and omt <= mejor[0]):
                    continue           # un sucesor es por fuerza mas nuevo
                with open(otro, "rb") as f:
                    cab = f.read(_CABECERA)
            except OSError:
                continue
            if firma in cab or firma_esp in cab:
                mejor = (omt, otro)
    except OSError:
        pass
    if len(_SUCESOR) > 200:
        _SUCESOR.clear()               # la clave lleva mtime: crece sin tope
    _SUCESOR[clave] = mejor[1] if mejor else None
    return mejor[1] if mejor else p


_SALUDO = re.compile(
    r"^(hola|buenas|buenos d[ií]as|buenas tardes|buenas noches|oye|vale|okey|ok|"
    r"perfecto|gracias)[\s,.:;!¡-]*", re.I)


def _strip_saludo(t):
    prev = None
    while t and t != prev:          # "Buenas, hola oye ..." se pela en varias vueltas
        prev = t
        t = _SALUDO.sub("", t, count=1).lstrip()
    return t or prev or ""


# ───────────────────────────── capa tmux ─────────────────────────────
# Con tmux debajo, "que sesiones siguen vivas" ya no se deduce de PIDs muertos:
# lo dice `tmux list-sessions`. El registro solo aporta metadatos (titulo, flags).
TMUX_BIN = shutil.which("tmux") or "/opt/homebrew/bin/tmux"
# Socket parametrizable: el valor real es "claude-code"; la variable solo existe
# para poder probar este script contra un servidor tmux de juguete.
SOCK = _env("TMUX_SOCK", "claude-code")


# Titulos que el binario emite cuando no tiene nada mejor: no identifican nada.
_TITULO_GENERICO = {"", "claude code", "claude", "zsh", "bash", "-zsh", "tmux"}


def tmux_list():
    """[(nombre, creada, enganchada, titulo, pid)] de las sesiones vivas.

    `pane_title` es la via buena para el titulo: Claude Code emite ahi el nombre
    de `/rename` (y si no, su aiTitle), asi que sale en vivo y sin abrir ningun
    fichero. Se pide con list-panes porque list-sessions no expone pane_title;
    de una sesion con varios paneles vale el primero.
    """
    if not pathlib.Path(TMUX_BIN).exists():
        return []
    try:
        r = subprocess.run(
            [TMUX_BIN, "-L", SOCK, "list-panes", "-a", "-F",
             "#{session_name}\t#{session_created}\t#{session_attached}"
             "\t#{pane_title}\t#{pane_pid}"],
            capture_output=True, text=True, timeout=10)
    except Exception:
        return []
    if r.returncode != 0:
        return []                      # sin servidor = sin sesiones, no es error
    out, vistas = [], set()
    for line in r.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 5 or parts[0] in vistas:
            continue
        vistas.add(parts[0])
        titulo = parts[3].lstrip("\u2733\u2734\u2735* ").strip()
        # Un panel que aun no ha emitido titulo propio se queda con el hostname:
        # El hostname por defecto de un portatil no identifica ninguna sesion, asi
        # que cuenta como titulo generico.
        if titulo.lower() in _TITULO_GENERICO or titulo.endswith(".local"):
            titulo = ""
        out.append((parts[0], int(parts[1] or 0), parts[2] != "0", titulo,
                    parts[4] if parts[4].isdigit() else ""))
    return out


def tmux_kill(name=None):
    # El `check=False` ignora el codigo de salida, pero NO protege de que el binario no
    # exista: eso es un `FileNotFoundError` que se lleva el programa por delante, y aqui
    # dentro de curses se lo lleva sin dejar rastro en la pantalla. Es el mismo fallo que
    # cazamos en las cuatro copias del `open` en 1.24-1.27; este era el ultimo que
    # quedaba, protegido solo por que sin tmux no hay filas que matar.
    orden = ["kill-session", "-t", name] if name else ["kill-server"]
    try:
        subprocess.run([TMUX_BIN, "-L", SOCK] + orden, check=False)
    except OSError:
        pass


def meta_by_tmux():
    """Metadatos del registro indexados por nombre de sesion tmux."""
    if not LIVE.is_dir():
        return {}
    out = {}
    for f in sorted(LIVE.glob("*.env")):
        e = read_entry(f)
        if e and e.get("tmux_session"):
            e["_transcript"] = transcript_vivo(e)
            out[e["tmux_session"]] = e
    return out


# ─────────────────────────── colisiones entre sesiones ───────────────────────────
# Dos sesiones vivas escribiendo en el mismo sitio no se ven entre ellas: cada una cree
# que el fichero es suyo. Los dos accidentes reales de esta maquina tienen esa forma
# —una saco a otro repo el modulo que la de al lado estaba editando, y un `git commit`
# sin pathspec se llevo el indice que otra habia dejado preparado— y ninguno de los dos
# dio error: se descubrieron despues, leyendo el diff.
#
# Lo que se observa son TOQUES: (epoch, clase, ruta, verbo).
#
#   "w"     escritura a un fichero concreto: Edit/Write/MultiEdit/NotebookEdit, y los
#           dos extremos de un `mv`.
#   "repo"  orden de git que actua sobre TODO el repo aunque nombre un fichero:
#           `git commit` sin pathspec, `git add -A`, `git checkout .`, `git reset
#           --hard`, `git clean -f`, `git stash`. Su ruta es la raiz del repo.
#   "dir"   `rm -r <dir>`: se lleva por delante lo que cuelgue de ahi.
#
# El veredicto NO nace aqui. `hechos_colision()` constata y `nivel_colision()` compone,
# que es la frontera que pide `.claude/rules/llm-decision-boundary.md`.

# Cuanto atras cuenta un toque. Medido sobre 40 transcripts de esta maquina: las 80
# lineas que `pulso()` ya lee abarcan entre 0,7 y 21 minutos segun lo hablador que sea
# el agente, y 3 minutos en el caso tipico. Quince es lo que tarda la union de varios
# refrescos en llenar esa ventana sin leer un byte de mas, y sigue significando "la
# otra sesion estaba aqui en esta misma sentada". Mas alla de eso lo que hay no es una
# carrera entre dos sesiones: es trabajo secuencial, y avisar de el es ruido.
VENTANA_COL = 15 * 60
# Compartir repo NO es chocar: en un monorepo lo comparten todas. Se avisa de "misma
# carpeta" para arriba.
COLISION_MINIMA = 2
# Lo que cada sesion ha tocado, acumulado entre refrescos. `pulso()` ve las ultimas 80
# lineas y nada mas; guardando lo visto, la ventana efectiva crece sola mientras sereno
# siga abierto y no cuesta ni una lectura extra.
_HUELLAS = {}
_TOPE_TOQUES = 300
_RAICES = {}

_TROZOS = re.compile(r"&&|\|\||;|\n|\|")
# Se corta ANTES de tokenizar: un `$(...)`, un heredoc o una redireccion meten dentro
# del comando texto que no son argumentos suyos, y `git commit -m "$(cat <<'EOF'` es
# como se escribe de verdad un commit largo aqui.
_CORTE = re.compile(r"\$\(|<<|>")
_CON_VALOR = {"-m", "--message", "-C", "--reuse-message", "-c", "--reedit-message",
              "--author", "--date", "-F", "--file", "-S", "--gpg-sign", "--cleanup",
              "--fixup", "--squash", "-t", "--template", "--trailer"}
_ENVOLTORIO = ("sudo", "env", "nohup", "time", "command")
# Solo estas escriben. `Read`, `Glob` y `Grep` tambien traen `file_path` o `path`, y
# mirar un fichero no choca con nadie.
_TOOLS_ESCRIBEN = {"Edit", "Write", "MultiEdit", "NotebookEdit"}


def raiz_repo(d):
    """La carpeta que contiene el `.git`, subiendo desde `d`. "" si no hay ninguna.

    Sin lanzar `git`: `tests/test_sin_red.py` fija la lista de binarios permitidos y
    esto no necesita ninguno — es un `exists()` por nivel y una cache por carpeta.

    Distinguir repos importa mas de lo que parece. Medido el 2026-08-26 con dos
    sesiones commiteando a la vez: una en `~/Desktop/VanguardIA` y otra en
    `.../src/Anubis/seo-guardian`, que vive DENTRO pero es repo propio. Sin subir a
    buscar el `.git` las dos habrian figurado compartiendo indice.
    """
    if not d or DEMO:
        return ""
    if d in _RAICES:
        return _RAICES[d]
    p, raiz = pathlib.Path(d), ""
    for _nivel in range(20):
        if (p / ".git").exists():
            raiz = str(p)
            break
        if p.parent == p:
            break
        p = p.parent
    _RAICES[d] = raiz
    return raiz


def _tokens(trozo):
    """Los argumentos de un tramo de shell, o lo que se pueda sacar de el.

    `shlex` revienta con comillas sin cerrar, que es lo normal cuando el tramo sale de
    partir un comando de varias lineas. Ahi se cae a partir por blancos, que para
    decidir "¿esto nombra un fichero?" basta.
    """
    trozo = _CORTE.split(trozo, 1)[0]
    try:
        tok = shlex.split(trozo)
    except ValueError:
        tok = trozo.split()
    while tok and (tok[0] in _ENVOLTORIO or "=" in tok[0]):
        tok = tok[1:]          # `sudo`, `VAR=x` y demas prefijos no son el comando
    return tok


def _sin_pathspec(resto):
    """Un `git commit` sin fichero detras se lleva el INDICE, que es compartido.

    Es el accidente registrado: ocho sesiones en el mismo repo, una commitea y arrastra
    lo que otra habia dejado preparado con `git add`. Nombrando el fichero no pasa.
    """
    saltar = False
    for t in resto:
        if saltar:
            saltar = False
            continue
        if t == "--":
            return False
        if not t.startswith("-"):
            return False
        if t in _CON_VALOR:
            saltar = True
    return True


def _anchas(cmd):
    """Ordenes de un `Bash` que tocan mas de lo que nombran: [(clase, ruta, verbo)].

    Deliberadamente NO se leen redirecciones (`> fichero`), `tee`, `sed -i` ni `cp`.
    Medido sobre los 505 comandos Bash de los ultimos 40 transcripts: la regex de
    redireccion daba 717 aciertos y casi todos eran `/dev/null`, un `2>&1`, una
    variable sin expandir o el `60` de un `head -60`. Un detector que grita 717 veces
    no lo mira nadie. `mv` si entra aunque en la muestra saliera 0 veces: es
    exactamente el accidente de sacar un modulo que otra sesion esta editando.
    """
    fuera = []
    for trozo in _TROZOS.split(cmd):
        tok = _tokens(trozo)
        if len(tok) >= 2 and tok[0] == "git":
            sub, resto = tok[1], tok[2:]
            if sub == "commit" and _sin_pathspec(resto):
                fuera.append(("repo", "", "git commit"))
            elif sub == "add" and any(a in ("-A", "--all", "-u", "--update", ".", ":/")
                                      for a in resto):
                fuera.append(("repo", "", "git add"))
            elif sub in ("checkout", "restore") and any(a in (".", ":/") for a in resto):
                fuera.append(("repo", "", "git " + sub))
            elif sub == "reset" and any(a in ("--hard", "--mixed") for a in resto):
                fuera.append(("repo", "", "git reset"))
            elif sub == "clean" and any(re.match(r"-[a-zA-Z]*f", a) for a in resto):
                fuera.append(("repo", "", "git clean"))
            elif sub == "stash" and (not resto or resto[0] in
                                     ("push", "save", "-u", "--include-untracked")):
                fuera.append(("repo", "", "git stash"))
        elif len(tok) >= 2 and tok[0] == "rm" and any(re.match(r"-[a-zA-Z]*[rR]", a)
                                                      for a in tok[1:]):
            fuera += [("dir", a, "rm -r") for a in tok[1:] if not a.startswith("-")]
        elif len(tok) >= 3 and tok[0] == "mv":
            # Los DOS extremos: mover deja huerfano a quien editaba el origen, y pisa
            # a quien estuviera escribiendo el destino.
            fuera += [("w", a, "mv") for a in tok[1:] if not a.startswith("-")]
    return fuera


def _toques(b, ts):
    """Lo que escribe un bloque `tool_use`, en toques crudos (rutas sin resolver).

    Reusa `_arg_tool()`, que es la misma tabla `_TOOL_ARG` con la que `_resume_tool()`
    pinta la linea del panel: un solo sitio donde se decide que argumento identifica
    una llamada, dos lectores distintos de ese hecho.
    """
    nom = b.get("name") or ""
    clave, valor = _arg_tool(b)
    if nom in _TOOLS_ESCRIBEN and clave in ("file_path", "notebook_path"):
        return [(ts, "w", valor, nom)]
    if nom == "Bash" and clave == "command":
        return [(ts, clase, ruta, verbo) for clase, ruta, verbo in _anchas(valor)]
    return []


def _resuelve(toques, cwd):
    """Rutas absolutas y normalizadas, contra el `cwd` de la sesion.

    Claude Code pasa `file_path` absoluto siempre —comprobado sobre los transcripts de
    esta maquina— asi que esto es para lo que sale de un `Bash`, que si viene relativo.
    Un toque de clase "repo" apunta al repo entero: su ruta ES la raiz del repo.
    """
    fuera = []
    for ts, clase, ruta, verbo in toques:
        if clase == "repo":
            ruta = raiz_repo(cwd) or cwd
        elif ruta.startswith("/"):
            ruta = os.path.normpath(ruta)
        elif cwd:
            ruta = os.path.normpath(os.path.join(cwd, ruta))
        if ruta:
            fuera.append((ts, clase, ruta, verbo))
    return fuera


def recuerda_toques(sid, toques, ahora=None):
    """Mezcla lo recien visto con lo ya sabido de esa sesion y devuelve su huella viva.

    Idempotente a proposito: la fila de una sesion parada sale de `_CACHE_DISCO` con los
    mismos toques vuelta tras vuelta, y volver a mezclarlos no puede cambiar nada.

    La poda por ventana va aqui y no al consultar: asi el diccionario no crece con las
    horas que lleve sereno abierto, que es la unica forma que tiene esto de hacerse
    grande.
    """
    ahora = time.time() if ahora is None else ahora
    h = _HUELLAS.setdefault(sid, {})
    for ts, clase, ruta, verbo in (toques or ()):
        k = (clase, ruta, verbo)
        h[k] = max(ts, h.get(k, 0))
    viejo = ahora - VENTANA_COL
    for k in [k for k, ts in h.items() if ts < viejo]:
        del h[k]
    if len(h) > _TOPE_TOQUES:
        # Un barrido que toca mil ficheros no puede comerse la memoria del selector.
        for k, _ts in sorted(h.items(), key=lambda kv: kv[1])[:len(h) - _TOPE_TOQUES]:
            del h[k]
    if not h:
        _HUELLAS.pop(sid, None)
    return h


def hechos_colision(mia, otra, ahora=None):
    """Que comparten dos sesiones, en hechos. Sin veredicto: lo compone `nivel_colision`.

    `mia` y `otra` son {"repo": str, "toques": {(clase, ruta, verbo): epoch}}. Los
    campos simetricos valen para las dos; los contadores miran a `otra`, porque lo que
    se le ensena a una sesion es lo que esta haciendo LA DE AL LADO.
    """
    ahora = time.time() if ahora is None else ahora
    fmia = {r for (c, r, _v) in mia["toques"] if c == "w"}
    fotra = {r for (c, r, _v) in otra["toques"] if c == "w"}
    comunes = fmia & fotra
    dmia = {os.path.dirname(r) for r in fmia}
    dotra = {os.path.dirname(r) for r in fotra}
    mismo_repo = bool(mia["repo"]) and mia["repo"] == otra["repo"]

    # Una orden ancha solo choca si cae sobre terreno que la otra esta escribiendo: un
    # `git commit` en un repo donde no trabaja nadie mas no se lleva nada de nadie. Es
    # lo que evita que el aviso salte en cada commit de una sesion que va sola.
    ancha, ancha_mia = "", False
    for suya, quien, ajenos in ((True, mia, fotra), (False, otra, fmia)):
        for (clase, ruta, verbo), _ts in quien["toques"].items():
            if clase == "repo" and mismo_repo:
                ancha, ancha_mia = verbo, suya
            elif clase == "dir" and any(f.startswith(ruta.rstrip("/") + "/")
                                        for f in ajenos):
                ancha, ancha_mia = verbo, suya

    # Cuanto pisa la OTRA sobre terreno compartido: la medida de si esto esta caliente
    # ahora o es un rastro de hace un rato. Sin terreno compartido no hay que contar.
    terreno = comunes or ({r for r in fotra if os.path.dirname(r) in dmia}
                          if dmia & dotra else set())
    calientes = [ts for (c, r, _v), ts in otra["toques"].items()
                 if (c == "w" and r in terreno) or (c != "w" and mismo_repo)]
    return {
        "mismo_fichero": bool(comunes),
        "mismo_directorio": bool(dmia & dotra),
        "mismo_repo": mismo_repo,
        "ficheros": tuple(sorted(comunes)),
        "escrituras_recientes": len(calientes),
        "segundos_desde_la_ultima": int(ahora - max(calientes)) if calientes else None,
        "orden_ancha": ancha,
        "orden_es_mia": ancha_mia,
    }


def nivel_colision(h):
    """0 nada · 1 mismo repo · 2 misma carpeta · 3 mismo fichero · 4 orden ancha.

    El 1 NO es un choque y no se pinta: en un monorepo lo comparten todas las sesiones a
    la vez, y un aviso que sale siempre no avisa de nada. Existe como escalon para que
    el 4 pueda apoyarse en el.

    El 4 va por encima del 3 a proposito. Dos sesiones editando el mismo fichero lo
    notas al guardar; un `git commit` sin pathspec en un repo que otra esta tocando se
    lleva su indice sin que nada falle, y eso solo se ve leyendo el diff despues.
    """
    if h["orden_ancha"]:
        return 4
    if h["mismo_fichero"]:
        return 3
    if h["mismo_directorio"]:
        return 2
    if h["mismo_repo"]:
        return 1
    return 0


def colisiones(rows):
    """Anota en cada fila con quien choca, si con alguien. Devuelve las mismas `rows`.

    O(n^2) sobre las filas que tienen toques en la ventana, que en la practica son dos o
    tres. Aun con las 40 del historial serian 1.600 intersecciones de conjuntos de
    decenas de elementos: por debajo del milisegundo, y solo se paga cuando hay algo que
    cruzar.
    """
    ahora = time.time()
    vivas = []
    for r in rows:
        pu = r.get("pulso") or {}
        r["colision"] = None
        toques = recuerda_toques(r["name"], pu.get("escrituras"), ahora)
        if toques:
            cwd = pu.get("cwd") or (r.get("meta") or {}).get("cwd") or ""
            vivas.append((r, {"repo": raiz_repo(cwd), "toques": toques}))

    for i, (ra, ha) in enumerate(vivas):
        for rb, hb in vivas[i + 1:]:
            if ra["name"] == rb["name"]:
                continue          # una sesion reanudada puede llegar por dos vias
            for yo, mia, otro, suya in ((ra, ha, rb, hb), (rb, hb, ra, ha)):
                h = hechos_colision(mia, suya, ahora)
                h["nivel"] = nivel_colision(h)
                h["con"] = otro["name"]
                h["titulo"] = otro.get("title_full") or otro.get("title") or ""
                if h["nivel"] >= COLISION_MINIMA and (
                        yo["colision"] is None or h["nivel"] > yo["colision"]["nivel"]):
                    yo["colision"] = h
    return rows


# Las dos formas de interrumpir que escribe el CLI, medidas sobre los transcripts de esta
# maquina: 87 interrupciones, 78 con el campo `interruptedMessageId` y 9 sin el. Por eso se
# miran las dos cosas y no solo una — el campo es el dato bueno (tipado, no cambia con el
# idioma) y el texto recoge las que no lo traen.
_INTERRUPCION = ("[Request interrupted by user]",
                 "[Request interrupted by user for tool use]")


def _interrumpida(j, bloques):
    """Esta linea de usuario es un ESC, no un mensaje."""
    if j.get("interruptedMessageId"):
        return True
    return any(isinstance(b, dict) and b.get("type") == "text"
               and (b.get("text") or "").strip() in _INTERRUPCION for b in bloques)


def pulso(e, secs=90, fino=True):
    """Hechos sobre lo que hace la sesion. El veredicto lo compone quien llame.

    {"escribe": bool|None, "herramienta": bool|None}

    Con `escribe` solo no basta y era el fallo de la version anterior: mientras
    Claude espera a que termine un comando NO escribe nada en el transcript, asi que
    una sesion en mitad de un `Bash` de tres minutos figuraba como parada. Lo que la
    delata es que su ultimo evento sea un `tool_use` cuyo `tool_result` no ha llegado.

    Los procesos hijos NO sirven para esto: medido el 2026-08-25, las 8 sesiones
    tenian 6-7 descendientes cada una solo por los servidores MCP (context7, uv,
    npm exec), estuvieran haciendo algo o no.
    """
    t = e.get("_transcript") if e else None
    if not t:
        return {"escribe": None, "herramienta": None}
    try:
        # El `mtime` hace ademas de reloj de respaldo para las lineas sin `timestamp`:
        # sin el, un toque sin fecha nace con epoch 0 y se poda al instante, en silencio.
        mtime = t.stat().st_mtime
    except OSError:
        return {"escribe": None, "herramienta": None}
    escribe = (time.time() - mtime) < secs
    if not fino:
        # El aviso de abrir terminal solo cuenta sesiones: leer la cola de todos los
        # transcripts para afinar le costaria 100 ms en vez de 30, y no cambia lo que
        # imprime. Lo fino lo pide el selector, que si lo pinta.
        return {"escribe": escribe, "herramienta": None}

    pendientes, ultimo_tool, extra, toca = set(), False, {}, []
    cerrado = None
    crudos = []
    for raw in ultimas_lineas(t, 80):
        try:
            j = json.loads(raw)
        except Exception:
            continue
        crudos.append(j)
        for k in ("cwd", "gitBranch", "lastPrompt", "aiTitle"):
            if j.get(k):
                extra[k] = j[k]            # de una pasada: no hay que releer despues
        # Los ficheros que toca la sesion, para el detector de choques. Va ANTES del
        # corte de `isSidechain` a proposito: lo que escribe un subagente lo escribe la
        # sesion, y quien se lleve el fichero por delante no distingue cual de los dos
        # lo hizo. No cuesta una lectura: esta cola ya esta abierta.
        cont0 = (j.get("message") or {}).get("content")
        if isinstance(cont0, list):
            ts = _iso(j.get("timestamp") or "") or mtime
            for b0 in cont0:
                if isinstance(b0, dict) and b0.get("type") == "tool_use":
                    toca += _toques(b0, ts)
        # El CLI escribe al cerrar una linea `cost-state` con el gasto POR MODELO, y
        # la clave de ese diccionario si trae el sufijo: `claude-opus-5[1m]`. Es el
        # unico sitio del transcript donde la ventana de la sesion aparece escrita —
        # `message.model` dice `claude-opus-5` a secas aunque corra en el millon.
        # Medido sobre los 517 transcripts de esta maquina: 15 traen la linea, y las
        # 15 dentro de las ultimas 80, que son las que esta pasada ya lee. Se publica
        # el hecho (`la escribio con sufijo`), no el tope: el tope lo compone
        # `tope_contexto()`.
        if j.get("type") == "cost-state":
            uso_modelo = j.get("modelUsage")
            if isinstance(uso_modelo, dict):
                # El Haiku de los titulos y los resumenes internos aparece aqui aunque
                # la sesion corra en Opus: en 8 de los 11 transcripts de esta maquina
                # que traen la linea, va de acompanante. Contarlo como modelo de la
                # sesion haria que una conversacion trivial —solo Haiku— bajase el tope
                # a 200k por su cuenta. Si al quitarlo no queda ninguna clave, el hecho
                # no se publica: `None` es "no se midio", que no es "no es de un millon".
                # Y `modelUsage` vacio existe de verdad: 4 de los 15.
                reales = [k for k in uso_modelo if "haiku" not in str(k).lower()]
                if reales:
                    extra["ventana_1m"] = any("[1m]" in str(k).lower() for k in reales)
            continue
        if j.get("isSidechain"):
            continue
        msg = j.get("message") or {}
        # El contexto que lleva gastado la sesion viaja en el `usage` de cada respuesta:
        # lo que leyo de cache + lo que acaba de cachear + lo que va suelto. No hay API
        # que preguntar y esta cola ya se estaba leyendo, asi que no cuesta ni una
        # lectura mas. Vale el ULTIMO, que es el vigente — y por eso se mira aqui abajo
        # y no antes: los sidechain son subagentes, y su contexto no es el de la sesion.
        u = msg.get("usage")
        if isinstance(u, dict) and j.get("type") == "assistant":
            n = sum(u.get(k) or 0 for k in ("cache_read_input_tokens",
                                            "cache_creation_input_tokens",
                                            "input_tokens"))
            if n:
                extra["ctx"] = n
                m = msg.get("model") or ""
                if m.startswith("claude"):      # `<synthetic>` no es un modelo
                    extra["modelo"] = m
        cont = msg.get("content")
        bloques = cont if isinstance(cont, list) else []
        if j.get("type") == "assistant":
            ids = {b.get("id") for b in bloques
                   if isinstance(b, dict) and b.get("type") == "tool_use"}
            if ids:
                pendientes |= ids
                ultimo_tool = True
            elif any(isinstance(b, dict) and b.get("type") == "text" for b in bloques):
                ultimo_tool = False
            # Quien dice que el turno acabo es el CLI, en el `stop_reason` de la propia
            # respuesta. `None` cuando no consta —transcripts viejos, otros CLI— y ahi
            # el estado se queda como estaba: un dato que falta no es un dato bueno.
            fin = msg.get("stop_reason")
            cerrado = (fin == "end_turn") if fin else None
        elif j.get("type") == "user":
            pendientes -= {b.get("tool_use_id") for b in bloques
                           if isinstance(b, dict) and b.get("type") == "tool_result"}
            if not pendientes:
                ultimo_tool = False
            # Cualquier linea de usuario posterior reabre el turno: un prompt nuevo, o
            # el resultado del comando que la sesion estaba esperando. Sin esto, los
            # segundos entre que mandas algo y llega la primera linea de la respuesta
            # se leerian como "ya termino".
            #
            # Menos una: pulsar ESC no reabre nada, lo CIERRA. Una sesion recien
            # interrumpida es la que mas claramente te espera —acabas de pararla para
            # decirle algo— y sin esta rama figuraba como "escribiendo" durante los 90
            # segundos siguientes, que es justo cuando la miras.
            cerrado = _interrumpida(j, bloques)
    if toca:
        # Se resuelve al final porque el `cwd` sale de esta misma pasada y las primeras
        # lineas pueden llegar antes que el.
        extra["escrituras"] = _resuelve(toca, extra.get("cwd") or "")
    # Si esta dando vueltas, eso pertenece a la LISTA y no solo al panel: la pregunta
    # con la que abre este programa es cual de las nueve esta atascada, y hasta ahora
    # habia que posarse en cada fila para verlo. Reusa los objetos que esta pasada
    # acaba de parsear: cero lecturas mas y, medido sobre 16 filas reales, 5 ms de CPU
    # frente a los 49 que ya cuesta esta funcion.
    extra["atasco"] = alertas(sintomas(recorrido(crudos)))
    return {"escribe": escribe, "herramienta": bool(pendientes) and ultimo_tool,
            "cerrado": cerrado, **extra}


def _dur(secs):
    """Cuanto lleva abierta. En dias a partir del segundo, que `170h 26m` no se lee:
    hay que dividir mentalmente por 24 para saber que son siete dias."""
    secs = int(secs)
    d, h, m = secs // 86400, (secs % 86400) // 3600, (secs % 3600) // 60
    if d >= 2:
        return f"{d}d {h}h"
    return f"{d * 24 + h}h {m:02d}m" if (d or h) else f"{m}m"


def idle_secs(e):
    """Segundos desde la ultima actividad real de la sesion (su transcript).

    NO vale `session_created` de tmux para esto: tras un apagon todas las sesiones
    renacen hoy y parecen igual de nuevas aunque la conversacion sea de ayer. El
    transcript es lo unico que distingue una sesion viva de una abandonada.
    """
    t = (e or {}).get("_transcript")
    if not t:
        return None
    try:
        return max(0, time.time() - t.stat().st_mtime)
    except OSError:
        return None


def ai_title(e):
    """El titulo que Claude Code se pone a si mismo, de la cola del transcript.

    Solo se consulta cuando tmux no da uno (pane_title generico): abrir el fichero
    es mas caro que leer una variable, y para la mayoria de sesiones no hace falta.
    """
    t = (e or {}).get("_transcript")
    if not t:
        return ""
    for raw in reversed(ultimas_lineas(t, 40)):
        try:
            j = json.loads(raw)
        except Exception:
            continue
        if j.get("aiTitle"):
            return j["aiTitle"]
    return ""


def rss_por_arbol(pids):
    """MB de RSS de cada pid contando a sus descendientes. Un solo `ps` para todos.

    16 sesiones de Claude en un portatil no son gratis, y ese es justo el dato que
    falta para decidir cual sobra: "hace 5h que no la tocas y ocupa 900 MB".
    """
    if not pids:
        return {}
    try:
        out = subprocess.run(["ps", "-eo", "pid=,ppid=,rss="],
                             capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return {}
    hijos, rss = {}, {}
    for linea in out.splitlines():
        campos = linea.split()
        if len(campos) != 3 or not all(c.isdigit() for c in campos):
            continue
        pid, ppid, kb = (int(c) for c in campos)
        hijos.setdefault(ppid, []).append(pid)
        rss[pid] = kb
    def suma(pid, visto):
        if pid in visto:
            return 0
        visto.add(pid)
        return rss.get(pid, 0) + sum(suma(h, visto) for h in hijos.get(pid, ()))
    return {p: suma(int(p), set()) / 1024 for p in pids if str(p).isdigit()}


def live_sessions(con_ram=False, con_disco=True, fino=None, solo_activas=True):
    """`con_ram` cuesta un `ps -eo` de toda la maquina: 220 ms medidos con 9 sesiones.

    El hook que corre al abrir terminal solo dice cuantas hay, asi que ahi no se
    pide; solo la pide el selector, que si la pinta.

    `con_disco` anade las sesiones vivas que tmux no ve. Son dos casos y los dos
    importan: en una maquina sin nuestro wrapper es la UNICA fuente, y en la de casa
    saca las que se lanzaron desde VS Code o con la ruta completa al binario, que
    hasta ahora no aparecian en ningun sitio.
    """
    # La demo sale por aqui, pero POR DEBAJO del `sort` del final: cuando se colaba
    # antes, las capturas y el GIF del README ensenaban un orden —de menos a mas
    # parada— que el programa de verdad no producia nunca. La unica vista que se
    # revisa a ojo era justo la que esquivaba la regla.
    if DEMO:
        return ordena([r for r in sesiones_demo() if r.get("fuente") == "claude"])
    # El pulso fino y la RAM iban atados porque hasta ahora solo los pedia el selector,
    # que pinta las dos cosas. `--watch` quiere lo fino —es lo que detecta el cambio de
    # estado— y NO quiere el `ps -eo` de toda la maquina cada veinte segundos.
    if fino is None:
        fino = con_ram
    metas = meta_by_tmux()
    paneles = tmux_list()
    mem = rss_por_arbol([p for *_resto, p in paneles if p]) if con_ram else {}
    rows = []
    for name, created, attached, titulo, pid in paneles:
        e = metas.get(name, {})
        pu = pulso(e, fino=fino) if e else {"escribe": None, "herramienta": None}
        # Orden de preferencia del titulo: lo que el usuario puso con /rename o el
        # aiTitle (los dos llegan por pane_title, en vivo) > el aiTitle del
        # transcript > el primer mensaje. Lo ultimo era la unica fuente y es la peor.
        propio = titulo or pu.get("aiTitle", "")
        rows.append({
            "name": name, "created": created, "attached": attached,
            "meta": e, "pid": pid,
            "mem_mb": mem.get(pid),
            "title": (propio[:33] + "\u2026") if len(propio) > 34 else (propio or (label(e) if e else name)),
            "title_full": propio or (label(e, 200) if e else name),
            "idle": idle_secs(e),
            "pulso": pu,
            "proyecto": pathlib.Path(pu.get("cwd") or e.get("cwd") or "").name,
            "rama": pu.get("gitBranch", ""),
            "working": None if pu["escribe"] is None
                       else bool((pu["escribe"] and not pu.get("cerrado"))
                                 or pu["herramienta"]),
        })
    if con_disco:
        # Por el stem del transcript RESUELTO, no por el id del registro: si no, una
        # sesion reanudada sale dos veces, una por tmux con su nombre y otra por disco
        # con el primer prompt de titulo.
        ids = set()
        for r in rows:
            m = r.get("meta") or {}
            ids.add(m.get("id"))
            if m.get("_transcript") is not None:
                ids.add(m["_transcript"].stem)
        # `solo_activas=False` lo pide `--watch`: el filtro por mtime tira una sesion
        # a los 90 segundos de callarse, que es EXACTAMENTE cuando acaba de terminar y
        # hay que avisar. Sin tmux delante, el vigilante se quedaba sin ver el flanco
        # que existe para ver. Lo caza `tests/test_watch_flanco.py`.
        # Lo recien cerrado se excluye igual que lo que tmux ya ensena: si no, cerrar
        # una sesion la devuelve a la lista desde el disco y encima marcada como viva.
        rows += sesiones_de_disco(vistos=ids | cerradas_recientes(),
                                  solo_activas=solo_activas, fino=fino)
    # El orden por defecto lo compone `ordena()`, que es pura y tiene test propio.
    # Antes iba aqui a pelo y ponia la sesion MAS parada la primera: justo debajo del
    # cursor, que es lo que abre ENTER.
    return colisiones(ordena(desambigua(rows)))


# ─────────────── sesiones leidas del historial, sin tmux ni registro ───────────────
# El registro de `tools/claude` y tmux dan RAM y "tiene pestana abierta", que esto no
# puede saber. A cambio, `~/.claude/projects` lo escribe el propio CLI en CUALQUIER
# maquina: es la unica via que funciona sin haber instalado antes nuestro wrapper, y
# ademas ve las sesiones que el wrapper no lanzo (VS Code, `claude` por ruta completa).
PROJECTS = HOME / ".claude/projects"
_CACHE_DISCO = {}
# Una sesion reanudable se llama como su UUID. Los `agent-*.jsonl` que el CLI deja al
# lado son transcripts de SUBAGENTES: no se reanudan, no tienen titulo propio y son
# muchos —213 en esta maquina, contra 1.035 sesiones— asi que colarlos enterraba la
# lista bajo veinte copias del mismo prompt de subagente.
_UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")


_CACHE_SITIO = {}
# 30 s: una worktree que borras deja de existir para la lista en la siguiente media
# vuelta, y una que recreas revive sola. Sin TTL habria que elegir entre mentir hasta
# reiniciar o hacer un `stat` por fila cuatro veces por segundo.
TTL_SITIO = 30.0


def hay_sitio(ruta):
    """Si el directorio de trabajo de una sesion sigue existiendo. Cacheado por RUTA.

    Por ruta y no por sesion. Lo que ahorra de verdad NO es agrupar filas —medido: 40
    filas dan 36 rutas distintas, o sea 3 `stat` menos en frio— sino no repetirlas entre
    refrescos: de 37 `stat` en la primera pasada a 1 en la siguiente.

    Vive fuera de `ordena()`, que es pura y se llama cuatro veces por segundo, asi que el
    coste amortizado baja a ~37 `stat` cada 30 s en vez de por refresco. **Eso reduce la
    repeticion, no el bloqueo**: `recargar()` corre sincrono en el bucle que pinta, asi
    que sobre un montaje colgado —donde un `stat` no vuelve— el TUI se queda quieto, sin
    repintar y sin atender teclas. Medido inyectando 1 s de latencia por `stat`: la
    primera pasada tarda 37,4 s. El cache defiende de repetirse, no de colgarse.

    Sin ruta devuelve True — "no consta" no es "no existe", y marcar una sesion por un
    dato que falta seria el error contrario al que esto arregla.
    """
    if not ruta:
        return True
    ahora = time.time()
    visto = _CACHE_SITIO.get(ruta)
    if visto and ahora - visto[0] < TTL_SITIO:
        return visto[1]
    try:
        # `os.path.isdir` NO sirve aqui, y el `except OSError` que lo envolvia era codigo
        # muerto: `genericpath.isdir` se traga el error dentro y devuelve False, asi que un
        # permiso denegado o un bucle de symlinks salian como "no existe" — justo la
        # ausencia que la guarda decia evitar. Medido: un directorio que existe, con el
        # padre a 000, daba `hay_sitio` False y hundia la fila.
        existe = stat.S_ISDIR(os.stat(ruta).st_mode)
    except (FileNotFoundError, NotADirectoryError):
        existe = False                    # esto SI es una ausencia, y es el caso normal
    except OSError:
        existe = True                     # cualquier otro error al mirar no lo es
    if len(_CACHE_SITIO) > 400:
        _CACHE_SITIO.clear()
    _CACHE_SITIO[ruta] = (ahora, existe)
    return existe


# ────────────── lo que nacio para tirarse no es trabajo ──────────────
# Un `claude` lanzado por un script en un directorio temporal —evaluadores, optimizadores
# de skills, pruebas de un harness— deja el mismo transcript que una sesion de verdad. En
# esta maquina eran 46 de 200 filas del historial: veintidos "Score how well the response
# satisfies…" y veintidos "Complete the following task…", todas del mismo optimizador.
#
# No se detectan por el titulo, que es adivinar: se detectan por DONDE nacieron. Su `cwd`
# cuelga del temporal del sistema, un sitio del que nadie reanuda nada porque ya no existe
# al dia siguiente.
def _raices_temporales():
    """Los prefijos que son 'directorio de usar y tirar' en esta maquina. Una vez."""
    if "_v" not in _raices_temporales.__dict__:
        crudo = [os.environ.get("TMPDIR", ""), "/tmp", "/var/tmp",
                 "/var/folders", "/private/var/folders", "/private/tmp"]
        vistos = []
        for r in crudo:
            r = (r or "").rstrip("/")
            if r and r not in vistos:
                vistos.append(r)
        _raices_temporales._v = tuple(vistos)
    return _raices_temporales._v


def de_usar_y_tirar(ruta):
    """True si esa ruta cuelga del temporal del sistema. Un hecho, no un juicio.

    Se mira la RUTA y no el contenido a proposito: el titulo de una sesion sintetica se
    parece al de una real lo suficiente como para que filtrar por ahi sea adivinar, y
    ademas cambiaria con cada version del script que las lanza. Donde nacio, no.
    """
    if not ruta:
        return False
    r = str(ruta).rstrip("/")
    return any(r == t or r.startswith(t + "/") for t in _raices_temporales())


def _proyecto_de_dir(nombre):
    """`-home-you-code-my-project` -> `/home/you/code/my-project`.

    Es una conjetura: el CLI aplana el path sustituyendo `/` por `-`, asi que un
    directorio con guion propio no se puede deshacer. Por eso solo se usa como
    ULTIMO recurso — el `cwd` bueno viene dentro del transcript.
    """
    return "/" + nombre.lstrip("-").replace("-", "/") if nombre.startswith("-") else ""


def id_sesion(r):
    """El id de la sesion de CLAUDE, o "" si no consta.

    No es lo mismo que `r["name"]`, y confundirlos era el bug: `name` es la clave de la
    fila —el nombre de la sesion de tmux (`cc-VanguardIA-90a6fb95`) en una viva, y el
    uuid en una del historial—, asi que la misma etiqueta ensenaba dos cosas distintas
    y la de tmux no sirve para `claude --resume`.

    Sale del nombre del transcript, que es el uuid y lo escribe el propio CLI. El `id`
    del registro vale de respaldo, pero solo si es un uuid: en una sesion reanudada
    apunta al fichero viejo.
    """
    e = r.get("meta") or {}
    t = e.get("_transcript")
    if t is not None and _UUID.match(t.stem):
        return t.stem
    v = str(e.get("id") or "")
    if _UUID.match(v):
        return v
    return v if _UUID.match(str(r.get("name") or "")) else ""


def desambigua(rows):
    """Dos sesiones con el mismo titulo se distinguen con su id corto.

    Pasa mas de lo que parece: doce de las cuarenta filas del historial de esta maquina
    empezaban con el mismo encargo, asi que en el panel eran la misma fila repetida. El
    id corto no es bonito, pero es unico por definicion y ademas es lo que hace falta
    para reanudarla. Se toca el titulo de las REPETIDAS y solo el suyo.

    Idempotente: sobre una lista ya desambiguada no hay grupos, asi que no hace nada.
    """
    grupos = {}
    for r in rows:
        grupos.setdefault((r.get("title_full") or "").strip(), []).append(r)
    for titulo, iguales in grupos.items():
        if len(iguales) < 2 or not titulo:
            continue
        for r in iguales:
            corto = (id_sesion(r) or r.get("name") or "")[:8]
            if not corto:
                continue
            r["title_full"] = f"{titulo}  \u00b7 {corto}"
            r["title"] = _recorta(r["title_full"], 34)
    return rows


def _recorta(t, ancho):
    return (t[:ancho - 1] + "\u2026") if len(t) > ancho else t


def _ids(rows):
    return {(r.get("meta") or {}).get("id") for r in rows}


def sesiones_de_disco(vistos=(), solo_activas=False, limite=40, fino=True):
    if DEMO:
        return []
    """Filas a partir de los transcript de `~/.claude/projects`.

    `solo_activas` filtra por mtime ANTES de abrir nada: preguntar "¿hay alguna
    sesion viva que tmux no vea?" cuesta entonces un `stat` por fichero y no una
    lectura. Sin ese filtro, 1.248 transcript son 3,8 GB de cola por barrer.
    """
    if not PROJECTS.is_dir():
        return []
    ahora, cands = time.time(), []
    for p in PROJECTS.glob("*/*.jsonl"):     # sin `**`: los `subagents/` no se reanudan
        if p.stem in vistos or not _UUID.match(p.stem):
            continue
        # El nombre del directorio ya dice donde nacio, asi que esto no cuesta abrir
        # nada: es el mismo criterio que el filtro por mtime de abajo.
        if de_usar_y_tirar(_proyecto_de_dir(p.parent.name)):
            continue
        try:
            mt = p.stat().st_mtime
        except OSError:
            continue
        if solo_activas and ahora - mt > VIVA:
            continue
        cands.append((mt, p))
    cands.sort(reverse=True)
    return [fila_de_transcript(p, mt, fino=fino) for mt, p in cands[:limite]]


def fila_de_transcript(p, mt=None, fino=True):
    """Una fila a partir de un `.jsonl` suelto. Vive aparte porque la quieren dos:
    el barrido de `sesiones_de_disco` y la busqueda de `--find`."""
    if mt is None:
        try:
            mt = p.stat().st_mtime
        except OSError:
            mt = 0
    clave = (str(p), mt)
    fila = _CACHE_DISCO.get(clave)
    if fila is None:
        e = {"id": p.stem, "project_dir": str(p.parent), "_transcript": p}
        pu = pulso(e, fino=fino)
        e["cwd"] = pu.get("cwd") or _proyecto_de_dir(p.parent.name)
        titulo = (pu.get("aiTitle") or first_user_text(p) or p.stem[:8])
        fila = {
            "name": p.stem, "created": 0, "attached": False, "meta": e, "pid": "",
            "mem_mb": None, "_sin_proceso": True,
            "title": (titulo[:33] + "\u2026") if len(titulo) > 34 else titulo,
            "title_full": titulo, "pulso": pu,
            "proyecto": pathlib.Path(e["cwd"] or "").name,
            "rama": pu.get("gitBranch", ""),
        }
        if len(_CACHE_DISCO) > 400:
            _CACHE_DISCO.clear()          # la clave lleva el mtime: crece sin tope
        _CACHE_DISCO[clave] = fila
    fila = dict(fila)
    fila["idle"] = max(0.0, time.time() - mt)
    viva = fila["idle"] <= VIVA
    # `working` sale del pulso, que mira el transcript; sin proceso que inspeccionar es
    # lo unico observable, y es honesto: si nadie escribe ahi, no esta trabajando.
    fila["working"] = bool((fila["pulso"].get("escribe")
                            and not fila["pulso"].get("cerrado"))
                           or fila["pulso"].get("herramienta")) if viva else False
    fila["fuente"] = "claude" if viva else "historial"
    # Solo para las del historial: una viva tiene su proceso dentro de ese directorio,
    # asi que preguntarlo seria gastar un `stat` para confirmar lo obvio.
    fila["_sitio"] = True if viva else hay_sitio((fila.get("meta") or {}).get("cwd"))
    return fila


