# `_fase()` devuelve una frase traducida, que es lo correcto para una persona y lo peor
# posible para un script: cambia con el idioma y con cualquier retoque de estilo. El
# JSON lleva este enum, que es lo unico que se promete estable.
def estado_estable(r):
    pu = r.get("pulso") or {}
    if pu.get("escribe") is None:
        return "unknown"
    if pu.get("herramienta"):
        return "in_command"
    # `escribe` es que el fichero se toco hace poco, y eso sigue siendo cierto durante
    # los 90 segundos SIGUIENTES a que la sesion termine: justo cuando empieza a
    # esperarte. `cerrado` es el corte fino y manda sobre el mtime; cuando no consta
    # (None) se decide como siempre.
    if pu.get("escribe") and not pu.get("cerrado"):
        return "writing"
    return "waiting" if (r.get("idle") or 0) < 6 * INACTIVA else "stopped"


# La version del CONTRATO, que no es la del programa. `sereno` sube de version por
# cualquier motivo —un color, un texto, un arreglo de la cola del transcript— y quien
# consume esta salida no puede deducir de ahi si sus campos siguen ahi. Este numero
# sube SOLO cuando un campo cambia de nombre, de tipo o desaparece: mientras valga 1,
# un script escrito hoy sigue leyendo lo mismo. Anadir un campo nuevo NO lo sube —
# nadie se rompe por recibir de mas—, y eso tambien esta escrito en
# `tests/test_json_sin_conversacion.py`, que es quien lo hace cumplir.
ESQUEMA_JSON = 1


def filas_json(rows):
    """Los mismos hechos que pinta la lista, sin una linea de conversacion dentro.

    Deliberadamente NO salen el ultimo prompt ni la ultima respuesta, que si estan en el
    panel. Un `--json` se canaliza a barras de estado, a scripts de otros y a lo que a
    nadie se le ocurre: la promesa de que aqui no sale nada de la maquina solo se
    sostiene si lo que este comando imprime no lleva conversacion. Lo vigila
    `tests/test_json_sin_conversacion.py`, que ademas fija los tipos.
    """
    fuera = []
    for r in rows:
        pu = r.get("pulso") or {}
        ctx = pu.get("ctx")
        # Solo con `--usage`: leer el acumulado obliga a recorrer el transcript entero.
        # Sin el flag los ocho campos van a `null` y NO a cero, que es lo que permite a
        # quien lo consuma distinguir "no se midio" de "no gasto nada".
        u = uso_de(r) if USO else None
        fuera.append({
            # `id` es la CLAVE de la fila y se queda como estaba: nombre de tmux en una
            # viva, uuid en una del historial. El id de la sesion de Claude —el que se le
            # pasa a `--resume`— es `session_id`, y va aparte justamente porque no son lo
            # mismo: confundirlos era lo que hacia que la interfaz ensenara uno por otro.
            "id": r.get("name") or "",
            "session_id": id_sesion(r) or None,
            "title": r.get("title_full") or r.get("title") or "",
            "project": r.get("proyecto") or "",
            "branch": r.get("rama") or "",
            "source": r.get("fuente", "claude"),
            "state": estado_estable(r),
            # Los dos hechos crudos de los que sale `state`, para quien prefiera
            # componer el suyo en vez de fiarse del nuestro.
            "writing": pu.get("escribe"),
            "tool_pending": pu.get("herramienta"),
            # `null` cuando el transcript no lo dice: distingue "no cerro" de "no consta".
            "turn_closed": pu.get("cerrado"),
            "idle_seconds": None if r.get("idle") is None else round(r["idle"]),
            # El hecho, no el juicio: si su directorio de trabajo sigue existiendo. Una
            # statusline que solo quiera lo reanudable de verdad filtra por esto sin
            # tener que adivinar por el nombre del proyecto.
            "cwd_exists": bool(r.get("_sitio", True)),
            "attached": bool(r.get("attached")),
            "memory_mb": None if r.get("mem_mb") is None else round(r["mem_mb"]),
            "context_tokens": ctx,
            # El pico solo consta con `--usage`, que es quien lee el transcript entero.
            # Sin el, este campo puede quedarse en la ventana estandar en una sesion que
            # ya compacto: el dato de ahora no la delata y el de antes no se ha leido.
            "context_max": tope_contexto(pu.get("modelo"), ctx, pu.get("ventana_1m"),
                                         pico_de(r)) if ctx else None,
            "model": pu.get("modelo"),
            "pid": r.get("pid") or None,
            # Los cuatro crudos y ninguna suma: juntar la cache leida con la entrada da
            # una cifra cien veces mayor que el material real. Quien quiera un total lo
            # compone, sabiendo lo que esta sumando.
            "input_tokens": u["in"] if u else None,
            "output_tokens": u["out"] if u else None,
            "cache_write_tokens": u["cw"] if u else None,
            "cache_read_tokens": u["cr"] if u else None,
            "assistant_turns": u["turnos"] if u else None,
            "compactions": u["compacta"] if u else None,
            # El mayor contexto que llego a tener, compactaciones incluidas. Es lo que
            # `context_tokens` deja de contar en cuanto se compacta, y de donde sale el
            # `context_max` de una sesion que ya lo hizo.
            "peak_context_tokens": u["pico"] if u else None,
            "working_seconds": round(u["activo"]) if u else None,
            # Lo escribio el propio CLI con sus precios; `sereno` no calcula dinero ni
            # lleva tabla de tarifas. En un plan de suscripcion es lo que HABRIA costado
            # por API, no lo que has pagado. Fuera del TUI a proposito.
            "api_cost_usd": u["usd"] if u else None,
            # Con quien choca y cuanto. Van las CIFRAS, nunca las rutas: `--json` se
            # canaliza a barras de estado y a scripts de terceros, y un path de cliente
            # dice tanto como una frase de la conversacion. El panel si las ensena,
            # porque lo mira una persona en su propia pantalla.
            "clash_level": (r.get("colision") or {}).get("nivel") or 0,
            "clash_with": (r.get("colision") or {}).get("con") or None,
            "clash_files": len((r.get("colision") or {}).get("ficheros") or ()),
            "clash_command": (r.get("colision") or {}).get("orden_ancha") or None,
            # Enum cerrado: `loop` es el mismo comando fallando tres veces, `sweep` son
            # dos busquedas seguidas sin resultado. Van las claves y NUNCA el comando
            # que falla, que si sale en el panel: esto se canaliza a scripts de otros.
            "stuck": [_STUCK_JSON[a] for a in (pu.get("atasco") or ())],
        })
    return fuera


def print_json(rows):
    print(json.dumps({"sereno": VERSION, "schema": ESQUEMA_JSON,
                      "sessions": filas_json(rows)},
                     indent=2, ensure_ascii=False))


# ───────────────────────────── --find: buscar en el historial ─────────────────────────
# La criba binaria por fichero NO basta, y medirlo fue la sorpresa: buscando "complianz"
# sobre 506 transcripts, 287 contenian la palabra en crudo y solo 25 la tenian en algo
# dicho. El resto son `tool_result` —volcados de ficheros, salidas de comandos— y el
# CLAUDE.md del proyecto, que el CLI inyecta en CADA sesion. Buscar en el fichero entero
# devuelve media maquina; buscar en lo que se dijo devuelve lo que buscabas.
_TROZO = 70          # caracteres a cada lado del acierto


def _fragmento(texto, aguja):
    i = texto.lower().find(aguja.lower())
    if i < 0:
        return ""
    a, b = max(0, i - _TROZO), min(len(texto), i + len(aguja) + _TROZO)
    return (("\u2026" if a else "") + " ".join(texto[a:b].split())
            + ("\u2026" if b < len(texto) else ""))


def _dichos(j):
    """Lo que se dijo en una linea del transcript: prompts y respuestas, nada mas.

    Fuera quedan los `tool_result` (no los dijo nadie, son salida de comandos) y los
    `<system-reminder>`, que son contexto que el CLI pega solo y aparece en todas las
    sesiones: dejarlos dentro hacia que cualquier palabra del CLAUDE.md casara siempre.
    """
    if j.get("isSidechain"):
        return []
    m = j.get("message") or {}
    c = m.get("content")
    quien = j.get("type")
    if quien not in ("user", "assistant"):
        return []
    if isinstance(c, str):
        textos = [c]
    elif isinstance(c, list):
        textos = [b.get("text") or "" for b in c
                  if isinstance(b, dict) and b.get("type") == "text"]
    else:
        return []
    return [(quien, t) for t in textos if t and "<system-reminder>" not in t]


def buscar(aguja, limite=200, todo=False):
    """[(fila, [(quien, fragmento)])] por sesion, de la mas reciente a la mas vieja."""
    if DEMO or not PROJECTS.is_dir():
        return []
    a = aguja.lower().encode("utf-8", "replace")
    cands, tirados = [], 0
    for p in PROJECTS.glob("*/*.jsonl"):
        if not _UUID.match(p.stem):
            continue
        # Las de usar y tirar se saltan por defecto —son evaluadores y optimizadores, no
        # cosas que dijeras tu— pero `--all` las mira: ese flag significa "mira todo", y
        # que signifique otra cosa segun el dia es peor que no tenerlo.
        if not todo and de_usar_y_tirar(_proyecto_de_dir(p.parent.name)):
            tirados += 1
            continue
        try:
            cands.append((p.stat().st_mtime, p))
        except OSError:
            pass
    cands.sort(reverse=True)
    omitidos = 0
    if not todo:
        omitidos = max(0, len(cands) - limite)
        cands = cands[:limite]

    # Cuatro segundos de silencio con `--all` sobre 3,4 GB parecen un cuelgue. El aviso
    # va por stderr para no ensuciar la salida de quien la canalice, y solo cuando hay
    # bastante que leer: decirlo para tres ficheros es ruido.
    peso = sum(p.stat().st_size for _mt, p in cands if p.exists())
    if peso > 200 * 1024 * 1024:
        print(_("searching {n} transcripts ({g} GB)\u2026",
                n=len(cands), g=f"{peso / 1e9:.1f}"), file=sys.stderr)
    # Y las que se quedan fuera, SIEMPRE que las haya: por defecto se miran las 200 mas
    # recientes de las 599 que hay en esta maquina, y decir solo "200 transcripts" deja
    # creer que eso es todo. Un "no lo dijiste nunca" que en realidad es "no estaba en el
    # tercio que mire" es la peor respuesta que puede dar un buscador.
    if omitidos:
        print(_("(the {n} most recent; {f} older ones left out \u2014 add --all)",
                n=len(cands), f=omitidos), file=sys.stderr)
    # Lo mismo con las de usar y tirar: se saltan, y por eso se dicen. Un buscador que
    # calla lo que no mira contesta "no se dijo nunca" cuando la verdad es "no lo mire".
    if tirados:
        print(_("(one throwaway session from a temp dir not searched \u2014 add --all)")
              if tirados == 1 else
              _("({n} throwaway sessions from a temp dir not searched \u2014 add --all)",
                n=tirados), file=sys.stderr)

    salida = []
    for mt, p in cands:
        try:
            crudo = p.read_bytes()
        except OSError:
            continue
        if a not in crudo.lower():
            continue          # criba barata: descarta el 80% sin parsear un solo JSON
        aciertos = []
        for linea in crudo.split(b"\n"):
            if a not in linea.lower():
                continue
            try:
                j = json.loads(linea)
            except Exception:
                continue
            for quien, texto in _dichos(j):
                frag = _fragmento(texto, aguja)
                if frag:
                    aciertos.append((quien, frag))
        if aciertos:
            salida.append((fila_de_transcript(p, mt), aciertos))
    return salida


def print_hallazgos(res, aguja, por_sesion=3):
    total = sum(len(a) for _f, a in res)
    print("\n\033[1m" + _("{n} hit(s) in {s} session(s) for \u201c{q}\u201d",
                           n=total, s=len(res), q=aguja) + "\033[0m")
    for fila, aciertos in res:
        donde = fila.get("proyecto") or ""
        print(f"\n  \033[1m{fila['title_full']}\033[0m"
              + (f"  \033[2m{donde}\033[0m" if donde else "")
              + f"  \033[2m{_hace(fila['idle'])}\033[0m")
        print(f"  \033[2m{fila['name']}\033[0m")
        for quien, frag in aciertos[:por_sesion]:
            etiq = _("you") if quien == "user" else _("it")
            print(f"    \033[2m{etiq:>4}\033[0m  {frag}")
        if len(aciertos) > por_sesion:
            print("    " + _("+{n} more here", n=len(aciertos) - por_sesion))


# ─────────────────────────── --watch: el aviso al terminar ───────────────────────────
# El caso es este: lanzas algo largo, te vas a otra ventana y la sesion termina sin que
# nadie se entere. Lo que avisa NO es "esta parada" —lo estan casi todas casi siempre—
# sino el FLANCO: la que hasta hace veinte segundos escribia o corria un comando y ahora
# te espera. Por eso la primera vuelta no avisa de nada: solo fija la linea base.
TRABAJANDO = ("writing", "in_command")


def transiciones(antes, ahora):
    """Filas que acaban de pasar de trabajar a esperarte. Funcion pura, a proposito:
    el bucle es imposible de testear y esto es lo unico que puede equivocarse."""
    salen = []
    for r in ahora:
        previo = antes.get(r["id"])
        if previo in TRABAJANDO and r["state"] not in TRABAJANDO + ("unknown",):
            salen.append(r)
    return salen


def pares_choque(filas):
    """{par: nivel} de una foto. La clave es el PAR ordenado, no la sesion: un choque es
    una relacion entre dos, y contarlo por sesion lo cuenta dos veces."""
    fuera = {}
    for r in filas:
        if r.get("clash_with"):
            par = tuple(sorted((r["id"], r["clash_with"])))
            fuera[par] = max(fuera.get(par, 0), r["clash_level"])
    return fuera


def choques_nuevos(antes, ahora):
    """Pares que ACABAN de empezar a chocar, o que han empeorado. Pura, como
    `transiciones` y por lo mismo: el bucle no se puede testear y esto si.

    Se compara nivel a nivel, no presencia: subir de "misma carpeta" a "mismo fichero" es
    noticia; seguir en el mismo nivel diez minutos, no. Y el par se marca en cuanto lo
    saca la primera de las dos filas, para no avisar dos veces del mismo choque.
    """
    salen, vistos = [], dict(antes)
    for r in ahora:
        if not r.get("clash_with") or r.get("clash_level", 0) < COLISION_MINIMA:
            continue
        par = tuple(sorted((r["id"], r["clash_with"])))
        if r["clash_level"] > vistos.get(par, 0):
            vistos[par] = r["clash_level"]
            salen.append((par, r))
    return salen


# El cuarto flanco, y el unico que no mira lo que la sesion HACE sino lo que le queda:
# la ventana de contexto llenandose. Se avisa al CRUZAR un escalon, no mientras se esta
# por encima — igual que los otros tres, y por lo mismo: una sesion al 92% durante media
# hora avisaria noventa veces y se dejaria de leer. Y si compacta, el nivel baja solo y
# el siguiente cruce vuelve a ser noticia.
ESCALONES_CTX = (80, 90)


def escalones_ctx():
    """Los porcentajes a los que avisar. `SERENO_CTX_AVISO=70,85` los cambia; un valor
    sin ningun numero valido (`0`, `off`, `no`) apaga el aviso entero.

    Una vez por proceso: es config, no un dato que cambie entre vueltas del bucle.
    """
    if "_v" not in escalones_ctx.__dict__:
        crudo = _env("CTX_AVISO")
        if not crudo:
            escalones_ctx._v = ESCALONES_CTX
        else:
            vistos = sorted({int(x) for x in re.findall(r"\d+", crudo)
                             if 0 < int(x) <= 100})
            escalones_ctx._v = tuple(vistos)
    return escalones_ctx._v


def nivel_ctx(r, escalones=None):
    """El escalon que esta fila ya ha pasado, o 0. Un hecho, no un juicio: quien decide
    si eso merece un aviso es `contextos_nuevos`, comparandolo con la vuelta anterior.

    `context_max` a `None` es "no se midio" y NO cero: una sesion cuyo tope no consta no
    avisa, en vez de avisar del 100% de una ventana inventada.
    """
    esc = escalones_ctx() if escalones is None else escalones
    ctx, tope = r.get("context_tokens"), r.get("context_max")
    if not ctx or not tope or not esc:
        return 0
    lleno = 100.0 * ctx / tope
    pasados = [e for e in esc if lleno >= e]
    return max(pasados) if pasados else 0


def contextos_nuevos(antes, ahora, escalones=None):
    """Filas que ACABAN de cruzar un escalon de contexto, con el escalon cruzado. Pura,
    como las tres de arriba y por lo mismo: el bucle no se puede probar y esto si.

    Se compara escalon a escalon y no "iba justa / va justa": pasar del 80 al 90 es
    noticia nueva, seguir en el 80 no. Y como el nivel se recalcula cada vuelta, una
    sesion que compacta cae a 0 sola y puede volver a avisar mas tarde.
    """
    salen = []
    for r in ahora:
        n = nivel_ctx(r, escalones)
        if n and n > antes.get(r["id"], 0):
            salen.append((r, n))
    return salen


def notifica(titulo, cuerpo):
    """Aviso del escritorio si el sistema tiene con que; si no, la campana del terminal.

    Los dos programas son los nativos de cada sistema y no instalan nada: `osascript`
    viene en macOS y `notify-send` esta en cualquier escritorio Linux. Si no hay
    ninguno, el aviso no se pierde: sale por stdout igual, con un `\a`.
    """
    try:
        if sys.platform == "darwin":
            subprocess.run(["osascript", "-e",
                            f'display notification {json.dumps(cuerpo)} '
                            f'with title {json.dumps(titulo)}'],
                           check=False, capture_output=True, timeout=5)
        elif shutil.which("notify-send"):
            subprocess.run(["notify-send", titulo, cuerpo],
                           check=False, capture_output=True, timeout=5)
    except Exception:
        pass          # un aviso que falla no puede tumbar el vigilante


def atascos_nuevos(antes, ahora):
    """Sesiones que ACABAN de atascarse, con el aviso que es nuevo. Pura, como las dos
    de arriba y por lo mismo: el bucle no se puede probar y esto si.

    Se compara aviso a aviso y no "estaba atascada / lo esta": una sesion que lleva
    veinte minutos dando vueltas avisaria en cada vuelta del bucle, y a los tres avisos
    se deja de leer. Pero si ademas empieza a barrer, eso si es nuevo y se dice.
    """
    salen = []
    for r in ahora:
        previo = set(antes.get(r["id"]) or ())
        for a in (r.get("stuck") or ()):
            if a not in previo:
                salen.append((r, a))
    return salen


# La frase del aviso, por clave del enum publico. Vive aparte del `_TEXTO_ATASCO` de la
# lista porque aqui la sesion se nombra y alli no: "X esta dando vueltas" frente a
# "atascada en un bucle".
_AVISO_WATCH = {
    "loop": lambda t, d: _("{hora}  \u21bb {t} keeps running the same failing command{d}",
                           hora=time.strftime("%H:%M"), t=t, d=d),
    "sweep": lambda t, d: _("{hora}  \u21bb {t} is searching and finding nothing{d}",
                            hora=time.strftime("%H:%M"), t=t, d=d),
}


def watch(cada=20):
    print(_("Watching. Nothing is reported until a session stops working. Ctrl-C to quit."), flush=True)
    antes, pares, atascados, ctxs = {}, {}, {}, {}
    primera = True
    try:
        while True:
            filas = filas_json(live_sessions(fino=True, solo_activas=False))
            for r in (() if primera else transiciones(antes, filas)):
                que = r["title"] or r["id"]
                donde = r["project"] or ""
                sys.stdout.write("\a" + _("{hora}  {t} \u2014 waiting on you{d}",
                                          hora=time.strftime("%H:%M"), t=que,
                                          d=f"  ({donde})" if donde else "") + "\n")
                sys.stdout.flush()
                notifica(_("waiting on you"), f"{que}" + (f" \u00b7 {donde}" if donde else ""))
            # El segundo flanco que existe: no que una sesion pare, sino que dos empiecen
            # a escribir en el mismo sitio. Se avisa cuando NACE, igual que el otro: si se
            # avisara del estado, un choque que dura media hora avisaria noventa veces.
            titulos = {r["id"]: (r["title"] or r["id"]) for r in filas}
            for par, r in (() if primera else choques_nuevos(pares, filas)):
                a, b = (titulos.get(x, x) for x in par)
                sys.stdout.write("\a" + _(
                    "{hora}  \u29c9 {a} and {b} are writing in the same place",
                    hora=time.strftime("%H:%M"), a=a, b=b) + "\n")
                sys.stdout.flush()
                notifica(_("two sessions in the same place"), f"{a} \u00b7 {b}")
            # Y el tercero: que una sesion empiece a dar vueltas. Es el unico de los
            # tres que avisa de algo que la sesion se esta haciendo a si misma, y el
            # unico que puedes atender sin prisa — por eso va el ultimo de los tres.
            for r, a in (() if primera else atascos_nuevos(atascados, filas)):
                que = r["title"] or r["id"]
                donde = f"  ({r['project']})" if r["project"] else ""
                sys.stdout.write("\a" + _AVISO_WATCH[a](que, donde) + "\n")
                sys.stdout.flush()
                notifica(_("going in circles"), que + (f" \u00b7 {r['project']}"
                                                      if r["project"] else ""))
            # Y el cuarto: el contexto que se acaba. Va el ultimo porque es el unico
            # que no habla de lo que la sesion hace, sino de lo que le queda para
            # seguir haciendolo — y el unico que se atiende compactando, no mirando.
            for r, pct in (() if primera else contextos_nuevos(ctxs, filas)):
                que = r["title"] or r["id"]
                donde = f"  ({r['project']})" if r["project"] else ""
                sys.stdout.write("\a" + _(
                    "{hora}  \u25b0 {t} is at {p}% of its context{d}",
                    hora=time.strftime("%H:%M"), t=que, p=pct, d=donde) + "\n")
                sys.stdout.flush()
                notifica(_("context running out"),
                         _("{t} \u00b7 {p}% used", t=que, p=pct))
            antes = {r["id"]: r["state"] for r in filas}
            pares = pares_choque(filas)
            atascados = {r["id"]: r.get("stuck") or [] for r in filas}
            ctxs = {r["id"]: nivel_ctx(r) for r in filas}
            primera = False
            time.sleep(cada)
    except KeyboardInterrupt:
        print()
        return 0


def fila_de_huerfana(e):
    """Una entrada del registro con forma de fila. Vive fuera de `main()` porque la
    quieren dos sitios: el selector de recuperacion y `--json`."""
    titulo = ai_title(e) or label(e, 200)
    return {"name": e.get("id", ""), "created": int(e.get("started_epoch") or 0),
            "attached": False, "meta": e, "pid": "", "mem_mb": None,
            "title": label(e), "title_full": titulo,
            "idle": idle_secs(e), "working": False,
            "pulso": {"escribe": False, "herramienta": False}}


ICONO = {"in_command": "\u25d0", "writing": "\u25cf", "waiting": "\u25cb",
         "stopped": "\u25cb", "unknown": "?"}


def print_live(rows):
    """La lista plana, para leer sin entrar. Mismos estados que el selector.

    Antes decia solo "ejecutando" o "en espera": colapsaba los cuatro estados en dos
    y se perdia justo el que importa, el de una sesion metida en un comando de tres
    minutos, que es indistinguible de una parada si solo miras la fecha del fichero.
    Un modo que resume de menos que la interfaz que resume no sirve para decidir.
    """
    now = time.time()
    for i, r in enumerate(rows, 1):
        est = estado_estable(r)
        att = " " + _("[in a tab]") if r["attached"] else ""
        # Sin `created` no se pinta el campo, igual que hace el panel. Antes salia
        # "abierta hace ?", que afirma el dato y lo rellena con un interrogante — y le
        # pasa a toda sesion que no arranco por el alias, que son las que el selector
        # lee de `~/.claude/projects`. Un dato que falta se calla, no se dibuja.
        edad = ("  " + _("open for {t}", t=_dur(now - r["created"]))) if r["created"] else ""
        pu = r.get("pulso") or {}
        ctx = pu.get("ctx")
        # El tope se saca ANTES del f-string: partir una expresion en dos lineas dentro
        # de uno es legal desde 3.12 y un SyntaxError en 3.8, que es el suelo del repo.
        tope_ctx = tope_contexto(pu.get("modelo"), ctx, pu.get("ventana_1m"),
                                 pico_de(r)) if ctx else 0
        pct = f"  {round(100 * ctx / tope_ctx):>3}%" if ctx else "      "
        # `--list` es lo que sale en un pipe y en una terminal sin tty: si el aviso
        # solo viviera en el selector, quien lea la lista se lo pierde justo cuando importa.
        choque = ("  \u29c9 " + _("clashes with another session")) if r.get("colision") else ""
        # A diferencia del selector, aqui no hay una sola columna que repartir: caben
        # los dos avisos y no hay razon para elegir.
        atasco = "".join("  \u21bb " + _TEXTO_ATASCO[a]()
                         for a in (pu.get("atasco") or ()))
        # `.rstrip()` porque las columnas van rellenadas a ancho fijo: sin el, una fila
        # sin hora de apertura ni avisos sale con una cola de espacios que en un pipe es
        # basura invisible.
        print((f"  {i:>2}. {ICONO.get(est, '?')} {r['title']:<34} "
               f"{ESTADO_LARGO(est):<16} {_hace(r.get('idle')):<10}{pct}"
               + edad + att + choque + atasco).rstrip())
        print(f"         {r['name']}")
        if USO:
            u = uso_de(r)
            if u:
                ritmo = _uso_ritmo(u)
                extra = _uso_texto(u) + (("  \u00b7 " + ritmo) if ritmo else "")
                if u["compacta"]:
                    extra += "  \u00b7 " + _("{n} compaction(s)", n=u["compacta"])
                print("         " + extra)


def ESTADO_LARGO(est):
    return {"writing": _("writing"),
            "in_command": _("in a command"),
            "waiting": _("waiting on you"),
            "stopped": _("stopped"),
            }.get(est, _("no data"))


def parse_sel(text, rows):
    """Traduce lo tecleado a indices. Devuelve None si no se entiende (!= lista vacia).

    Acepta numeros y rangos ("1,3-5"), y tres atajos por estado, porque el caso
    real es "quiero cerrar las viejas y quedarme con las que estoy usando":
      todas | espera (las que no estan trabajando) | sueltas (las que no tienen pestana)

    Los atajos valen en los DOS idiomas, y no segun `SERENO_LANG`: quien teclea `idle`
    en una interfaz en castellano no se ha equivocado, y quien teclea `paradas` en una
    en ingles tampoco. Aceptar las dos listas cuesta una linea y no hay colision.
    """
    t = (text or "").strip().lower()
    if t in ("todas", "todo", "all", "*"):
        return list(range(len(rows)))
    if t in ("espera", "esperando", "paradas", "idle", "waiting", "stopped"):
        return [i for i, r in enumerate(rows) if r["working"] is False]
    if t in ("sueltas", "sin-pestana", "sinpestana", "detached", "loose", "no-tab"):
        return [i for i, r in enumerate(rows) if not r["attached"]]
    if not t:
        return None
    out = []
    for part in re.split(r"[,;\s]+", t):
        if not part:
            continue
        m = re.fullmatch(r"(\d+)-(\d+)", part)
        if m:
            a, b = int(m.group(1)), int(m.group(2))
            if a > b:
                a, b = b, a
            # Recortar ANTES de generar. El filtro de abajo ya descarta lo que sobra,
            # pero llega tarde: `1-50000000` sobre tres filas daba el resultado bueno
            # tras 2,8 s y 2,3 GB de RAM, que en un equipo de 8 GB es la interfaz
            # colgada por un dedo torpe. Recortado, el resultado es identico.
            a, b = max(a, 1), min(b, len(rows))
            out += list(range(a - 1, b))
        elif part.isdigit():
            out.append(int(part) - 1)
        else:
            return None                # una palabra que no es atajo: no adivinar
    out = sorted({i for i in out if 0 <= i < len(rows)})
    return out or None


def stop_rows(rows, forget):
    """Para las sesiones tmux dadas.

    forget=True archiva ademas su entrada del registro: sin eso la entrada
    sobrevive al kill (el wrapper hizo exec y no tiene trap que la borre) y la
    sesion vuelve a ofrecerse como huerfana en el siguiente arranque. Ese es el
    "vuelve a preguntarme lo mismo". El transcript NO se toca: siempre se puede
    reanudar a mano con `claude --resume <id>`.
    """
    dest = ROOT / "closed" / time.strftime("%Y%m%d-%H%M%S") if forget else None
    cerrados = []
    for r in rows:
        tmux_kill(r["name"])
        cerrados += _claves_de(r)
        f = (r.get("meta") or {}).get("_file")
        if forget and f:
            dest.mkdir(parents=True, exist_ok=True)
            try:
                shutil.move(str(f), str(dest / f.name))
            except OSError:
                pass
    apunta_cerradas(cerrados)
    return len(rows)


# Lo que se acaba de cerrar, para que no vuelva por la puerta del disco.
#
# Cerrar saca la sesion de tmux, y `live_sessions` excluye del barrido de
# `~/.claude/projects` justo lo que tmux le esta ensenando. Asi que al matarla salia de
# esa lista de excluidos y **volvia a entrar desde el disco**: su transcript se habia
# tocado hace segundos, o sea `idle` casi cero, o sea pintada como VIVA. Cerrabas cinco
# y a los pocos segundos reaparecian como activas, ademas con el uuid por nombre en vez
# del suyo, con lo que ni parecian las mismas filas.
#
# Se apunta en disco y no en memoria porque el susto se repite al reabrir el selector,
# que es otro proceso. Se limpia solo: pasados `VIVA` segundos el filtro por mtime ya la
# tira, asi que un apunte viejo no cambia nada y el fichero se reescribe entero.
CERRADAS = ROOT / "closed-recientes.txt"


# Lo ultimo que se eligio en los cuadros. Un fichero y no una variable de entorno: la
# gracia es no tener que decirlo cada vez, y una variable hay que ponerla igual.
PREFS = ROOT / "preferencias.json"


def pref(clave, defecto=None):
    try:
        return json.loads(PREFS.read_text()).get(clave, defecto)
    except (OSError, ValueError):
        return defecto


def guarda_pref(**kv):
    """Guarda sin pisar lo demas. Que falle no puede romper nada: es una comodidad."""
    try:
        datos = json.loads(PREFS.read_text())
    except (OSError, ValueError):
        datos = {}
    datos.update({k: v for k, v in kv.items() if v is not None})
    try:
        PREFS.parent.mkdir(parents=True, exist_ok=True)
        PREFS.write_text(json.dumps(datos))
    except OSError:
        pass


def _claves_de(r):
    """Con que se reconoce una fila en el barrido del disco: su id y el stem de su
    transcript. Los dos, porque una sesion reanudada no se llama como su id."""
    m = r.get("meta") or {}
    t = m.get("_transcript")
    return [m.get("id"), t.stem if t is not None else None]


def apunta_cerradas(claves):
    """Deja constancia de lo cerrado ahora, y de paso tira lo que ya no importa."""
    claves = [c for c in claves if c]
    if not claves:
        return
    ahora = time.time()
    lineas = ["%.0f %s" % (ahora, c) for c in claves]
    lineas += ["%.0f %s" % (t, c) for t, c in _cerradas_crudas() if ahora - t <= VIVA]
    try:
        CERRADAS.parent.mkdir(parents=True, exist_ok=True)
        CERRADAS.write_text("\n".join(lineas[:200]) + "\n")
    except OSError:
        pass


def _cerradas_crudas():
    try:
        for linea in CERRADAS.read_text().splitlines():
            t, _sep, c = linea.partition(" ")
            if c:
                yield float(t), c
    except (OSError, ValueError):
        return


def cerradas_recientes():
    """Ids y stems cerrados hace menos de `VIVA` segundos."""
    ahora = time.time()
    return {c for t, c in _cerradas_crudas() if ahora - t <= VIVA}


ABRIR_CONFIG = "claude-abrir"
RELEVO_CONFIG = "claude-relevo"


def _comando_de(r):
    """(comando, cwd) con que se abre esta fila. None si no se sabe abrirla."""
    e = r.get("meta") or {}
    if r.get("abrir"):                     # historial de otro CLI (codex, gemini...)
        return " ".join(shlex.quote(x) for x in r["abrir"]), e.get("cwd") or str(HOME)
    if str(r.get("name", "")).startswith("cc-"):
        return (f"{shlex.quote(TMUX_BIN)} -L {SOCK} attach -t {shlex.quote(r['name'])}",
                e.get("cwd") or str(HOME))
    if e.get("id"):                        # sesion de Claude muerta: --resume
        flags = " ".join(shlex.quote(f) for f in (e.get("resume_flags__list") or []))
        return (f"claude --resume {shlex.quote(e['id'])} {flags}".strip(),
                e.get("cwd") or str(HOME))
    return None


# Donde se dejan los guiones de un lanzamiento. Fuera de /tmp a proposito: un briefing
# con conversacion pasa por aqui, y /tmp lo lee cualquier usuario de la maquina.
RUN = HOME / ".sereno/lanzar"


def _guion(cmd, cwd):
    """Escribe el guion de UNA pestana y devuelve su ruta.

    Existe porque `do script` de Terminal.app y `tmux new-window` reciben la orden como
    UNA cadena, y el briefing de un relevo lleva saltos de linea y comillas: meterlo
    inline es el mismo fallo que rompia el YAML de Warp, con otro traje. Con un guion en
    disco no hay nada que escapar.

    Hace tres cosas y las tres importan:

      · `cd` al directorio de la sesion, y **aborta** si no esta — no sigue en `~`;
      · `unset TMUX`, porque el reenganche es `tmux attach` y dentro de tmux falla con
        "sessions should be nested with care" (medido, no supuesto);
      · se borra a si mismo antes del `exec`. Un fichero borrado sigue siendo legible por
        el descriptor que `sh` ya tiene abierto, asi que el resto se ejecuta igual
        (verificado) y el briefing no se queda en el disco.
    """
    RUN.mkdir(parents=True, exist_ok=True)
    os.chmod(RUN, 0o700)
    ruta = RUN / ("lanza-%s.sh" % uuid.uuid4().hex[:12])
    ruta.write_text("#!/bin/sh\n"
                    "cd %s || exit 1\n"
                    "unset TMUX\n"
                    "rm -f -- %s\n"
                    "exec %s\n" % (shlex.quote(cwd), shlex.quote(str(ruta)), cmd))
    os.chmod(ruta, 0o700)
    return ruta


def _abre_en_tmux(pestanas):
    """Una ventana de tmux por pestana, en la sesion en la que ya estas.

    Es la unica via de "varias a la vez" que no depende de macOS. Pide estar DENTRO de
    tmux: fuera habria que elegir a que sesion se le cuelgan las ventanas, y eso es
    adivinar por el usuario.
    """
    hechas = 0
    for titulo, cmd, cwd in pestanas:
        try:
            r = subprocess.run([TMUX_BIN, "new-window", "-c", cwd,
                                "-n", str(titulo)[:40],
                                "sh %s" % shlex.quote(str(_guion(cmd, cwd)))],
                               capture_output=True)
        except OSError:
            continue
        hechas += r.returncode == 0
    return hechas


def _abre_en_terminal(pestanas):
    """Una ventana de Terminal.app por pestana, via AppleScript.

    Aviso que no es un detalle: macOS **restaura** las ventanas de Terminal al reiniciar,
    asi que un dia de relevos deja ventanas resucitando al arrancar. Por eso va detras de
    Warp y de tmux, no delante.
    """
    hechas = 0
    for _titulo, cmd, cwd in pestanas:
        orden = "sh %s" % shlex.quote(str(_guion(cmd, cwd)))
        try:
            r = subprocess.run(
                ["osascript", "-e",
                 'tell application "Terminal" to do script %s' % json.dumps(orden)],
                capture_output=True)
        except OSError:
            continue
        hechas += r.returncode == 0
    return hechas


def hay_tmux_alrededor():
    """Sereno corre DENTRO de tmux: `$TMUX` lo pone el propio servidor."""
    return bool(os.environ.get("TMUX")) and bool(shutil.which(TMUX_BIN))


def hay_terminal_app():
    return sys.platform == "darwin" and pathlib.Path(
        "/System/Applications/Utilities/Terminal.app").is_dir()


# Como se abren VARIAS sesiones a la vez, en orden de preferencia. La clave es el nombre
# que se ensena; el valor es (esta disponible, abrelas y di cuantas salieron).
#
# Warp primero porque abre ventanas de verdad sin efectos raros. tmux despues porque es
# el unico que funciona fuera de macOS. Terminal.app el ultimo, por lo de la restauracion.
#
# Anadir iTerm2, kitty o gnome-terminal es una linea AQUI, pero ninguno esta instalado en
# esta maquina y no se ponen a ojo: la forma exacta de pedirles una ventana con una orden
# dentro se comprueba antes, como se hizo con estos tres.
LANZADORES = {
    "warp": (lambda: hay_warp(), None),          # el suyo va por YAML, no por guion
    "tmux": (hay_tmux_alrededor, _abre_en_tmux),
    "terminal": (hay_terminal_app, _abre_en_terminal),
}


_QUE_ABRE = {
    "warp": lambda: _("a real window each"),
    "tmux": lambda: _("a tmux window each, where you already are"),
    "terminal": lambda: _("a Terminal.app window each"),
}


def lanzadores_disponibles():
    """Los de `LANZADORES` que existen aqui, en orden. `SERENO_LANZADOR` deja uno."""
    forzado = _env("LANZADOR")
    nombres = [forzado] if forzado in LANZADORES else list(LANZADORES)
    return [n for n in nombres if LANZADORES[n][0]()]


def lanzador_disponible():
    """El primero disponible, para cuando no hay nadie a quien preguntar."""
    hay = lanzadores_disponibles()
    return hay[0] if hay else None


def abre_varias(pestanas, config, cual=None):
    """(lanzador, cuantas) para abrir estas pestanas. (None, 0) si no hay por donde.

    Devuelve HECHOS y no un "ha ido bien": quien llama compone el mensaje a partir de
    cuantas salieron de verdad, que es lo que antes nadie miraba.
    """
    cual = cual or lanzador_disponible()
    if cual is None or cual not in LANZADORES:
        return None, 0
    if cual == "warp":
        return ("warp", len(pestanas)) if _abre_en_warp(config) else (None, 0)
    return cual, LANZADORES[cual][1](pestanas)


def _abre_en_warp(nombre):
    """Lanza una launch configuration. Devuelve si se pudo, no si se ve bonita.

    Un solo sitio llama a `open`, y devuelve un HECHO en vez de dar por buena la
    llamada. Habia tres copias de esta linea y ninguna miraba nada: en una maquina sin
    `open` —cualquier Linux— `subprocess.run` lanza `FileNotFoundError` y tumbaba el
    programa entero desde dentro de curses, y en un macOS sin Warp el `open` fallaba en
    silencio mientras la pantalla anunciaba las pestanas reabiertas.
    """
    if not hay_warp():
        return False
    try:
        return subprocess.run(["open", f"warp://launch/{nombre}"],
                              check=False).returncode == 0
    except OSError:
        return False


def _dir_util(cwd):
    """True si ahi se puede plantar una sesion: ruta ABSOLUTA que existe.

    No basta con `Path(cwd).is_dir()`. `Path("").is_dir()` devuelve **True** —Python lee
    la ruta vacia como `.`— asi que una comprobacion de existencia a secas deja pasar el
    vacio y planta la sesion donde este el proceso, que es el sitio equivocado con pinta
    de haber funcionado. La relativa cae por lo mismo: existe respecto al proceso, no
    respecto a la sesion.
    """
    return bool(cwd) and pathlib.Path(cwd).is_absolute() and pathlib.Path(cwd).is_dir()


def hay_warp():
    """Warp es la unica via que tenemos para abrir en una ventana NUEVA (`warpctrl`
    no existe en esta version, verificado 2026-08-25). Sin el se reemplaza la terminal
    actual: peor, pero es lo que hay en Linux, en iTerm o en Terminal.app."""
    return sys.platform == "darwin" and any(
        (base / "Warp.app").is_dir()
        for base in (pathlib.Path("/Applications"), HOME / "Applications"))


def abrir_sesion(r, callado=False):
    """Abre la sesion en una VENTANA NUEVA de Warp y deja esta terminal en paz.

    Antes hacia `exec` sobre el propio proceso: la sesion se comia la pestana desde
    la que se estaba mirando la lista, y con ella el hilo de lo que estabas haciendo.
    Se lanza por launch configuration, que es la unica via de Warp para abrir algo en
    una ventana suya (`warpctrl` no existe en esta version, verificado 2026-08-25).
    """
    par = _comando_de(r)
    if not par:
        if callado:
            return ""
        print(_("Don't know how to open {s}.", s=r.get('name')))
        return 1
    cmd, cwd = par
    if not _dir_util(cwd):
        cwd = str(HOME)
    titulo = (r.get("title_full") or r.get("name") or "claude").replace('"', "'")[:60]
    if not hay_warp():
        # `exec` y no `subprocess`: la sesion tiene que heredar ESTE tty. Lanzarla como
        # hija dejaria dos programas leyendo del mismo teclado.
        os.chdir(cwd)
        print("\n" + _("Opening: {t}", t=titulo) + "\n")
        os.execvp("/bin/sh", ["/bin/sh", "-c", cmd])
    _escribe_config(ABRIR_CONFIG, [(titulo, cmd, cwd)])
    _abre_en_warp(ABRIR_CONFIG)
    if callado:                        # llamado desde el selector: no romper curses
        return titulo
    print("\n" + _("Opening in a new window: {t}", t=titulo))
    return 0


def _escribe_config(nombre, pestanas):
    """Escribe UNA launch configuration de Warp con una pestana por tupla.

    `pestanas` son (titulo, comando, cwd) ya compuestos. Vive aqui sola porque habia
    tres copias de este mismo YAML —la de abrir una, la de reabrir varias y la de las
    huerfanas— y en una de ellas el comando estaba fijo a `tmux attach`: marcabas cinco
    del historial, se abrian cinco pestanas y fallaban las cinco sin decir por que.
    Con un solo sitio que compone el YAML, el comando lo decide quien sabe (`_comando_de`).
    """
    LAUNCH.mkdir(parents=True, exist_ok=True)
    lineas = ["---", f"name: {nombre}", "windows:", "  - tabs:"]
    for titulo, cmd, cwd in pestanas:
        lineas += [
            '      - title: "%s"' % str(titulo).replace('"', "'")[:60],
            "        layout:",
            '          cwd: "%s"' % cwd,
            "          commands:",
        ]
        if "\n" in cmd:
            # Una orden de varias lineas —el briefing de un relevo lo es— rompe el YAML
            # si se escribe suelta detras de `exec:`: el fichero sale invalido y la
            # ventana no abre. Bloque literal `|-`, que conserva los saltos y la sangria
            # RELATIVA a la suya, que es lo que alinea la lista de llamadas.
            lineas.append("            - exec: |-")
            lineas += ["                " + l for l in cmd.split("\n")]
        else:
            lineas.append(f"            - exec: {cmd}")
    ruta = LAUNCH / f"{nombre}.yaml"
    ruta.write_text("\n".join(lineas) + "\n")
    return ruta


def pestanas_de(rows):
    """(pestanas, sin_forma) — las filas que se saben abrir, y las que no.

    El comando sale de `_comando_de()`, que ya distingue los tres casos: una sesion viva
    se abre con `tmux attach`, una del historial de Claude con `--resume`, y una de otro
    CLI con lo suyo (`codex resume ...`). Las que no se sepan abrir se DEVUELVEN aparte
    en vez de colarse con un comando cualquiera: una pestana que falla al abrirse no
    dice cual era ni por que.
    """
    pestanas, sin_forma = [], []
    for r in rows:
        par = _comando_de(r)
        if not par:
            sin_forma.append(r)
            continue
        cmd, cwd = par
        if not pathlib.Path(cwd or "").is_dir():
            cwd = str(HOME)
        pestanas.append((r.get("title_full") or r.get("title") or r.get("name") or "claude",
                         cmd, cwd))
    return pestanas, sin_forma


# Los CLI a los que se sabe entregar una sesion. La clave es el binario, tal cual se
# busca en el PATH; el valor compone la orden con el briefing dentro.
#
# `codex [OPTIONS] [PROMPT]` -- "Optional user prompt to start the session", verificado
# contra `codex --help` el 2026-08-28. Anadir otro es una linea AQUI, pero antes hay que
# comprobar en su `--help` como se le pasa un prompt inicial y que abra sesion
# INTERACTIVA: `gemini` no esta instalado en esta maquina, asi que no se pone a ojo.
ARNESES = {
    "codex": lambda prompt: "codex " + shlex.quote(prompt),
    # `claude [options] [command] [prompt]` -- "Your prompt", y sin `-p` la sesion es
    # interactiva. Verificado contra `claude --help` el 2026-08-28. Esta aqui para que
    # el relevo vaya en los dos sentidos: una sesion de Codex tambien se entrega.
    "claude": lambda prompt: "claude " + shlex.quote(prompt),
}

# El CLI del que sale una fila. `fuente` tiene cinco valores y dos son el mismo arnes:
# "historial" es Claude Code parado, no otro programa.
NOMBRE_CLI = {"claude": "Claude Code", "codex": "Codex", "gemini": "Gemini",
              "antigravity": "Antigravity"}


def cli_de(r):
    f = r.get("fuente", "claude")
    return "claude" if f in ("claude", "historial") else f


def arneses_disponibles():
    """Los de `ARNESES` que existen en el PATH. Un CLI que no esta no se ofrece."""
    forzado = _env("SERENO_ARNES")
    nombres = [forzado] if forzado in ARNESES else list(ARNESES)
    return [n for n in nombres if shutil.which(n)]


def briefing(r, con_conversacion=False):
    """El texto con el que arranca el relevo. Hechos, no un resumen inventado.

    No es una traduccion de la sesion y no puede serlo: el contexto de Claude vive en su
    transcript, con sus ids de herramienta, y no hay forma de meterlo en otro CLI. Esto
    es un RELEVO: una sesion nueva plantada en el mismo sitio con lo que se sabe.

    Por defecto NO lleva conversacion. El briefing acaba dentro del YAML de Warp, que se
    queda en el disco: meter ahi el prompt y la respuesta es sacar trabajo de un cliente
    a un fichero, y eso se hace a peticion (`SERENO_RELEVO=completo`), no por defecto.
    """
    d = detalles(r)
    cwd = d.get("cwd") or (r.get("meta") or {}).get("cwd") or ""
    origen = NOMBRE_CLI.get(cli_de(r), cli_de(r))
    lineas = [_("You are taking over from a {c} session. You do not have its history: "
                "what follows is everything that is known about it.", c=origen), ""]
    campos = [(_("project"), cwd), (_("branch"), d.get("gitBranch") or ""),
              (_("title"), r.get("title_full") or r.get("title") or ""),
              (_("state"), ESTADO_LARGO(estado_estable(r)))]
    lineas += ["  %s: %s" % (k, v) for k, v in campos if v]
    ruta = (d.get("ruta") or [])[-6:]
    if ruta:
        lineas += ["", "  " + _("its last tool calls:")]
        for e in ruta:
            glifo, _par, dur, res = linea_ruta(e, 100)
            lineas.append("    %s %s  %s" % (glifo, dur, res))
    if con_conversacion:
        for etiq, txt in ((_("last thing asked of it"), d.get("lastPrompt")),
                          (_("last thing it said"), d.get("resp"))):
            if txt:
                lineas += ["", "  " + etiq + ":", "    " + _clean(txt)[:1200]]
    lineas += ["", _("Get your bearings in that directory before touching anything.")]
    return "\n".join(lineas)


def pestanas_de_relevo(rows, arnes, con_conversacion=False):
    """(pestanas, sin_sitio, mismo_cli) para entregar estas filas a otro CLI.

    Se cae la fila cuyo directorio ya no existe: un relevo que arranca en `~` porque el
    proyecto se movio es peor que no arrancar, porque parece que ha funcionado. Y se cae
    la que YA es de ese CLI: relevar Codex a Codex abre una sesion en blanco y la cuenta
    como entregada.
    """
    compone = ARNESES[arnes]
    pestanas, sin_sitio_, mismo_ = [], [], []
    for r in rows:
        if cli_de(r) == arnes:
            mismo_.append(r)
            continue
        cwd = detalles(r).get("cwd") or (r.get("meta") or {}).get("cwd") or ""
        if not _dir_util(cwd):
            sin_sitio_.append(r)
            continue
        titulo = "%s \u2192 %s" % (r.get("title") or r.get("name") or "", arnes)
        pestanas.append((titulo, compone(briefing(r, con_conversacion)), cwd))
    return pestanas, sin_sitio_, mismo_


def _pide_lanzador(sel, lanzadores, h, w, curses, C, tecla_limpia):
    """Dibuja el cuadro de "donde" y devuelve el elegido, o None si se cancela.

    Recibe curses y sus dos ayudantes en vez de importarlos: `pick_ui` los tiene ya
    montados —el modulo falso de los tests entra por ahi— y duplicar ese montaje aqui
    seria tener dos pantallas que pueden discrepar.
    """
    lin = lineas_abrir(sel, lanzadores, min(70, w - 8))
    alto = min(len(lin) + 2, h)
    ancho_c = min(max(ancho(t) for t, _p in lin) + 6, w)
    win = curses.newwin(alto, ancho_c, max(0, (h - alto) // 2),
                        max(0, (w - ancho_c) // 2))
    win.box()
    for k, (txt, par) in enumerate(lin[:alto - 2]):
        if txt:
            win.addnstr(1 + k, 3, txt, ancho_c - 6,
                        (C(par) if par else 0) | curses.A_BOLD)
    win.refresh()
    win.timeout(-1)
    tec = tecla_limpia(win)
    if ord("1") <= (tec or 0) <= ord("9"):
        i = tec - ord("1")
        if i < len(lanzadores):
            return lanzadores[i]
    return None


def lineas_abrir(sel, lanzadores, ancho, tope=5):
    """[(texto, par_de_color)] del cuadro que pregunta DONDE se abren estas sesiones.

    Compositor puro y aparte del pintado, igual que `lineas_relevo`: curses no avisa
    cuando un cuadro no cabe, asi que la geometria se comprueba sobre estas lineas.
    """
    out = [(_("Open {n} session in:", n=len(sel)) if len(sel) == 1
            else _("Open {n} sessions in:", n=len(sel)), 6), ("", 0)]
    for r in sel[:tope]:
        out.append(("\u00b7 " + recorta(r.get("title_full") or r.get("name") or "",
                                        ancho - 6), 0))
    if len(sel) > tope:
        out.append(("  " + _("and {n} more", n=len(sel) - tope), 4))
    out.append(("", 0))
    for i, n in enumerate(lanzadores):
        out.append(("[%d] %s  \u2014  %s" % (i + 1, n, _QUE_ABRE.get(n, lambda: n)()), 7))
    out.append(("", 0))
    out.append((_("[1-9] open there    [any other key] cancel"), 7))
    return out


def ausentes_de_relevo(destinos):
    """[(cli, por que no se ofrece)] de los CLI conocidos que no estan en la lista.

    Dos motivos y no uno solo, porque no se arreglan igual: uno se instala y el otro
    exige comprobar en su `--help` como se le pasa un prompt inicial — que es la regla
    por la que `gemini` no esta en `ARNESES`, y no un olvido.
    """
    fuera = []
    for nombre in GLIFO_CLI:
        if nombre in destinos:
            continue
        if nombre not in ARNESES:
            fuera.append((nombre, _("not checked how to seed it")))
        elif not shutil.which(nombre):
            fuera.append((nombre, _("not installed")))
    return fuera


def destinos_de_relevo(sel):
    """Los CLI a los que tiene sentido entregar ESTAS filas.

    Un destino se ofrece si al menos una de las filas puede ir a el. El que es el origen
    de todas se cae: relevar Codex a Codex abre una sesion en blanco y la cuenta.
    """
    return [a for a in arneses_disponibles() if any(cli_de(r) != a for r in sel)]


def lineas_relevo(sel, destinos, con_conv, ancho, tope=5, donde=None, hay_donde=()):
    """[(texto, par_de_color)] del cuadro que pregunta a donde va el relevo.

    Compositor puro y aparte del pintado, por lo mismo que `lineas_now`: el cuadro tiene
    que caber en la pantalla y curses **no avisa cuando no cabe** —un `addnstr` fuera del
    borde devuelve bien y el texto se pierde—, asi que la geometria se comprueba sobre
    estas lineas, sin terminal de por medio.
    """
    out = [(_("Hand over {n} session to:", n=len(sel)) if len(sel) == 1
            else _("Hand over {n} sessions to:", n=len(sel)), 6), ("", 0)]
    for r in sel[:tope]:
        out.append(("\u00b7 " + recorta(r.get("title_full") or r.get("name") or "",
                                        ancho - 6), 0))
    if len(sel) > tope:
        out.append(("  " + _("and {n} more", n=len(sel) - tope), 4))
    out.append(("", 0))
    out.append(("   ".join("[%d] %s" % (i + 1, a) for i, a in enumerate(destinos)), 7))
    # Los que no se pueden ofrecer, dichos y no escondidos: sin esto, quien tenga solo
    # Codex instalado no llega a saber que esto va con mas CLIs. Cada uno con SU motivo,
    # que no es el mismo — uno se arregla instalandolo y el otro no.
    porque = {}
    for nombre, motivo in ausentes_de_relevo(destinos):
        porque.setdefault(motivo, []).append(nombre)
    for motivo, nombres in porque.items():
        out.append(("    %s \u2014 %s" % (", ".join(nombres), motivo), 4))
    # El toggle esta AQUI y no solo en una variable de entorno: `SERENO_RELEVO=completo`
    # existe desde que existe el relevo y no lo descubre nadie que no lea el README.
    out.append(("[k] " + _("include the conversation: {v}",
                           v=_("yes") if con_conv else _("no")), 7 if con_conv else 4))
    if con_conv:
        out.append(("    " + _("it is written to Warp's config, on disk"), 2))
    # Donde se abren las ventanas: la misma pregunta que hace `r`, y por las mismas
    # razones. Solo cuando hay entre que elegir; con un sitio, decirlo seria ruido.
    if len(hay_donde) > 1:
        out.append(("[w] " + _("open them in: {v}", v=donde or ""), 7))
    out.append(("", 0))
    out.append((_("[1-9] hand over    [any other key] cancel"), 7))
    return out


def relevo(sel, arnes=None, con_conversacion=None, lanzador=None):
    """Abre una sesion NUEVA del otro CLI por cada fila, en su directorio.

    Sin arnes pedido, el destino por defecto es cualquiera MENOS el de las filas: es lo
    que hace que una sesion de Codex se entregue a Claude sin elegir nada, y lo que
    evita ofrecer como relevo el mismo programa del que se sale.
    """
    disponibles = arneses_disponibles()
    if not arnes:
        origen = {cli_de(r) for r in sel}
        otros = [a for a in disponibles if a not in origen]
        arnes = (otros or disponibles or [None])[0]
    if not arnes:
        return None, _("No other CLI found on your PATH.")
    if con_conversacion is None:
        con_conversacion = _env("SERENO_RELEVO") == "completo"
    pestanas, sin_sitio_, mismo_ = pestanas_de_relevo(
        sel, arnes, con_conversacion=con_conversacion)
    if not pestanas:
        if mismo_ and not sin_sitio_:
            return None, _("Those are already {c} sessions.", c=arnes)
        return None, _("None of those has a directory to go back to.")
    _escribe_config(RELEVO_CONFIG, pestanas)
    _cual, hechas = abre_varias(pestanas, RELEVO_CONFIG, lanzador)
    if not hechas:
        return None, _("Nothing here can open several at once: "
                       "no Warp, no tmux around, no Terminal.app.")
    aviso = _("{n} handed over to {c}", n=hechas, c=arnes)
    if sin_sitio_:
        aviso += " \u00b7 " + _("{n} have nowhere to go back to", n=len(sin_sitio_))
    if mismo_:
        aviso += " \u00b7 " + _("{n} are already {c}", n=len(mismo_), c=arnes)
    return arnes, aviso


def reanuda(pestanas, config, archivar):
    """Abre estas pestanas y archiva `archivar` SOLO si alguna se abrio. (cual, cuantas).

    Vive aqui fuera porque la usan las DOS rutas que reanudan huerfanas —el selector y la
    linea de comandos— y hasta ahora la decision estaba escrita dos veces. Dos copias de
    un `if` son dos sitios donde invertirlo, y ninguna de las dos se podia llamar desde un
    test sin montar la interfaz entera: la mitad que decide se acababa replicando en el
    cuerpo del caso, que es como no probar nada.

    Archivar es decir "esta ya esta resuelta", y a partir de ahi la lista no la vuelve a
    ofrecer. Sin abrir, archivar es perderla.
    """
    cual, hechas = abre_varias(pestanas, config)
    if hechas:
        archive(archivar, "restored")
    return cual, hechas


def reopen(sel):
    pestanas, sin_forma = pestanas_de(sel)
    if not pestanas:
        print(_("None of those can be opened from here."))
        return 1
    path = _escribe_config(CONFIG_NAME, pestanas)
    cual, hechas = abre_varias(pestanas, CONFIG_NAME)
    if not hechas:
        # El numero manda sobre la intencion: se anuncian las que salieron, no las que
        # se pidieron. Antes se imprimia "reenganchando 3" sin mirar si habia ocurrido.
        print("\n" + _("Nothing here can open several at once: "
                       "no Warp, no tmux around, no Terminal.app."))
        print(_("One at a time does work: ENTER on each one."))
        return 1
    print("\n" + _("Reattaching {n} tabs with {v} -> {p}",
                   n=hechas, v=cual, p=path))
    if hechas < len(pestanas):
        print(_("{n} did not open.", n=len(pestanas) - hechas))
    if sin_forma:
        print(_("{n} left out: no idea how to open them.", n=len(sin_forma)))
    return 0


