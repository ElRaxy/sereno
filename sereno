def clis_presentes(filas):
    """Los CLI que hay en estas filas, en el orden de las pestanas.

    Un solo sitio lo calcula porque hacen falta DOS: la barra que se pinta y el ciclo
    del Tab. Con una copia en cada uno, una miraba `fuente` y la otra `cli_de`, asi que
    el Tab paraba en una pestana que la barra no dibujaba y la lista salia vacia.
    """
    hay = {cli_de(r) for r in filas}
    return ([f for f in ORDEN_FUENTES if f in hay]
            + sorted(f for f in hay if f not in ORDEN_FUENTES))


